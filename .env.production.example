# ─────────────────────────────────────────────────────────────────────────────
# .env.production — шаблон. Скопировать в .env.production и заполнить.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# Этот файл НЕ должен попасть в git (см. .gitignore: **/.env.production).
# Реальный .env.production — только на VPS + зашифрованная копия в S3 через
# scripts/backup-env.sh (age-encryption, см. docs/SECRETS.md).
#
# Все секреты сгенерировать через `openssl rand -base64 32` или пасс-менеджер.
# ─────────────────────────────────────────────────────────────────────────────

# === 1. Домены (для nginx server_name + SSL Let's Encrypt) ===================
# Основной адрес продукта.
CRM_DOMAIN=yokoone.ru
# www — 301 redirect на CRM_DOMAIN. Один SAN cert на оба.
# Если не нужен — _disabled_www_.
CRM_WWW_DOMAIN=www.yokoone.ru
# Legacy / alias — временно проксирует на CRM (Этап 1 миграции).
# Этап 2 заменит на 301 → CRM_DOMAIN. Если не нужен — _disabled_app_.
CRM_APP_DOMAIN=app.yokoone.ru
# Админка опросов
BOT_ADMIN_DOMAIN=admin.yokoone.ru
# Email для уведомлений Let's Encrypt о просроченных сертификатах
LETSENCRYPT_EMAIL=admin@yokoone.ru

# === 2. PostgreSQL ==========================================================
# Используется compose-сервисом postgres + всеми приложениями через DATABASE_URL.
# POSTGRES_DB=tg_bot_db — то же имя что в локальной БД (источник миграции).
# Меняешь имя? Не забудь поменять и в восстанавливаемых dump-ах.
POSTGRES_USER=crm
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_base64_32__
POSTGRES_DB=tg_bot_db

# === 3. Redis ===============================================================
# Используется yandex-fleet-scraper (очередь задач) и gravity-mvp (кэш).
REDIS_PASSWORD=__GENERATE_WITH_openssl_rand_base64_32__

# === 4. Telegram бот водителей (tg-bot) =====================================
# Боевой бот, через который водители получают опросы и команды.
BOT_TOKEN=123456:AAA-replace-with-real-token-from-BotFather
# Внутренний пароль для админки tg-bot-frontend (basic auth)
ADMIN_USER=admin
ADMIN_PASS=__GENERATE_WITH_openssl_rand_base64_24__
# Список Telegram user_id админов через запятую — кому слать алерты
ADMIN_IDS=12345678,87654321
# Межсервисный shared secret: tg-bot ↔ gravity-mvp
BOT_CRM_SECRET=__GENERATE_WITH_openssl_rand_base64_32__

# === 5. Алертный бот @yoko_park_bot (health-monitor.sh) =====================
# Отдельный бот специально для алертов — не путать с BOT_TOKEN выше.
ALERT_BOT_TOKEN=123456:BBB-replace-with-alert-bot-token
ALERT_CHAT_ID=12345678

# === 6. AI / Anthropic Claude (через xray SOCKS5) ===========================
ANTHROPIC_API_KEY=sk-ant-replace-with-real-key
# Прокси-эндпоинт xray на хосте VPS (не Docker — host network)
HTTPS_PROXY=socks5://host.docker.internal:1080

# === 7. MAX (мессенджер web.max.ru) =========================================
# Номер телефона аккаунта-скрапера (без +, формат E.164)
MAX_SCRAPER_PHONE=79991234567
# Тот же номер в публичной переменной для UI gravity-mvp (build-time)
NEXT_PUBLIC_MAX_SCRAPER_PHONE=79991234567

# DEV-флаг: показывать ВСЕ табы каналов чатов (WA/TG/MAX/AV/Тел)
# независимо от подключенных аккаунтов в БД. Полезно для отладки UI на
# чистой VPS без подключенных мессенджеров. В production оставить пустым
# или 'false' — тогда табы появляются динамически по мере подключения.
NEXT_PUBLIC_FORCE_SHOW_ALL_CHANNELS=true

# === 8. Yandex Fleet скрапер ================================================
# Ключ шифрования Playwright storage state (32+ символа)
STORAGESTATE_ENC_KEY=__GENERATE_WITH_openssl_rand_base64_32__
# Пути к профилю Chrome внутри контейнера worker'а — НЕ менять
CHROME_PROFILE_DIR=/app/chrome_profile
CHROME_USER_DATA_DIR=/app/chrome_user_data

# === 9. Авито (отключено — парсер не запускается в проде) ===================
# Оставлено для совместимости со старым кодом. Можно пустые значения.
AVITO_UPSTREAM_AUTH_SECRET=
AVITO_WEBHOOK_TOKEN=
NEXT_PUBLIC_AVITO_LEADS_URL=

# === 10. Телефония (FreeSWITCH в Docker, на VPS) ============================
MEGAFON_SIP_USERNAME=replace-with-megafon-sip-login
MEGAFON_SIP_PASSWORD=__from_megafon_personal_cabinet__
# Event Socket Library пароль (FreeSWITCH ↔ audio-bridge / gravity-mvp)
ESL_PASSWORD=__GENERATE_WITH_openssl_rand_base64_32__
# Внутренний адрес ESL — для контейнеров compose
ESL_HOST=freeswitch
ESL_PORT=8021
# Linphone/SIP-extension пароли для менеджеров (101, 102, 103)
MANAGER_101_PASSWORD=__GENERATE_WITH_openssl_rand_base64_24__
MANAGER_102_PASSWORD=__GENERATE_WITH_openssl_rand_base64_24__
MANAGER_103_PASSWORD=__GENERATE_WITH_openssl_rand_base64_24__
# coturn shared secret (TURN relay для голоса в браузере, опционально)
COTURN_SHARED_SECRET=__GENERATE_WITH_openssl_rand_base64_32__
# Bridge shared token (audio-bridge ↔ телефония; обязателен для controlled real AI call)
BRIDGE_SHARED_TOKEN=__GENERATE_WITH_openssl_rand_base64_32__

# Controlled real AI call — оба kill switch по умолчанию закрыты.
# Не включать до прохождения GET /api/ai-calls/start и ручного approval.
AI_CALL_LIVE_MODE=false
AI_CALL_CONTROLLED_REAL_CALL_ENABLED=false
# Отдельный сильный proof token для GET/POST /api/ai-calls/start.
AI_CALL_CONTROLLED_OPERATOR_TOKEN=__GENERATE_WITH_openssl_rand_base64_48__
# Один owner-approved id; ротация значения — отдельное разрешение на следующий звонок.
AI_CALL_CONTROLLED_REQUEST_ID=
AI_CALL_TELEPHONY_PROVIDER=freeswitch
AI_CALL_CONTROLLED_DESTINATION_E164=
MEGAFON_NUMBER=
AI_CALL_DIAL_STRING_TEMPLATE='sofia/gateway/megafon/${number}'
AI_CALL_PARK_EXT=9999
# OWNER INPUT REQUIRED: выбрать openai или yandex для каждого канала.
AI_CALL_STT_PROVIDER=
AI_CALL_TTS_PROVIDER=
# Внутренний health URL задаётся compose; FreeSWITCH достигает bridge через
# loopback-published 127.0.0.1:3030 и BRIDGE_LAN_IP=127.0.0.1.
AUDIO_BRIDGE_HEALTH_URL=http://audio-bridge:3030/health
RECORDINGS_HOST_PATH=/app/freeswitch-recordings

# === 10.1 MinIO (S3-совместимое хранилище записей звонков) ==================
# Локальный объектный сторадж рядом с FreeSWITCH. Бэкапы (backup-files.sh)
# регулярно копируют bucket в Selectel S3 для offsite-страховки.
MINIO_ROOT_USER=crmadmin
MINIO_ROOT_PASSWORD=__GENERATE_WITH_openssl_rand_base64_32__
MINIO_RECORDINGS_BUCKET=recordings
# Эндпоинт для gravity-mvp (внутри Docker-сети)
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# === 11. Google Sheets (опросы водителей) ==================================
# JSON ключа сервисного аккаунта целиком, в одну строку, экранированный.
# Удобнее хранить файл и монтировать как volume — см. docs/SECRETS.md 4.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
GOOGLE_SHEETS_NAME=DriverSurveys

# === 12. Selectel S3 (бэкапы) ==============================================
# Учётка с правами write+read, БЕЗ delete (удаление через lifecycle policy).
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=crm-backups
S3_ACCESS_KEY=replace-with-selectel-access-key
S3_SECRET_KEY=__from_selectel_panel__
# Регион Selectel — обычно ru-1
S3_REGION=ru-1

# === 13. age (шифрование .env-бэкапов) =====================================
# PUBLIC ключ — безопасно хранится в repo (deploy/secrets/age-public.key).
# Сюда дублируем для удобства scripts/backup-env.sh.
AGE_PUBLIC_KEY=age1replace-with-real-public-key

# === 14. Среда выполнения ===================================================
NODE_ENV=production
# Уровень логов: debug / info / warn / error
LOG_LEVEL=info
# Timezone для логов и cron
TZ=Europe/Moscow
