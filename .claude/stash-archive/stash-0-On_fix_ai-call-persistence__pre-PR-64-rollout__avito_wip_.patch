+/**
+ * Get active tasks attached to a lead — by chat, by driver, or by contact.
+ * Used by chat-side widgets (pinned banner, drawer section, smart modal)
+ * to surface what's already in flight before the manager opens a duplicate.
+ *
+ * Lookup is an OR over the three identifiers — same lead can be reachable
+ * by any of them depending on whether Driver promotion has happened yet.
+ * Returns sorted: main-scenario tasks first, then by createdAt desc.
+ */
+export async function getTasksForLead(params: {
+    chatId?: string | null
+    driverId?: string | null
+    contactId?: string | null
+}): Promise<TaskDTO[]> {
+    const or: Prisma.TaskWhereInput[] = []
+    if (params.chatId)    or.push({ chatId:    params.chatId })
+    if (params.driverId)  or.push({ driverId:  params.driverId })
+    if (params.contactId) or.push({ contactId: params.contactId })
+
+    if (or.length === 0) return []
+
+    const mainIds = getMainScenarioIds()
+
+    const tasks = await prisma.task.findMany({
+        where: { OR: or, isActive: true },
+        orderBy: [{ createdAt: 'desc' }],
+        include: TASK_DTO_INCLUDE,
+    })
+
+    const dtos = tasks.map(toTaskDTO)
+    // Main scenarios first, then everything else, then by createdAt desc.
+    dtos.sort((a, b) => {
+        const aMain = a.scenario ? mainIds.includes(a.scenario) : false
+        const bMain = b.scenario ? mainIds.includes(b.scenario) : false
+        if (aMain !== bMain) return aMain ? -1 : 1
+        return (b.createdAt ?? '').localeCompare(a.createdAt ?? '')
+    })
+    return dtos
+}
+
