+
+export interface KnowledgeRuntimeHealth {
+    /** Counts. */
+    activeItems:           number
+    verifiedItems:         number
+    draftItems:            number
+    archivedItems:         number
+    supersededItems:       number
+    conflictingItems:      number
+    requiresHumanItems:    number
+    /** Когда был последний завершённый extraction. */
+    lastExtractionAt:      string | null
+    lastExtractionStatus:  string | null
+    /** 7-day window analytics. */
+    last7d: {
+        totalDecisions:         number
+        escalationCount:        number
+        escalationRate:         number   // 0..1
+        autoReplyCount:         number
+        topEscalationReasons:   Array<{ reason: string; count: number }>
+        shadowVsRuntimeMismatch: number
+    }
+}
+
+/**
+ * Compact operational overview. НЕ analytics dashboard — просто
+ * "одной фразой что происходит". Используется в Sources subtab.
+ */
+export async function getKnowledgeRuntimeHealth(): Promise<KnowledgeRuntimeHealth> {
+    const empty: KnowledgeRuntimeHealth = {
+        activeItems: 0, verifiedItems: 0, draftItems: 0, archivedItems: 0,
+        supersededItems: 0, conflictingItems: 0, requiresHumanItems: 0,
+        lastExtractionAt: null, lastExtractionStatus: null,
+        last7d: {
+            totalDecisions: 0, escalationCount: 0, escalationRate: 0,
+            autoReplyCount: 0, topEscalationReasons: [],
+            shadowVsRuntimeMismatch: 0,
+        },
+    }
+    try {
+        // Counts по items.
+        const countRows = await prisma.$queryRaw<any[]>`
+            SELECT
+                COUNT(*) FILTER (WHERE status::text = 'active'    AND "isActive" = true)::int  AS "active",
+                COUNT(*) FILTER (WHERE "isVerified" = true)::int                               AS verified,
+                COUNT(*) FILTER (WHERE status::text = 'draft')::int                            AS draft,
+                COUNT(*) FILTER (WHERE status::text = 'archived')::int                         AS archived,
+                COUNT(*) FILTER (WHERE status::text = 'superseded')::int                       AS superseded,
+                COUNT(*) FILTER (WHERE "conflictGroupId" IS NOT NULL AND status::text='active')::int AS conflicting,
+                COUNT(*) FILTER (WHERE "safetyLevel"::text='requires_human' AND status::text='active')::int AS "requiresHuman"
+            FROM "AiKnowledgeItem"
+        `
+        const c = countRows[0] || {}
+
+        // Last extraction.
+        const lastExtractionRows = await prisma.$queryRaw<any[]>`
+            SELECT status::text AS status, "finishedAt"
+            FROM "AiExtractionJob"
+            WHERE "finishedAt" IS NOT NULL
+            ORDER BY "finishedAt" DESC
+            LIMIT 1
+        `
+        const lastEx = lastExtractionRows[0]
+
+        // 7-day decision stats. Берём только записи с retrievalMode (то
+        // есть shadow или runtime) — legacy без trace тут не считается,
+        // это shadow rollout health, не общая статистика AI.
+        const decisionStatsRows = await prisma.$queryRaw<any[]>`
+            SELECT
+                COUNT(*)::int AS total,
+                COUNT(*) FILTER (WHERE "retrievalDecision" = 'escalate')::int AS "escalateCnt",
+                COUNT(*) FILTER (WHERE decision = 'auto_reply')::int          AS "autoReplyCnt"
+            FROM "AiDecisionLog"
+            WHERE "createdAt" >= NOW() - INTERVAL '7 days'
+              AND "retrievalMode" IS NOT NULL
+              AND "retrievalMode" != 'legacy'
+        `
+        const d = decisionStatsRows[0] || {}
+        const total = Number(d.total ?? 0)
+        const escCnt = Number(d.escalateCnt ?? 0)
+
+        // Top escalation reasons.
+        const reasonRows = await prisma.$queryRaw<any[]>`
+            SELECT "escalationReason" AS reason, COUNT(*)::int AS cnt
+            FROM "AiDecisionLog"
+            WHERE "createdAt" >= NOW() - INTERVAL '7 days'
+              AND "escalationReason" IS NOT NULL
+            GROUP BY "escalationReason"
+            ORDER BY cnt DESC
+            LIMIT 5
+        `
+
+        // Shadow vs runtime mismatch: в shadow-режиме мы пишем
+        // shadowRetrievalSummary, а реальный decision формирует legacy
+        // pipeline. Mismatch — это когда shadow считает escalate, а AI
+        // ответил, или наоборот. Это полезный сигнал перед runtime flip.
+        const mismatchRows = await prisma.$queryRaw<any[]>`
+            SELECT COUNT(*)::int AS cnt
+            FROM "AiDecisionLog"
+            WHERE "createdAt" >= NOW() - INTERVAL '7 days'
+              AND "retrievalMode" = 'shadow'
+              AND "shadowRetrievalSummary" IS NOT NULL
+              AND (
+                  (("shadowRetrievalSummary"->>'decision') = 'escalate' AND decision = 'auto_reply')
+                OR
+                  (("shadowRetrievalSummary"->>'decision') = 'answer'   AND decision = 'escalate')
+              )
+        `
+
+        return {
+            activeItems:        Number(c.active ?? 0),
+            verifiedItems:      Number(c.verified ?? 0),
+            draftItems:         Number(c.draft ?? 0),
+            archivedItems:      Number(c.archived ?? 0),
+            supersededItems:    Number(c.superseded ?? 0),
+            conflictingItems:   Number(c.conflicting ?? 0),
+            requiresHumanItems: Number(c.requiresHuman ?? 0),
+            lastExtractionAt:     lastEx?.finishedAt ?? null,
+            lastExtractionStatus: lastEx?.status ?? null,
+            last7d: {
+                totalDecisions:  total,
+                escalationCount: escCnt,
+                escalationRate:  total > 0 ? escCnt / total : 0,
+                autoReplyCount:  Number(d.autoReplyCnt ?? 0),
+                topEscalationReasons: reasonRows.map(r => ({
+                    reason: r.reason,
+                    count:  Number(r.cnt),
+                })),
+                shadowVsRuntimeMismatch: Number(mismatchRows[0]?.cnt ?? 0),
+            },
+        }
+    } catch {
+        return empty
+    }
+}
