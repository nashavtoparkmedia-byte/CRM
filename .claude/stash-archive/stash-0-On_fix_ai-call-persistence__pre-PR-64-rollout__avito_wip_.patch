+/**
+ * Bulk verify items. Skip уже verified. Audit per-item.
+ * Used by UI в архиве — "Подтвердить выбранные".
+ */
+export async function bulkVerifyKnowledgeItems(itemIds: string[]): Promise<{ verified: number }> {
+    const actor = await requireAdminUserId()
+    if (!Array.isArray(itemIds) || itemIds.length === 0) return { verified: 0 }
+    let verified = 0
+    for (const id of itemIds) {
+        try {
+            const before = await prisma.$queryRaw<any[]>`
+                SELECT id, title, status::text AS status, "isActive", "isVerified",
+                       "safetyLevel"::text AS "safetyLevel",
+                       confidence, "sourceCount", "uniqueManagerCount",
+                       tags, "canonicalStatement",
+                       "conflictGroupId", "supersededByItemId",
+                       "verifiedBy", "verifiedAt"
+                FROM "AiKnowledgeItem" WHERE id = ${id} LIMIT 1
+            `
+            const row = before[0]
+            if (!row || row.isVerified) continue
+            await prisma.$executeRaw`
+                UPDATE "AiKnowledgeItem"
+                SET "isVerified" = true,
+                    "verifiedBy" = ${actor},
+                    "verifiedAt" = NOW(),
+                    "updatedAt"  = NOW()
+                WHERE id = ${id}
+            `
+            await writePR5Audit({
+                itemId: id, actor, action: 'verified',
+                before: snapshotPR5(row),
+                after: snapshotPR5({ ...row, isVerified: true, verifiedBy: actor, verifiedAt: new Date() }),
+                metadata: { bulk: true },
+            })
+            verified++
+        } catch {
+            /* per-item tolerant */
+        }
+    }
+    revalidatePath('/settings/ai')
+    return { verified }
+}
+
+/**
+ * Bulk archive все draft-items (опционально только в одной секции).
+ * Скрывает их из любых retrieval scope'ов. Audit per-item.
+ */
+export async function bulkArchiveDraftItems(sectionId?: string): Promise<{ archived: number }> {
+    const actor = await requireAdminUserId()
+    const rows = sectionId
+        ? await prisma.$queryRaw<any[]>`
+            SELECT id, title, status::text AS status, "isActive", "isVerified",
+                   "safetyLevel"::text AS "safetyLevel",
+                   confidence, "sourceCount", "uniqueManagerCount",
+                   tags, "canonicalStatement",
+                   "conflictGroupId", "supersededByItemId",
+                   "verifiedBy", "verifiedAt"
+            FROM "AiKnowledgeItem"
+            WHERE status::text = 'draft' AND "sectionId" = ${sectionId}
+        `
+        : await prisma.$queryRaw<any[]>`
+            SELECT id, title, status::text AS status, "isActive", "isVerified",
+                   "safetyLevel"::text AS "safetyLevel",
+                   confidence, "sourceCount", "uniqueManagerCount",
+                   tags, "canonicalStatement",
+                   "conflictGroupId", "supersededByItemId",
+                   "verifiedBy", "verifiedAt"
+            FROM "AiKnowledgeItem"
+            WHERE status::text = 'draft'
+        `
+    let archived = 0
+    for (const row of rows) {
+        try {
+            await prisma.$executeRaw`
+                UPDATE "AiKnowledgeItem"
+                SET status = 'archived'::"AiKnowledgeStatus",
+                    "isActive" = false,
+                    "updatedAt" = NOW()
+                WHERE id = ${row.id}
+            `
+            await writePR5Audit({
+                itemId: row.id, actor, action: 'archived',
+                before: snapshotPR5(row),
+                after:  snapshotPR5({ ...row, status: 'archived', isActive: false }),
+                metadata: { bulk: true, reason: 'bulk_archive_drafts' },
+            })
+            archived++
+        } catch {
+            /* per-item tolerant */
+        }
+    }
+    revalidatePath('/settings/ai')
+    return { archived }
+}
