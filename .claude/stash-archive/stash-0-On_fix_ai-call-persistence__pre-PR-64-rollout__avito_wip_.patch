+// ─── AI Knowledge Core enums ──────────────────────────────────────
+// Подробности и red lines: memory/project_ai_knowledge_core.md
+
+enum AiKnowledgeStatus {
+  active        // используется retriever'ом по умолчанию
+  archived      // спрятано от retriever, видно админу
+  superseded    // заменено более новым item (см. AiKnowledgeItem.supersededByItemId)
+  draft         // зарезервировано под будущее (если введём ручную модерацию)
+  needs_review  // зарезервировано под будущее
+}
+
+enum AiKnowledgeSafety {
+  normal           // обычный факт
+  sensitive        // тарифы, деньги, юридические условия — требуют более высокого confidence
+  requires_human   // никогда не отвечаем сами, всегда escalate (например, скидки/индивидуальные условия)
+}
+
+enum AiKnowledgeSourceOrigin {
+  chat_message      // в MVP используется только это значение
+  voice_transcript  // под будущее: extraction из транскриптов AI-обзвона
+  manual_entry      // под будущее: админ создал item руками
+  doc_section       // под будущее: импорт PDF/MD-документов компании
+}
+
+enum AiKnowledgeRuntime {
+  chat_reply     // ContextBuilder → ResponseGenerator (текущий pipeline AI в чатах)
+  voice_reply    // под будущее: AI-обзвон AudioBridge
+  dev_simulate   // ai-calls dev-simulate / chat dry-run (без отправки)
+}
+
+enum AiExtractionStatus {
+  queued
+  running
+  completed
+  partial
+  failed
+}
+
+enum AiKnowledgeAuditAction {
+  created            // item создан экстрактором
+  manual_created     // item создан админом вручную
+  edited             // title/canonicalStatement/tags/safetyLevel изменены
+  archived           // status → archived (soft delete)
+  restored           // status → active (un-archive)
+  verified           // isVerified → true
+  unverified         // isVerified → false
+  superseded         // помечен как заменённый другим item'ом
+  conflict_resolved  // conflictGroupId снят или участники разруливаются
+  source_added       // (PR2 extractor пишет это для трейсабельности — опционально)
+}
+
 enum CallDirection {
