+// =====================================================================
+// AI Knowledge Core — extracted business memory + explainable retrieval.
+//
+// Channel-agnostic: AiKnowledgeSource.originType / AiKnowledgeUsageLog
+// .runtimeContext позволяют тот же слой памяти переиспользовать в voice
+// runtime (AI-обзвон) без миграции. В MVP используется только chat-сторона.
+//
+// В PR1 (foundation) — только schema + seed секций + read-only UI.
+// Никаких write/edit/extraction — это PR2. Pipeline ответа не трогается.
+//
+// Red lines зафиксированы в memory/project_ai_knowledge_core.md.
+// =====================================================================
+
+/// Раздел "книги знаний". Slug стабильный (используется в URL и seed'е),
+/// title редактируется админом. isActive скрывает целиком раздел в UI.
+model AiKnowledgeSection {
+  id          String            @id @default(cuid())
+  slug        String            @unique
+  title       String
+  description String?
+  /// Lucide icon key (BookOpen, Wallet, FileText, ...). Опционально —
+  /// если null, UI рендерит дефолтный.
+  iconKey     String?
+  sortOrder   Int               @default(0)
+  isActive    Boolean           @default(true)
+  createdAt   DateTime          @default(now())
+  updatedAt   DateTime          @updatedAt
+  items       AiKnowledgeItem[]
+
+  @@index([isActive, sortOrder])
+}
+
+/// Каноничный факт компании. Хранит ЧТО известно, а не КАК отвечать —
+/// формулировка ответа определяется стилем (AiAgentProfile) на этапе
+/// генерации. Поле canonicalStatement намеренно отделено от title:
+/// title — заголовок для UI, canonicalStatement — машинно-нейтральная
+/// формулировка для подмешивания в prompt retriever'а.
+model AiKnowledgeItem {
+  id                   String                @id @default(cuid())
+  sectionId            String
+  title                String
+  /// Каноничная формулировка факта компании. PII удалена, стиль нейтральный.
+  /// НЕ answer-шаблон. Стиль ответа берётся из активного AiAgentProfile.
+  canonicalStatement   String
+  tags                 String[]
+  /// Уверенность в знании. Рассчитывается экстрактором (PR2) как
+  /// weighted-aggregate по source.confidence. 0..1. minConfidenceForReply
+  /// в AiRetrievalPolicy решает, можно ли использовать в авто-ответе.
+  confidence           Float                 @default(0.5)
+  /// Raw count извлечений из истории. Может расти от одного менеджера —
+  /// тогда uniqueManagerCount остаётся = 1, что снижает доверие.
+  sourceCount          Int                   @default(0)
+  /// Сколько РАЗНЫХ менеджеров формулировали этот факт. Anti-bias:
+  /// один менеджер копи-пастит шаблон 50 раз != стабильное знание
+  /// компании. Используется retrieval policy.
+  uniqueManagerCount   Int                   @default(0)
+  status               AiKnowledgeStatus     @default(active)
+  /// Быстрый toggle админом (independent от status). Архивные items
+  /// тоже isActive=false, но архив можно "разархивировать" возвратом
+  /// status=active.
+  isActive             Boolean               @default(true)
+  /// Категория safety для retrieval policy. Sensitive (тарифы, деньги) —
+  /// требует более высокого confidence порога; requires_human — никогда
+  /// не отвечаем автоматом, всегда escalate.
+  safetyLevel          AiKnowledgeSafety     @default(normal)
+  /// Если новое правило заменило это (тариф обновился — старый item
+  /// уходит в status=superseded и указывает на нового). Отличаем от
+  /// conflictGroupId: supersession = смена правила во времени; conflict
+  /// = два item существуют одновременно с разными утверждениями.
+  supersededByItemId   String?               @unique
+  supersededByItem     AiKnowledgeItem?      @relation("supersession", fields: [supersededByItemId], references: [id])
+  supersedes           AiKnowledgeItem?      @relation("supersession")
+  /// Группировка конфликтующих items. retriever по policy не
+  /// отвечает при наличии conflict — эскалирует менеджеру.
+  conflictGroupId      String?
+  /// Verified-флаг (PR2.5 governance). Поднимается админом вручную через
+  /// кнопку "Подтвердить" в UI. Manual items (createdBy != 'extractor')
+  /// автоверифицированы при создании. PR3 retrieval будет давать
+  /// verified items более высокий priority.
+  isVerified           Boolean               @default(false)
+  verifiedBy           String?
+  verifiedAt           DateTime?
+  /// Кто создал: 'extractor' | userId. Manual items админ создаёт через
+  /// UI (PR2.5).
+  createdBy            String?
+  /// Timestamp последнего использования в retrieval — для UI sorting и
+  /// для будущего LRU-cleanup. Пишется из AiKnowledgeUsageLog в PR3.
+  lastUsedAt           DateTime?
+  createdAt            DateTime              @default(now())
+  updatedAt            DateTime              @updatedAt
+  section              AiKnowledgeSection    @relation(fields: [sectionId], references: [id])
+  sources              AiKnowledgeSource[]
+  usages               AiKnowledgeUsageLog[]
+
+  @@index([sectionId, status, isActive])
+  @@index([conflictGroupId])
+  @@index([status, updatedAt(sort: Desc)])
+}
+
+/// Доказательство откуда извлечено знание. Excerpt всегда PII-masked
+/// (имена/телефоны/ВУ заменены на токены) ДО сохранения — см. PII layer
+/// в extraction worker (PR2).
+///
+/// originType polymorphic: chat_message / voice_transcript / manual_entry /
+/// doc_section. В PR1+PR2 используется только chat_message; остальные
+/// под будущее без миграции.
+///
+/// messageId/chatId — soft references (без FK), чтобы удаление сырого
+/// сообщения не каскадировало в knowledge layer. UI компенсирует null'ом
+/// при отображении исходного фрагмента.
+model AiKnowledgeSource {
+  id            String                  @id @default(cuid())
+  itemId        String
+  originType    AiKnowledgeSourceOrigin @default(chat_message)
+  messageId     String?
+  chatId        String?
+  channel       ChatChannel?
+  managerUserId String?
+  /// PII-masked фрагмент исходного сообщения, на основе которого
+  /// извлечено знание. НЕ полное сообщение — короткая выдержка.
+  excerpt       String
+  /// sha256(itemId + messageId + excerpt). Гарантирует идемпотентность
+  /// при повторных запусках экстрактора. См. @@unique ниже.
+  excerptHash   String
+  confidence    Float
+  /// Когда было отправлено исходное сообщение (Message.sentAt).
+  /// Используется для recency-веса в retrieval ranking.
+  occurredAt    DateTime?
+  createdAt     DateTime                @default(now())
+  item          AiKnowledgeItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
+
+  @@unique([itemId, excerptHash])
+  @@index([itemId])
+  @@index([messageId])
+  @@index([managerUserId])
+}
+
+/// Лог использования знания в ответе AI. Source-of-truth для
+/// explainability ("Почему AI так ответил?" — PR4). Channel-agnostic:
+/// runtimeContext отличает chat-ответ от voice-ответа (когда появится).
+///
+/// decisionLogId — soft reference на AiDecisionLog (без FK), чтобы
+/// удаление старых логов решений не каскадировало в knowledge usage.
+///
+/// retrievalScore (BM25/keyword stage) и rerankScore (LLM rerank stage)
+/// пишутся в PR3 при включении retriever'а.
+model AiKnowledgeUsageLog {
+  id             String              @id @default(cuid())
+  itemId         String
+  runtimeContext AiKnowledgeRuntime  @default(chat_reply)
+  decisionLogId  String?
+  messageId      String?
+  retrievalScore Float?
+  rerankScore    Float?
+  /// true если item реально попал в финальный prompt генератора. false
+  /// если был в top-k retrieval, но отброшен rerank/policy.
+  usedInReply    Boolean             @default(false)
+  /// PR3: исход policy для этого item'а:
+  /// 'used' | 'filtered_archived' | 'filtered_superseded' | 'filtered_draft'
+  /// 'filtered_low_confidence' | 'filtered_conflict' | 'filtered_safety'.
+  /// Null для legacy записей.
+  policyDecision String?
+  /// PR3: запись сделана в shadow mode (НЕ дошло до клиента). Позволяет
+  /// фильтровать "что мы бы сделали" vs "что реально отправили".
+  shadowMode     Boolean             @default(false)
+  /// PR3: причина эскалации (если policy решил скипнуть item / весь
+  /// retrieval). Совпадает по словарю с AiDecisionLog.escalationReason.
+  escalationReason String?
+  usedAt         DateTime            @default(now())
+  item           AiKnowledgeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
+
+  @@index([itemId, usedAt(sort: Desc)])
+  @@index([decisionLogId])
+  @@index([usedAt(sort: Desc)])
+  @@index([shadowMode, usedAt(sort: Desc)])
+}
+
+/// Задание на извлечение знаний из истории. Создаётся в PR2 кнопкой
+/// "Собрать ядро знаний". scope JSON: { channels?, sinceImportJobId?,
+/// dateFrom?, dateTo?, sampleSize? }. progress JSON:
+/// { messagesScanned, pairsBuilt, candidatesFound, itemsCreated,
+/// itemsMerged, itemsAsDraft, sourcesAdded, conflictsDetected }.
+model AiExtractionJob {
+  id           String                  @id @default(cuid())
+  status       AiExtractionStatus      @default(queued)
+  /// Под будущее: chat_message в MVP, voice_transcript когда добавим
+  /// voice-экстрактор.
+  sourceType   AiKnowledgeSourceOrigin @default(chat_message)
+  scope        Json                    @default("{}")
+  progress     Json?
+  /// Snapshot модели и pipeline на момент запуска job — для
+  /// explainability и regression analysis ("ядро собрано моделью X
+  /// промптом vN"). Пишется при старте Extractor.run, не редактируется.
+  extractionProvider      String?
+  extractionModel         String?
+  extractionPromptVersion String?
+  /// Какой пресет был выбран в UI: 'economy'/'balanced'/'quality'.
+  /// Нужен отдельно от model — между запусками config мог сменить
+  /// classificationModel, и tier позволяет "тот же тип запуска,
+  /// но с новой моделью".
+  extractionQualityTier   String?
+  startedAt    DateTime?
+  finishedAt   DateTime?
+  errorMessage String?
+  createdBy    String?
+  createdAt    DateTime                @default(now())
+
+  @@index([status, createdAt(sort: Desc)])
+}
+
+/// PR3 retrieval policy — singleton настройки безопасности и порогов
+/// для answer-time pipeline. Mirror env flags (AI_KNOWLEDGE_SHADOW_MODE /
+/// AI_KNOWLEDGE_RUNTIME_ENABLED) сохраняется здесь для UI visibility,
+/// но source-of-truth остаётся env — это контролируется деплоем, не
+/// настройкой через UI (защита от случайного flip админом).
+model AiRetrievalPolicy {
+  id                        String   @id @default("singleton")
+  /// Минимальная уверенность item'а для авто-ответа.
+  minConfidenceForReply     Float    @default(0.7)
+  /// Для sensitive items (тарифы/проценты/деньги) — более жёсткий порог.
+  sensitiveConfidenceMargin Float    @default(0.85)
+  /// Минимальное число sources для авто-ответа (verified items проходят
+  /// даже с 1 — это manual или strong-signal extraction).
+  minSourceCountForReply    Int      @default(1)
+  /// Бонус к итоговому score за isVerified=true (после prefilter).
+  verifiedScoreBoost        Float    @default(0.2)
+  /// Scope: что retriever скрывает по умолчанию.
+  excludeArchived           Boolean  @default(true)
+  excludeSuperseded         Boolean  @default(true)
+  excludeDraft              Boolean  @default(true)
+  /// Эскалировать при unresolved conflict в retrieval result.
+  conflictEscalates         Boolean  @default(true)
+  /// Под будущее: maxStaleDays — если самый свежий source старше N
+  /// дней, retriever помечает item как stale. В PR3 не используется.
+  maxStaleDays              Int?
+  /// LLM rerank stage: можно отключить (deterministic-only) для smoke /
+  /// диагностики.
+  rerankEnabled             Boolean  @default(true)
+  rerankTopN                Int      @default(5)
+  prefilterTopN             Int      @default(20)
+  /// Mirror env flags. Изменение здесь — informational; runtime берёт
+  /// из env при старте процесса.
+  shadowMode                Boolean  @default(true)
+  runtimeEnabled            Boolean  @default(false)
+  /// Версия policy + retrieval-pipeline. Bump при содержательных
+  /// изменениях retrieval-prompt'а или policy decision tree.
+  policyVersion             String   @default("v1")
+  createdAt                 DateTime @default(now())
+  updatedAt                 DateTime @updatedAt
+  updatedBy                 String?
+}
+
+/// PR2.5 governance: lightweight audit trail для изменений Knowledge
+/// Core админом. JSON-snapshots перед/после действия — не diff. Чтобы
+/// "Почему AI так ответил?" в PR4 мог показать историю правок item'а,
+/// а PR3 retrieval мог отличать stable от часто меняющихся знаний.
+///
+/// itemId — soft-link (nullable), потому что при возможных удалениях
+/// item'а в будущем audit history должна сохраниться. В PR2.5 hard
+/// delete не разрешён, но архитектурно готовимся.
+model AiKnowledgeAuditLog {
+  id          String                @id @default(cuid())
+  itemId      String?
+  /// userId совершившего действие. null если system (для autoverify
+  /// при manual create — пишем actor).
+  actor       String?
+  action      AiKnowledgeAuditAction
+  /// JSON-snapshot до действия. Для 'created' — null.
+  beforeJson  Json?
+  /// JSON-snapshot после. Для 'archived'/'restored' — обновлённое поле status/isActive.
+  afterJson   Json?
+  /// Свободное место для контекста: { reason, fromConflictGroupId,
+  /// supersededBy, ... } — UI рендерит по action типу.
+  metadata    Json?
+  createdAt   DateTime              @default(now())
+
+  @@index([itemId, createdAt(sort: Desc)])
+  @@index([action, createdAt(sort: Desc)])
 }
 
