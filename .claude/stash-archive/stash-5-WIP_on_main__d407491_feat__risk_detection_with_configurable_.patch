+// ═══════════════════════════════════════════════════════════════════
+// TELEPHONY MODULE — MVP Phase 1
+// ═══════════════════════════════════════════════════════════════════
+
+enum DeviceStatus {
+  online
+  offline
+}
+
+enum CallStatus {
+  ringing
+  active
+  completed
+  failed
+}
+
+enum CallDisposition {
+  answered
+  missed
+  busy
+  rejected
+  no_answer
+}
+
+enum CommandStatus {
+  pending
+  delivered
+  executed
+  failed
+}
+
+/// Android-устройство с SIM для телефонии
+model TelephonyDevice {
+  id            String       @id @default(cuid())
+  androidId     String       @unique
+  name          String
+  phoneNumber   String?
+  simOperator   String?
+  status        DeviceStatus @default(offline)
+  isActive      Boolean      @default(true)
+  revokedAt     DateTime?
+  lastHeartbeat DateTime?
+  appVersion    String?
+  deviceSecret  String       @unique
+  fcmToken      String?
+  metadata      Json?
+  createdAt     DateTime     @default(now())
+  updatedAt     DateTime     @updatedAt
+
+  callSessions  CallSession[]
+  commands      TelephonyCommand[]
+
+  @@index([status])
+  @@index([lastHeartbeat])
+  @@index([isActive])
+}
+
+/// Сессия звонка — от ringing до completed/failed
+model CallSession {
+  id             String           @id @default(cuid())
+  deviceId       String
+  device         TelephonyDevice  @relation(fields: [deviceId], references: [id])
+
+  chatId         String?
+  chat           Chat?            @relation(fields: [chatId], references: [id])
+  messageId      String?          @unique
+  message        Message?         @relation(fields: [messageId], references: [id])
+  contactId      String?
+  contact        Contact?         @relation(fields: [contactId], references: [id])
+
+  direction      MessageDirection
+  callerNumber   String
+  calleeNumber   String
+  status         CallStatus       @default(ringing)
+  startedAt      DateTime         @default(now())
+  answeredAt     DateTime?
+  endedAt        DateTime?
+  duration       Int?
+  disposition    CallDisposition?
+
+  androidCallId  String?
+  metadata       Json?
+
+  createdAt      DateTime         @default(now())
+  updatedAt      DateTime         @updatedAt
+
+  @@index([deviceId, startedAt(sort: Desc)])
+  @@index([deviceId, androidCallId])
+  @@index([deviceId, status])
+  @@index([callerNumber])
+  @@index([calleeNumber])
+  @@index([contactId])
+  @@index([chatId])
+}
+
+/// Команда от CRM к Android-устройству
+model TelephonyCommand {
+  id          String        @id @default(cuid())
+  deviceId    String
+  device      TelephonyDevice @relation(fields: [deviceId], references: [id])
+
+  type        String
+  payload     Json
+  status      CommandStatus @default(pending)
+
+  deliveredAt DateTime?
+  executedAt  DateTime?
+  failedAt    DateTime?
+  failReason  String?
+
+  createdAt   DateTime      @default(now())
+  updatedAt   DateTime      @updatedAt
+
+  @@index([deviceId, status])
+  @@index([status, createdAt])
+}
+
+// ═══════════════════════════════════════════════════════════════════
+// GROUP VISIBILITY — per-operator hide/show for group chats
+// ═══════════════════════════════════════════════════════════════════
+
+model GroupVisibility {
+  id         String   @id @default(cuid())
+  userId     String                    // CRM operator ID (from cookie crm_user_id, no FK — same pattern as Chat.assignedToUserId)
+  chatId     String
+  visibility String   @default("visible")  // 'visible' | 'hidden'
+  createdAt  DateTime @default(now())
+  updatedAt  DateTime @updatedAt
+
+  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
+
+  @@unique([userId, chatId])
+  @@index([userId])
+}
