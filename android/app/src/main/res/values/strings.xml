    <string name="notification_channel_name">Сообщения</string>
    <string name="notification_channel_description">Уведомления о новых сообщениях в чатах CRM</string>

    <!-- Remote push copy. Deliberately generic: the payload carries no message
         text, no contact name and no phone number, so a notification on a lock
         screen discloses only that something arrived. -->
    <string name="push_notification_title">Новое сообщение</string>
    <string name="push_notification_body">Нажмите, чтобы открыть диалог</string>

    <!-- Call alerts get their own channel so an operator can silence chat
         notifications without silencing calls, and the other way round. Both
         call kinds share the one channel: Android channel settings are what the
         operator actually sees, and a per-kind split would offer a choice
         nobody asked for. -->
    <string name="call_alert_channel_name">Звонки</string>
    <string name="call_alert_channel_description">Уведомления о входящих и пропущенных звонках</string>

    <!-- Same privacy rule as the message copy: the payload carries no number and
         no name, so a lock screen discloses only that a call happened. -->
    <string name="call_alert_incoming_title">Входящий звонок</string>
    <string name="call_alert_missed_title">Пропущенный звонок</string>
    <!-- Edge Basic auth (design R5.1 §3.6, §5). The staff gate, not the CRM
         login: these screens only ever ask for the staff login of the nginx
         gate in front of the CRM, and say nothing about who is signed in. -->
