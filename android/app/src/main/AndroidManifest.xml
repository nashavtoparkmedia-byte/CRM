<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ requires a runtime grant before any notification is shown.
         Stage 1 uses this only for the local test notification used to prove
         deep-link navigation; no remote push is registered or received yet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShellApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.YokoShell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage-1 acceptance aid: the action button on the ongoing
             diagnostics notification. Not exported — only this app can
             trigger it, so no other app can make the shell post a
             notification or choose its target. -->
        <receiver
            android:name=".TestNotificationSeed$SeedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ru.yokoone.crm.shell.action.SEED_TEST_NOTIFICATION" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
