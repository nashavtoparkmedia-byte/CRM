<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ requires a runtime grant before any notification is shown.
         The shell asks once; without it nothing this app posts reaches the
         screen, and the push path reports that truthfully rather than
         pretending a notification was displayed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShellApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.YokoShell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static launcher shortcut «Выйти и сменить сотрудника»
                 (edge design R5.1 §5.4). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Target of the static shortcut. Not exported: static shortcuts are
             started on behalf of this app (P8), so no other app can reach it.
             It hands MainActivity a process-local flag, never a trusted extra. -->
        <activity
            android:name=".OperatorResetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Relaunch after an edge context reset (R5.1 §5.3 step 7). Its own
             process so MainActivity's process can end while it waits; its own
             task (empty affinity) so finishAffinity() cannot take it along.
             The :reset process is inert: ShellApplication returns early there. -->
        <activity
            android:name=".ResetTrampolineActivity"
            android:process=":reset"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- WorkManager initializes on demand rather than through androidx
             startup. Every process this app starts - including the ones the
             system creates only to hand it a push - would otherwise open
             WorkManager's database and start its threads before knowing
             whether anything needs scheduling. ShellApplication supplies the
             configuration, so the first enqueue initializes it and a process
             that never enqueues never pays for it. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- N6: no token is created behind the token actor's back. Firebase
             auto-init would otherwise issue a token at every start; the actor
             (R5.1 §5.7.2) reads the provider itself, serially, and commits only
             under the reset epoch and the retired set. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- Firebase only dispatches to this when a default FirebaseApp exists,
             which requires an external google-services.json that this
             repository deliberately does not carry. Not exported: only the
             messaging library may start it. -->
        <service
            android:name=".push.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
