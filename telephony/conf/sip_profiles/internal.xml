<profile name="internal">
  <!--
    Internal SIP profile — where CRM managers register from Linphone (UDP)
    and the browser softphone (WebSocket).

    UDP: 5060
    WS:  7080 (insecure WebSocket — for dev only; switch to WSS in prod)

    Stage 1 (this stack on Windows): browser uses ws://localhost:7080 — Chrome
    permits insecure WS to localhost. For deployment, terminate WSS at a
    reverse proxy or replace this binding with wss-binding + a real cert.
  -->
  <aliases/>
  <gateways/>
  <domains>
    <domain name="all" alias="false" parse="true"/>
  </domains>

  <settings>
    <param name="user-agent-string" value="CRM-FS"/>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>

    <!-- Context for calls originated by registered users -->
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>

    <!-- RTP -->
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>

    <!-- SIP signaling -->
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="sip-port" value="5060"/>

    <!-- WebSocket binding for browser softphones (sip.js / JsSIP).
         Format: "ip:port". Use 7080 in dev; deploy reverse-proxy WSS for prod. -->
    <param name="ws-binding" value=":7080"/>
    <!-- TLS WSS is disabled in dev — uncomment + provide cert in prod
    <param name="wss-binding" value=":7443"/>
    -->

    <!-- Authentication — managers must register with a password -->
    <param name="auth-calls" value="true"/>
    <param name="apply-inbound-acl" value="domains"/>
    <param name="apply-register-acl" value="domains"/>

    <!-- Codec preferences — G.711 A-law (Megafon priority) + Opus for WebRTC -->
    <param name="inbound-codec-prefs" value="opus,PCMA,PCMU"/>
    <param name="outbound-codec-prefs" value="opus,PCMA,PCMU"/>
    <param name="inbound-codec-negotiation" value="generous"/>

    <!-- NAT handling (essential for WebRTC) -->
    <param name="aggressive-nat-detection" value="true"/>
    <param name="enable-3pcc" value="true"/>
    <param name="apply-nat-acl" value="nat.auto"/>

    <!-- WebRTC niceties -->
    <param name="rtcp-mux" value="true"/>
    <param name="enable-rtp-auto-adjust" value="true"/>
    <param name="liberal-dtmf" value="true"/>

    <!-- Allow non-registered numbers to call (when CRM originates click-to-call) -->
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>

    <!-- Channel timers -->
    <param name="session-timeout" value="1800"/>
    <param name="minimum-session-expires" value="120"/>
  </settings>
</profile>
