<profile name="internal">
  <!--
    Internal SIP profile — where CRM managers register from Linphone (UDP)
    and the browser softphone (WebSocket).

    Based on vanilla FS 1.10 sample, trimmed to what we actually use.

    Key insight: in FS 1.10, DTLS-SRTP for WebRTC is automatic. You do NOT
    set `dtls-srtp=true` or `rtp-secure-media=...` — those are for forcing
    secure mode on plain-UDP peers, and adding them blocks the auto-DTLS
    code path so FS replies "488 Not Acceptable Here" to WebRTC INVITEs
    (m=audio ... UDP/TLS/RTP/SAVPF) because it tries to answer with plain
    RTP/AVP. The single switch that turns WebRTC ON is:

       inbound-late-negotiation = true

    This lets sofia defer the media answer until after it has seen the
    DTLS fingerprint + AVPF transport, then auto-answer with matching
    UDP/TLS/RTP/SAVPF + its own fingerprint.

    Bind addresses are all 127.0.0.1 because WSL2 mirrored networking only
    forwards Windows-host ↔ WSL2 traffic via loopback. (Connections to the
    shared 192.168.x.x IP from Windows hit the physical NIC, not the WSL2
    vNIC.) The Megafon trunk runs on the separate `external` profile which
    keeps the real interface.
  -->
  <aliases/>
  <gateways/>
  <domains>
    <domain name="all" alias="false" parse="true"/>
  </domains>

  <settings>
    <param name="user-agent-string" value="CRM-FS"/>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>

    <!-- Calls from registered users land in `default` dialplan -->
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>

    <!-- THE WebRTC switch. Without this FS pre-answers media with plain
         RTP/AVP and rejects WebRTC SDP with 488. -->
    <param name="inbound-late-negotiation" value="true"/>

    <!-- Codec preferences.
         inbound  = what we ACCEPT from the browser → must include opus
                    (WebRTC default) or the browser INVITE is rejected
                    with "Incompatible SDP".
         outbound = what FS OFFERS when it originates a call → PCMA only,
                    so the b-leg INVITE to Megafon doesn't leak opus
                    (Megafon's SBC silently drops mixed-codec offers).
         FS will transcode opus⇄PCMA between the two legs. -->
    <param name="inbound-codec-prefs" value="opus,PCMA,PCMU"/>
    <param name="outbound-codec-prefs" value="PCMA"/>
    <param name="inbound-codec-negotiation" value="generous"/>

    <!-- RTP / SIP bind addresses — from env vars (see vars.xml exec-set).
         WSL2 local dev: both default to 127.0.0.1.
         VPS Docker: FREESWITCH_SIP_IP=0.0.0.0, FREESWITCH_EXT_IP=<public-ip> -->
    <param name="rtp-ip" value="$${sip_bind_ip}"/>
    <param name="ext-rtp-ip" value="$${freeswitch_ext_ip}"/>
    <param name="sip-ip" value="$${sip_bind_ip}"/>
    <param name="sip-port" value="5060"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="rtp-port-min" value="16384"/>
    <param name="rtp-port-max" value="32768"/>

    <!-- WebSocket binding for browser softphones (JsSIP).
         Bind to all interfaces so nginx (in crm_internal Docker network) can
         proxy WSS → WS to this port. -->
    <param name="ws-binding" value="0.0.0.0:7080"/>

    <!-- Authentication — managers must register with a password. -->
    <param name="auth-calls" value="true"/>

    <!-- WebRTC niceties — rtcp-mux must be true for browser-compatible RTP -->
    <param name="rtcp-mux" value="true"/>
    <param name="enable-rtp-auto-adjust" value="true"/>
    <param name="liberal-dtmf" value="true"/>

    <!-- rtp-secure-media=optional: tell FS to negotiate SRTP/DTLS-SRTP if the
         peer offers it, otherwise plain RTP. Without this FS settled the
         codecs on both legs at PCMA but then refused to build the a-leg
         answer SDP because no crypto context could be built — leading to
         "488 Incompatible Destination" right after Original read codec was
         set. With "optional" sofia builds the proper DTLS-SRTP fingerprint
         answer for the browser leg and plain-RTP for the Megafon leg. -->
    <param name="rtp-secure-media" value="optional"/>

    <!-- NAT handling — keep for Linphone over UDP -->
    <param name="aggressive-nat-detection" value="true"/>
    <param name="apply-nat-acl" value="nat.auto"/>

    <!-- ICE candidate filtering. The browser on Windows offers only its
         LAN IP (e.g. 192.168.0.100) as a host candidate; Chrome strips
         the 127.0.0.1 candidate from WebRTC offers by default. FS's
         default `wan.auto` candidate ACL only allows non-private (WAN)
         IPs, so it rejects 192.168.0.100 with "no suitable candidates
         found" → INCOMPATIBLE_DESTINATION right after codec negotiation.
         Apply `rfc1918.auto` so FS accepts RFC1918 candidates from the
         browser. Reachability is provided by WSL2 mirrored networking:
         FS on WSL2 can reach 192.168.0.100 via the host route. -->
    <param name="apply-candidate-acl" value="rfc1918.auto"/>
    <!-- loopback: coturn on WSL2 relays via 127.0.0.1 -->
    <param name="apply-candidate-acl" value="loopback.auto"/>
    <!-- wan: coturn on VPS relays via public IP (e.g. 155.212.130.14) -->
    <param name="apply-candidate-acl" value="wan.auto"/>

    <!-- No blind registrations -->
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>

    <!-- Channel timers -->
    <param name="session-timeout" value="1800"/>
    <param name="minimum-session-expires" value="120"/>
  </settings>
</profile>
