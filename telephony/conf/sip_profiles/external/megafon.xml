<include>
  <!--
    Megafon MultiFon Business SIP trunk.
    The username is intentionally a literal (it is the public DID). The trunk
    password is never committed: vars.xml sets the megafon_password global from
    the container environment variable MEGAFON_SIP_PASSWORD at start, and the
    image entrypoint refuses to start without a real value.
    Rotation procedure: docs/SECRETS.md.
  -->
  <gateway name="megafon">
    <param name="username" value="79221853150"/>
    <param name="password" value="$${megafon_password}"/>
    <param name="realm" value="multifon.ru"/>
    <param name="proxy" value="sbc.megafon.ru"/>
    <param name="from-user" value="79221853150"/>
    <param name="from-domain" value="multifon.ru"/>
    <param name="register" value="true"/>
    <param name="expire-seconds" value="180"/>
    <param name="register-transport" value="udp"/>
    <param name="retry-seconds" value="30"/>
    <param name="ping" value="60"/>

    <!-- Statically constrain the codecs this gateway will offer/accept.
         Channel-level overrides (absolute_codec_string, export
         nolocal:..., [var=val] inline prefix) all leaked through during
         bridge from a WebRTC a-leg — Megafon's SBC silently dropped the
         opus/multi-codec offer. Pinning it at the gateway is the only
         place sofia honours it before building the INVITE SDP. -->
    <param name="codec-prefs" value="PCMA"/>
    <param name="inbound-codec-prefs" value="PCMA"/>
    <param name="outbound-codec-prefs" value="PCMA"/>
  </gateway>
</include>
