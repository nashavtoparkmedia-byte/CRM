<include>
  <!--
    Outbound calls from a registered manager extension (101, 102, ...)
    to any external Russian number. Caller-ID is overwritten to the
    Megafon number so the callee sees the corporate number, not the
    extension number.

    Matches 11-digit national format (7XXXXXXXXXX / 8XXXXXXXXXX) and
    E.164 (+7XXXXXXXXXX). Strips the prefix, prepends 7, sends to gateway.
  -->
  <extension name="user_outbound_megafon">
    <!-- Note: dropped the ${user_exists} condition. It was checking whether the
         DESTINATION exists as a directory user, which is false for any external
         phone number — so dialplan never matched. The destination-number regex
         already restricts this to Russian 10-digit numbers, which is the
         security boundary we actually want. -->
    <condition field="destination_number" expression="^(?:\+7|7|8)(\d{10})$">
      <action application="set" data="effective_caller_id_number=$${megafon_username}"/>
      <action application="set" data="effective_caller_id_name=$${megafon_username}"/>
      <action application="set" data="hangup_after_bridge=true"/>
      <action application="set" data="continue_on_fail=true"/>


      <!-- Same recording setup as inbound — see 02_megafon_inbound.xml -->
      <action application="set" data="recording_follow_transfer=true"/>
      <action application="set" data="RECORD_STEREO=true"/>
      <action application="set" data="recording_file=/var/lib/freeswitch/recordings/${uuid}.wav"/>
      <action application="record_session" data="${recording_file}"/>

      <!-- pre_answer: finalize a-leg media negotiation (browser SDP) BEFORE
           building the b-leg offer. This breaks the codec-list inheritance
           chain that was leaking opus into the Megafon INVITE.
           After pre_answer the a-leg has its own concrete codec context
           (opus), and the b-leg builds an INDEPENDENT offer from the
           external profile's outbound-codec-prefs ($${global_codec_prefs}
           = PCMA,PCMU). FS transcodes opus⇄PCMA between the two legs. -->
      <action application="pre_answer"/>
      <action application="bridge" data="sofia/gateway/megafon/7$1"/>
    </condition>
  </extension>

  <!-- Internal extension-to-extension calls (101 <-> 102, etc.) -->
  <extension name="user_internal">
    <condition field="destination_number" expression="^(1\d{2})$">
      <action application="bridge" data="user/$1"/>
    </condition>
  </extension>
</include>
