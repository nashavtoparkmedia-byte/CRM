<!--
  Day 1 test extensions for the AI-call audio bridge.

  9999  — minimal: answer + audio_fork + park
          Use when calling from a live SIP client (Linphone / CRM softphone).
          External party speaks → mod_audio_fork streams PCM to bridge.
          uuid_broadcast played back via ESL from outside.

  9998  — loopback-friendly: answer + audio_fork + playback (Callie IVR
          welcome) + park. Lets you trigger the call without a live SIP
          client via `originate ... loopback/9998/default &park()` — FS
          plays a built-in WAV through the channel, which mod_audio_fork
          (mixed both) forks to the bridge. This proves PCM frames are
          flowing without a microphone in the loop.

  Notes:
   - audio_fork application params (drachtio mod v0.5+):
       start <ws-url> <mixing: mono|mixed|stereo> <sample-rate> <direction: both|listen|speak>
   - XML attributes use &quot; rather than C-style \" for JSON metadata.
-->
<include>
  <extension name="audio_fork_test">
    <condition field="destination_number" expression="^9999$">
      <action application="answer"/>
      <action application="sleep" data="500"/>
      <action application="set" data="fork_meta={&quot;callId&quot;:&quot;${uuid}&quot;,&quot;test&quot;:true,&quot;ext&quot;:9999}"/>
      <action application="audio_fork" data="start ws://127.0.0.1:3030/audio mixed 8000 both"/>
      <action application="park"/>
    </condition>
  </extension>

  <extension name="audio_fork_test_with_playback">
    <condition field="destination_number" expression="^9998$">
      <action application="answer"/>
      <action application="sleep" data="500"/>
      <action application="set" data="fork_meta={&quot;callId&quot;:&quot;${uuid}&quot;,&quot;test&quot;:true,&quot;ext&quot;:9998}"/>
      <action application="audio_fork" data="start ws://127.0.0.1:3030/audio mixed 8000 both"/>
      <!-- No external WAV needed: tone_stream:// is built-in. Plays
           440 Hz for 1s, silence 0.5s, then 880 Hz for 1s — same as our
           audio/test.wav. Proves mod_audio_fork forks real audio. -->
      <action application="playback" data="tone_stream://%(1000,500,440)"/>
      <action application="playback" data="tone_stream://%(1000,500,880)"/>
      <action application="park"/>
    </condition>
  </extension>
</include>
