<include>
  <!--
    Inbound call from Megafon SBC arrives via the external profile and is
    routed into the default context. We fork: every registered manager
    extension rings simultaneously. First to answer takes the call;
    everyone else stops ringing.

    Variable ${sip_to_user} contains the dialed Megafon number. We don't
    branch on it here because we currently have a single Megafon number —
    all incoming traffic goes to the same manager pool.
  -->

  <!-- Block SIP scanner probes: real Russian mobile/landline numbers are
       always 10+ digits after stripping the country code. Short CallerIDs
       like "401", "10001", "1000" are spoofed test IDs from internet scanners
       that hit any open SIP port. Reject them immediately so they don't create
       junk Call rows in the CRM database. -->
  <extension name="reject_sip_scanners" continue="true">
    <condition field="${sofia_profile_name}" expression="^external$" break="on-false"/>
    <condition field="${caller_id_number}" expression="^\d{1,9}$">
      <action application="respond" data="603 Declined"/>
      <action application="hangup"/>
    </condition>
  </extension>

  <extension name="megafon_inbound_fork">
    <!-- Match ONLY calls coming from the Megafon SBC. The original
         `source=mod_sofia` matched every sofia channel, including outbound
         calls originated from the browser (user 101 → 79XXX...), which then
         hit this "ring everyone" bridge and failed because 101 cannot bridge
         to itself. Restrict by inbound profile = external. -->
    <condition field="${sofia_profile_name}" expression="^external$">
      <action application="set" data="hangup_after_bridge=true"/>
      <action application="set" data="continue_on_fail=true"/>
      <action application="set" data="ringback=${us-ring}"/>

      <!-- Megafon sends plain RTP/AVP (no SRTP). The stock default.xml sets
           rtp_secure_media=true globally; override it here so the A-leg can
           negotiate without crypto while the B-leg (WebRTC/JsSIP) still uses
           DTLS-SRTP via the internal profile. -->
      <action application="set" data="rtp_secure_media=false"/>

      <!-- Recording: start when the call is answered, follow transfers.
           Pre-generate the file path using ${uuid} so the ESL handler can
           locate the WAV via variable_recording_file after hangup. -->
      <action application="set" data="RECORD_STEREO=true"/>
      <action application="set" data="recording_follow_transfer=true"/>
      <action application="set" data="recording_file=/var/lib/freeswitch/recordings/${uuid}.wav"/>
      <action application="set" data="execute_on_answer=record_session /var/lib/freeswitch/recordings/${uuid}.wav"/>

      <!-- Do not let early media or one unavailable browser select/fail the
           whole group before a manager actually answers. -->
      <action application="set" data="ignore_early_media=true"/>
      <action application="set" data="fail_on_single_reject=false"/>
      <action application="set" data="call_timeout=30"/>

      <!-- Ring every active registration for extensions 101/102/103.
           sofia_contact expands multiple browser/device registrations for
           each extension into a parallel contact list. The :_: enterprise
           delimiter dispatches the three extension groups independently;
           this avoids the BRIDGE_BLEG behaviour previously observed with a
           plain comma-separated user/101,user/102,user/103 bridge. The first
           browser to answer wins and FreeSWITCH cancels every other leg. -->
      <action application="bridge" data="${sofia_contact(internal/101@${domain_name})}:_:${sofia_contact(internal/102@${domain_name})}:_:${sofia_contact(internal/103@${domain_name})}"/>
    </condition>
  </extension>
</include>
