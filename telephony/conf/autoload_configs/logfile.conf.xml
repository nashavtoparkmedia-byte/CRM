<configuration name="logfile.conf" description="File Logging">
  <settings>
    <param name="rotate-on-hup" value="true"/>
  </settings>
  <profiles>
    <profile name="default">
      <settings>
        <!-- Rotate at 200 MB, keep max 2 rotations → max ~600 MB total -->
        <param name="rollover" value="209715200"/>
        <param name="maximum-rotate" value="2"/>
        <param name="uuid" value="true"/>
      </settings>
      <mappings>
        <!-- Skip debug/info/notice to suppress SIP-scanner spam;
             warning+ is enough for ops visibility -->
        <map name="all" value="warning,err,crit,alert"/>
      </mappings>
    </profile>
    <profile name="stdout">
      <settings>
        <param name="logfile" value="/dev/stdout"/>
        <param name="rollover" value="0"/>
        <param name="uuid" value="true"/>
      </settings>
      <mappings>
        <map name="all" value="warning,err,crit,alert"/>
      </mappings>
    </profile>
  </profiles>
</configuration>
