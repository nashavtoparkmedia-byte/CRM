# Megafon "MultiFon Business" SIP trunk credentials.
# Issued in the Megafon personal cabinet after activating the service.
# Copy this file to .env and fill in real values. NEVER commit .env.
MEGAFON_SIP_USERNAME=
MEGAFON_SIP_PASSWORD=

# Event Socket Layer password — used by gravity-mvp to connect and listen
# to call events. Change from the default in any non-dev environment.
ESL_PASSWORD=ClueCon

# Manager extension passwords. One per manager who can take calls.
# These go into Linphone settings and into the gravity-mvp browser softphone.
# Use long random strings in production.
MANAGER_101_PASSWORD=changeme101
MANAGER_102_PASSWORD=changeme102
