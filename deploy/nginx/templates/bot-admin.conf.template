# ─────────────────────────────────────────────────────────────────────────────
# bot-admin.conf — админка опросов (tg-bot-frontend)
# Доступ только для админов — basic auth + IP whitelist (опционально).
# ─────────────────────────────────────────────────────────────────────────────

upstream bot_admin_upstream {
    server tg-bot-frontend:3004 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${BOT_ADMIN_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        proxy_pass http://bot_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

