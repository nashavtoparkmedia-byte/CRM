# ─────────────────────────────────────────────────────────────────────────────
# crm.conf — основной CRM (gravity-mvp)
#
# Этап 1 миграции на yokoone.ru: обслуживаем 3 имени одновременно.
#   - ${CRM_DOMAIN}      → основной адрес продукта, проксирует на gravity-mvp
#   - ${CRM_WWW_DOMAIN}  → 301 на ${CRM_DOMAIN}
#   - ${CRM_APP_DOMAIN}  → legacy, временно проксирует на gravity-mvp (Этап 2
#                          переключит на 301 → ${CRM_DOMAIN})
#
# SSL: certs-init создаёт self-signed для всех имён при первом старте.
# get-ssl.sh выпускает реальный Let's Encrypt:
#   - один SAN cert на ${CRM_DOMAIN} + ${CRM_WWW_DOMAIN}
#   - отдельный cert на ${CRM_APP_DOMAIN}
#   - отдельный cert на ${BOT_ADMIN_DOMAIN}
# ─────────────────────────────────────────────────────────────────────────────

# HTTP — ACME challenge + 301 на HTTPS (для всех трёх имён)
server {
    listen 80;
    listen [::]:80;
    server_name ${CRM_DOMAIN} ${CRM_WWW_DOMAIN} ${CRM_APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ───────────────────────────────────────────────────────────────────────────
# HTTPS apex — ОСНОВНОЙ адрес продукта (${CRM_DOMAIN})
# ───────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name ${CRM_DOMAIN};

    # SAN cert покрывает apex + www
    ssl_certificate     /etc/letsencrypt/live/${CRM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CRM_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_prefer_server_ciphers off;

    # HSTS включаем после стабильной недели на боевом cert.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 64m;

    # ── Security P0 (2026-10-25): personal Basic-auth gate for the whole CRM ───
    # The application has no server-side authentication yet (Identity Access,
    # Staff Session v1, is a separate track). Until it lands, every request on
    # a CRM vhost needs a personal login; one htpasswd line per person, logged
    # as $remote_user. The gate sits at server level so a new location is
    # gated unless it opts out. /compensation keeps its own Cash gate below
    # (a location-level realm with its own user file); /wss-sip (FreeSWITCH,
    # SIP authentication of its own) opts out; `return` locations such as
    # /api/debug-db and /robots.txt answer before the access phase.
    #
    # The password file is host-managed and never committed (.gitignore):
    #   deploy/nginx/templates/auth/yoko-crm-staff.htpasswd, 0640 root:101,
    #   inside the auth/ directory (0710 root:101) so host-side traversal, not
    #   file ownership, keeps unrelated host accounts away from the hash.
    # Every Cash login must also be a staff login, or the /compensation page
    # assets are refused by this gate. The marker header lets an operator
    # prove which configuration the live workers serve.
    auth_basic "YOKO CRM";
    auth_basic_user_file /etc/nginx/templates/auth/yoko-crm-staff.htpasswd;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Yoko-Edge-Gate "crm-staff-p0-20261025" always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Debug/database diagnostics are not a production HTTP capability.
    # Application proxy.ts repeats this denial for direct-container traffic.
    location ^~ /api/debug-db {
        access_log off;
        return 404;
    }

    # ── Cash-compensation manager perimeter (temporary pilot) ──────────────
    # Infrastructure gate in front of the existing surface: the application
    # keeps its own identity model and is unchanged. Both CRM vhosts carry
    # this, otherwise the other hostname is an open bypass. The exact +
    # trailing-slash pair scopes the gate to the /compensation segment, so
    # sibling paths are untouched. Proxy directives are copied verbatim from
    # `location /` so the route's behaviour is unchanged apart from the gate.
    # Remove together with the pilot.
    location = /compensation {
        auth_basic           "YOKO compensation";
        auth_basic_user_file /etc/nginx/templates/auth/compensation.htpasswd;

        set $gravity_backend "http://gravity-mvp:3002";
        proxy_set_header Authorization "";
        proxy_pass $gravity_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /compensation/ {
        auth_basic           "YOKO compensation";
        auth_basic_user_file /etc/nginx/templates/auth/compensation.htpasswd;

        set $gravity_backend "http://gravity-mvp:3002";
        proxy_set_header Authorization "";
        proxy_pass $gravity_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SIP WebSocket: browser connects wss://yokoone.ru/wss-sip
    # nginx proxies WSS → plain WS → FreeSWITCH on host (host.docker.internal:7080)
    # FS runs in host network mode so ICE candidates carry the public VPS IP directly.
    location /wss-sip {
        auth_basic off;
        proxy_pass http://host.docker.internal:7080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        set $gravity_backend "http://gravity-mvp:3002";
        proxy_set_header Authorization "";
        proxy_pass $gravity_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# ───────────────────────────────────────────────────────────────────────────
# HTTPS www — 301 на apex (тот же SAN cert)
# ───────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name ${CRM_WWW_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CRM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CRM_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    return 301 https://${CRM_DOMAIN}$request_uri;
}

# ───────────────────────────────────────────────────────────────────────────
# HTTPS app — LEGACY, временно полный CRM (Этап 1).
# В Этапе 2 будет заменено на `return 301 https://${CRM_DOMAIN}$request_uri;`
# ───────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name ${CRM_APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CRM_APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CRM_APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 64m;

    # ── Security P0 (2026-10-25): personal Basic-auth gate for the whole CRM ───
