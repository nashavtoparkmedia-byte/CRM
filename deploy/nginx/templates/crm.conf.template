# ─────────────────────────────────────────────────────────────────────────────
# crm.conf — основной CRM (gravity-mvp)
#
# ${CRM_DOMAIN} подставляется при старте nginx из env (см. compose).
# Если домен не задан, server_name = _disabled_crm → блок неактивен.
#
# SSL: после получения сертификата Let's Encrypt раскомментировать listen 443.
# До этого — работает только HTTP на 80 (для теста / ACME challenge).
# ─────────────────────────────────────────────────────────────────────────────

# Upstream — gravity-mvp слушает 3002 внутри Docker-сети
upstream gravity_mvp_upstream {
    server gravity-mvp:3002 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP — редирект на HTTPS (когда SSL будет настроен) + ACME challenge
server {
    listen 80;
    listen [::]:80;
    server_name ${CRM_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Пока SSL нет — проксируем напрямую. После настройки SSL заменить на:
    #   return 301 https://$host$request_uri;
    location / {
        proxy_pass http://gravity_mvp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Большие медиа (голосовые, видео) могут идти через CRM API
        client_max_body_size 64m;
    }
}

