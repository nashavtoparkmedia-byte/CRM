SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRM_PRODUCTION_ENV_FILE=/opt/crm/.env.production
CRM_OPERATIONAL_ENV_FILE=/var/lib/crm/max-personal-text-operational.env
HEALTH_STATE_DIR=/var/lib/crm/health-state
EXPECTED_CONTAINERS=crm-postgres crm-redis crm-nginx crm-gravity-mvp crm-max-personal-gateway crm-max-scraper
HEALTH_MONITOR_ENABLE_S3_BACKUP_CHECK=false
PERSONAL_MAX_TEXT_V1_MONITOR_ENABLED=true
PERSONAL_MAX_TEXT_V1_BACKUP_PATH=/var/backups/personal-max-rc3-contact-identity-20260802T001545Z/production-before-rc3-contact-identity.dump
PERSONAL_MAX_TEXT_V1_BACKUP_SHA256=61608ed2daca1a9fb05a3d4c00ed09acdd177e62f6bf7e9a134d6badc9d6e064
PERSONAL_MAX_TEXT_V1_BACKUP_MAX_AGE_SECONDS=93600
PERSONAL_MAX_TEXT_V1_QUEUE_GRACE_SECONDS=300
PERSONAL_MAX_TEXT_V1_WS_GRACE_SECONDS=120
PERSONAL_MAX_TEXT_V1_DISK_MIN_FREE_BYTES=10737418240

* * * * * root /usr/local/sbin/crm-health-monitor.sh >> /var/log/crm-health.log 2>&1
