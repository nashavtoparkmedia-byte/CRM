; systemd unit template for the AudioBridge (Node).
;
; Copy to /etc/systemd/system/audio-bridge.service, then:
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now audio-bridge
;   sudo systemctl status audio-bridge
;
; All bracketed paths must be filled in for the host. Secrets go in
; the EnvironmentFile (not in this unit, not in the repo).

[Unit]
Description=AI-call AudioBridge (mod_audio_fork ↔ STT/LLM/TTS)
Documentation=https://github.com/nashavtoparkmedia-byte/CRM/blob/main/docs/operations/deployment.md
; Bridge depends on FreeSWITCH (ESL :8021) and the CRM HTTP surface
; (resolveCallByUuid, finalize). It reconnects to both with backoff
; (PRs #51/#52/#55), so a hard ordering isn't strictly required, but
; listing them keeps startup logs cleaner.
After=network-online.target freeswitch.service crm.service
Wants=network-online.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/srv/crm/tools/audio-bridge-day1
; Bridge env: CRM_BASE_URL, BRIDGE_SHARED_TOKEN (if set), HTTPS_PROXY,
; YANDEX_STT_TIMEOUT_MS override, etc. NOT committed.
EnvironmentFile=/etc/crm/audio-bridge.env
ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

; Graceful shutdown: server.js installs SIGTERM/SIGINT handlers
; (server.js:850-851). 10 s gives them room; we don't have an active
; in-flight persistence layer, so a hard exit after 10 s is fine —
; the stale-session reaper (PR #43) will reconcile any orphaned
; Call rows after the 30-min TTL.
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=audio-bridge

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/crm /var/log/crm

[Install]
WantedBy=multi-user.target
