# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example — шаблон. Скопировать в .env.production и заполнить.
#
#   cp deploy/.env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production
#
# .env.production НЕ коммитится — он в .gitignore.
# После заполнения — запустить `bash scripts/backup-env.sh` чтобы залить
# зашифрованную копию в S3.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_32_chars
POSTGRES_DB=crm

# ─── Redis (для прода — обязательно с паролем) ───────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ─── Бэкапы / S3 ─────────────────────────────────────────────────────────────
# rclone remote name (из ~/.config/rclone/rclone.conf)
BACKUP_S3_REMOTE=selectel:crm-backups

# ─── Алерты в Telegram (@yoko_park_bot) ──────────────────────────────────────
ALERT_BOT_TOKEN=CHANGE_ME_telegram_bot_token
ALERT_CHAT_ID=CHANGE_ME_your_telegram_user_id

# ─── Контейнеры (имена для health-monitor.sh) ────────────────────────────────
# Можно переопределить при дебаге; обычно дефолтные
# PG_CONTAINER=crm-postgres
# EXPECTED_CONTAINERS="crm-postgres crm-redis crm-nginx"

# ─── Прикладные сервисы (заполняется в PR 2) ─────────────────────────────────
# DATABASE_URL=postgresql://crm:PASSWORD@postgres:5432/crm
# BOT_TOKEN=...
# BOT_CRM_SECRET=...
# ANTHROPIC_API_KEY=...
# HTTPS_PROXY=socks5://xray:10808
# ... и т.д. — см. docs/SECRETS.md, раздел 2
