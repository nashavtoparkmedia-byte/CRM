            "startEpoch": {"type": "integer", "minimum": 0},
            "endEpoch": {"type": "integer", "minimum": 0},
            "seconds": {"enum": [300, 1800, 7200, 86400]}
          },
          "additionalProperties": false
        },
        "accountCount": {"type": "integer", "minimum": 0, "maximum": 2},
        "accounts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/account"}},
        "totals": {
          "type": "object",
          "required": ["rawJournalRows", "rawJournalRowsPerSecond"],
          "properties": {"rawJournalRows": {"type": "integer", "minimum": 0}, "rawJournalRowsPerSecond": {"$ref": "#/$defs/nonnegative"}},
          "additionalProperties": false
        },
        "activity": {
          "type": "object",
          "required": ["active_sessions", "long_transactions"],
          "properties": {
            "active_sessions": {"type": "integer", "minimum": 0},
            "long_transactions": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "locks": {
          "type": "object",
          "required": ["waiting_locks"],
          "properties": {"waiting_locks": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        "schemaState": {
          "type": "object",
          "required": ["migrationLedger", "rawJournal"],
          "properties": {
            "migrationLedger": {
              "type": "object",
              "required": ["total", "finished", "failed", "appliedExpectedMigrations"],
              "properties": {
                "total": {"type": "integer", "minimum": 0},
                "finished": {"type": "integer", "minimum": 0},
                "failed": {"type": "integer", "minimum": 0},
                "appliedExpectedMigrations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false
            },
            "rawJournal": {
              "type": "object",
              "required": ["relationKind", "constraints", "expectedConstraintDefinitionsExact", "appendOnlyTriggerPresent", "appendOnlyContractExact"],
              "properties": {
                "relationKind": {"type": "string"},
                "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "expectedConstraintDefinitionsExact": {"type": "boolean"},
                "appendOnlyTriggerPresent": {"type": "boolean"},
                "appendOnlyContractExact": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": ["alias", "rawJournalRows", "rawJournalRowsPerSecond", "accidentalDuplicateEnvelopes", "rawQuarantined", "normalizationResults", "normalizationQuarantined", "normalizationUnsupported", "semanticComparisons", "semanticRegressions", "criticalRegressions", "criticalDiffs", "routeIdentityCritical", "openRouteConflicts", "unprocessedRows", "oldestUnprocessedSeconds", "journalLatencyMs"],
      "properties": {
        "alias": {"$ref": "#/$defs/sha256"},
        "rawJournalRows": {"$ref": "#/$defs/nonnegative"}, "rawJournalRowsPerSecond": {"$ref": "#/$defs/nonnegative"},
        "accidentalDuplicateEnvelopes": {"$ref": "#/$defs/nonnegative"}, "rawQuarantined": {"$ref": "#/$defs/nonnegative"},
        "normalizationResults": {"$ref": "#/$defs/nonnegative"}, "normalizationQuarantined": {"$ref": "#/$defs/nonnegative"},
        "normalizationUnsupported": {"$ref": "#/$defs/nonnegative"}, "semanticComparisons": {"$ref": "#/$defs/nonnegative"},
        "semanticRegressions": {"$ref": "#/$defs/nonnegative"}, "criticalRegressions": {"$ref": "#/$defs/nonnegative"},
        "criticalDiffs": {"$ref": "#/$defs/nonnegative"}, "routeIdentityCritical": {"$ref": "#/$defs/nonnegative"},
        "openRouteConflicts": {"$ref": "#/$defs/nonnegative"}, "unprocessedRows": {"$ref": "#/$defs/nonnegative"},
        "oldestUnprocessedSeconds": {"$ref": "#/$defs/nonnegative"},
        "journalLatencyMs": {
          "type": "object",
          "required": ["p50", "p95", "p99"],
          "properties": {
            "p50": {"$ref": "#/$defs/nonnegative"},
            "p95": {"$ref": "#/$defs/nonnegative"},
            "p99": {"$ref": "#/$defs/nonnegative"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
