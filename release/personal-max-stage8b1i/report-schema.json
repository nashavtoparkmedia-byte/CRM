{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-max-stage8b1i-isolated-release-proof.schema.json",
  "title": "Personal MAX Stage 8B1I bounded isolated release proof",
  "type": "object",
  "required": ["schemaVersion", "mode", "script", "safety"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"enum": ["ISOLATED_RELEASE_PROOF", "ISOLATED_RELEASE_PROOF_FAILURE", "ISOLATED_RELEASE_PROOF_EMERGENCY_FAILURE"]},
    "script": {
      "type": "object",
      "required": ["sha256", "checksumBound"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checksumBound": {"const": true}
      }
    },
    "safety": {
      "type": "object",
      "required": ["productionDDL", "productionDML", "productionMigration", "restart", "deploy", "browserLaunched", "maxContacted", "providerAction"],
      "properties": {
        "productionDDL": {"const": false},
        "productionDML": {"const": false},
        "productionMigration": {"const": false},
        "restart": {"const": false},
        "deploy": {"const": false},
        "browserLaunched": {"const": false},
        "maxContacted": {"const": false},
        "providerAction": {"const": false},
        "productionNetworkAttached": {"const": false},
        "productionVolumeMounted": {"const": false},
        "profileMounted": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "ISOLATED_RELEASE_PROOF"}}},
      "then": {
        "required": ["bindings", "postgresStartup", "restore", "migration", "images", "executable", "e2e", "cleanup", "productionImmutability", "storage"],
        "properties": {
          "bindings": {"type": "object", "required": ["backupReportSha256", "dumpSha256", "dumpBytes"]},
          "postgresStartup": {"type": "object", "required": ["status", "containerState", "containerExitCode", "healthStatus", "readinessAttempts", "readinessTransientCount", "readinessLastExit", "versionQueryAttempts", "versionTransientCount", "versionLastExit", "expectedVersionText", "expectedVersionNum", "observedVersionNum", "observedMajor", "observedMinor", "observedPatch", "versionClassification", "versionOutputCategory", "versionMatched", "elapsedSeconds", "rawLogsCaptured", "environmentValuesCaptured", "credentialsCaptured"]},
          "restore": {"type": "object", "required": ["FULL_RESTORE_PROOF", "objectCount", "ledgerFinished", "ledgerFailed", "ledgerNameCount", "ledgerUniqueCount", "ledgerDuplicateCount", "ledgerInvalidFormatCount", "ledgerUnsafeNameCount", "ledgerNamesSha256", "ledgerAttestationSha256", "ledgerNamingClassification", "acceptedHistoricalNames", "repositoryToLedgerCount", "ledgerToRepositoryCount", "catalogIntegrity"]},
          "migration": {
            "type": "object",
            "required": ["DISPOSABLE_MIGRATION_PROOF", "appliedNames", "beforeFinished", "afterFinished", "failed", "prismaDiffEmpty", "prismaDiffStatus", "acceptedLedgerOnlyMigrations", "postgresNetworkAlias"],
            "properties": {
              "prismaDiffEmpty": {"const": false},
              "prismaDiffStatus": {"const": "ACCEPTED_LEGACY_DRIVER_TELEGRAM_COLUMNS"},
              "acceptedLedgerOnlyMigrations": {"const": ["20260717000000_add_driver_telegram_submitted_phone"]},
              "postgresNetworkAlias": {
                "type": "object",
                "required": ["explicit", "databaseUrlHostBound", "observedNetworkCount", "expectedNetworkPresent", "aliasArrayPresent", "expectedAliasPresent", "unexpectedNetworkPresent", "containerRunning", "rawInspectCaptured", "databaseUrlCaptured", "credentialsCaptured"],
                "properties": {
                  "explicit": {"const": true},
                  "databaseUrlHostBound": {"const": true},
                  "observedNetworkCount": {"const": 1},
                  "expectedNetworkPresent": {"const": true},
                  "aliasArrayPresent": {"const": true},
                  "expectedAliasPresent": {"const": true},
                  "unexpectedNetworkPresent": {"const": false},
                  "containerRunning": {"const": true},
                  "rawInspectCaptured": {"const": false},
                  "databaseUrlCaptured": {"const": false},
                  "credentialsCaptured": {"const": false}
                }
              }
            }
          },
          "images": {"type": "object", "required": ["gateway", "scraper", "postgresql", "retained"]},
          "executable": {"type": "object", "required": ["dormant", "invalidConfigFailsClosed", "missingHmacFailsClosed", "authenticatedIngress", "authDenied", "requestSizeLimit"]},
          "e2e": {"type": "object", "required": ["actualHook", "frames", "identicalFrames", "captureLoss", "accidentalDuplicateRawRows", "wrongAccount", "criticalSemanticRegressions"]},
          "cleanup": {"type": "object", "required": ["containersRemaining", "networksRemaining", "volumesRemaining", "tempFilesRemaining"]},
          "productionImmutability": {
            "type": "object",
            "required": ["before", "after", "unchanged", "productionDatabaseConnections", "productionMigrationLedgerSource"],
            "properties": {
              "before": {
                "type": "object",
                "required": ["productionHead", "productionStatusV2RawSha256", "acceptedProductionGitBaseline"],
                "properties": {
                  "productionHead": {"const": "e6a0a833fbb756216b058bfe326f9f9c77c4cc6d"},
                  "productionStatusV2RawSha256": {"const": "2958f4cc4849e2248b73cff4d0aa779f33f0008d602bb5294326eb01ba44a60b"},
                  "acceptedProductionGitBaseline": {"const": true}
                }
              },
              "after": {
                "type": "object",
                "required": ["productionHead", "productionStatusV2RawSha256", "acceptedProductionGitBaseline"],
                "properties": {
                  "productionHead": {"const": "e6a0a833fbb756216b058bfe326f9f9c77c4cc6d"},
                  "productionStatusV2RawSha256": {"const": "2958f4cc4849e2248b73cff4d0aa779f33f0008d602bb5294326eb01ba44a60b"},
                  "acceptedProductionGitBaseline": {"const": true}
                }
              }
            }
          },
          "storage": {"type": "object", "required": ["freeBytesBeforePull", "freeBytesAfterPull", "freeBytesAfterCleanup", "postPullRequiredBytes", "finalRequiredBytes"]}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "ISOLATED_RELEASE_PROOF_FAILURE"}}},
      "then": {
        "required": ["phase", "safeCommandClass", "classification", "checkId", "exitCode", "postgresStartup", "migrationPreflight", "ledgerDiagnostics", "cleanup", "images", "storage", "diagnostics", "productionImmutability"],
        "properties": {
          "phase": {"type": "string"},
          "classification": {"type": "string", "description": "Privacy-safe output-contract or migration-preflight classification; raw commands, stderr, URLs, credentials, SQL, and business data are excluded."},
          "checkId": {
            "enum": [
              "NONE", "POSTGRES_CONTAINER_START_CHECK", "POSTGRES_READINESS_CHECK",
              "POSTGRES_SERVER_VERSION_QUERY_CHECK", "POSTGRES_SERVER_VERSION_MATCH_CHECK",
              "RESTORE_LEDGER_FINISHED_CHECK", "RESTORE_LEDGER_FAILED_CHECK",
              "RESTORE_LEDGER_NAMES_CHECK", "RESTORE_CATALOG_TABLES_CHECK",
              "RESTORE_CATALOG_INDEXES_CHECK", "RESTORE_CATALOG_CONSTRAINTS_CHECK",
              "RESTORE_REQUIRED_PRISMA_MIGRATIONS_RELATION_CHECK",
              "RESTORE_REQUIRED_USERS_RELATION_CHECK", "RESTORE_REQUIRED_CONTACT_RELATION_CHECK",
              "RESTORE_REQUIRED_CHAT_RELATION_CHECK", "RESTORE_REPRESENTATIVE_MIGRATIONS_CHECK",
              "RESTORE_REPRESENTATIVE_USER_CHECK", "RESTORE_REPRESENTATIVE_CONTACT_CHECK",
              "RESTORE_REPRESENTATIVE_CHAT_CHECK", "RESTORE_REPORT_RENDER_CHECK",
              "MIGRATION_DATABASE_URL_CONSTRUCTION_CHECK", "MIGRATION_INVENTORY_CHECK",
              "MIGRATION_PENDING_SET_CHECK", "MIGRATION_REPOSITORY_COUNT_CHECK",
              "MIGRATION_APPLIED_ONLY_CHECK", "MIGRATION_RUNTIME_BINDING_CHECK",
              "MIGRATION_SQL_RUNNER_CREATE_CHECK", "MIGRATION_SQL_RUNNER_IDENTITY_CHECK",
              "MIGRATION_SQL_RUNNER_START_CHECK", "MIGRATION_POSTGRES_ALIAS_CHECK",
              "MIGRATION_SHADOW_DATABASE_CREATE_CHECK", "MIGRATION_PRISMA_RUNNER_CREATE_CHECK",
              "MIGRATION_PRISMA_RUNNER_IDENTITY_CHECK", "MIGRATION_PRISMA_EXECUTABLE_CHECK",
              "MIGRATION_PRISMA_DEPLOY_CHECK", "MIGRATION_POST_LEDGER_CHECK",
              "MIGRATION_POST_SCHEMA_CHECK", "MIGRATION_PRISMA_DIFF_CHECK"
            ]
          },
          "exitCode": {"type": "integer", "minimum": 1},
          "postgresStartup": {
            "type": "object",
            "required": ["status", "lastOperation", "containerState", "containerExitCode", "healthStatus", "readinessAttempts", "readinessTransientCount", "readinessLastExit", "versionQueryAttempts", "versionTransientCount", "versionLastExit", "expectedVersionText", "expectedVersionNum", "observedVersionNum", "observedMajor", "observedMinor", "observedPatch", "versionClassification", "versionOutputCategory", "versionMatched", "elapsedSeconds", "rawLogsCaptured", "environmentValuesCaptured", "credentialsCaptured", "commandArgumentsCaptured"]
          },
          "migrationPreflight": {
            "type": "object",
            "required": ["checkId", "substep", "runnerRole", "commandCategory", "executableCategory", "commandStarted", "attemptCount", "elapsedSeconds", "originalExitCode", "containerStateCategory", "primaryClassification", "postgresNetworkAlias", "rawStderrCaptured", "rawCommandCaptured", "environmentValuesCaptured", "databaseUrlCaptured", "credentialsCaptured", "sqlCaptured", "businessDataCaptured"],
            "properties": {
              "checkId": {"oneOf": [{"const": "NONE"}, {"type": "string", "pattern": "^MIGRATION_[A-Z0-9_]+_CHECK$"}]},
              "substep": {"type": "string"},
              "runnerRole": {"enum": ["not_observed", "host_validator", "migration_inventory", "sql_gate", "postgres", "prisma_deploy", "prisma_diff"]},
              "commandCategory": {"enum": ["not_observed", "internal_validator", "filesystem_binding", "docker_create", "docker_start", "docker_inspect", "docker_exec", "prisma", "sql_gate"]},
              "executableCategory": {"enum": ["not_observed", "shell_builtin", "coreutils", "docker_cli", "posix_shell", "prisma_cli", "postgres_client"]},
              "commandStarted": {"type": "boolean"},
              "attemptCount": {"type": "integer", "minimum": 0},
              "elapsedSeconds": {"type": "integer", "minimum": 0},
              "originalExitCode": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"const": "not_observed"}]},
              "containerStateCategory": {"enum": ["not_observed", "command_not_started", "created", "running", "exited", "unavailable"]},
              "primaryClassification": {"type": "string", "pattern": "^(NONE|MIGRATION_[A-Z0-9_]+|PRISMA_DIFF_(TIMEOUT|FAILED))$"},
              "postgresNetworkAlias": {
                "type": "object",
                "required": ["factsObserved", "observedNetworkCount", "expectedNetworkPresent", "aliasArrayPresent", "expectedAliasPresent", "unexpectedNetworkPresent", "containerRunning", "databaseUrlHostBound", "validationClassification", "rawInspectCaptured", "databaseUrlCaptured", "credentialsCaptured"],
                "properties": {
                  "factsObserved": {"type": "boolean"},
                  "observedNetworkCount": {"type": "integer", "minimum": 0},
                  "expectedNetworkPresent": {"type": "boolean"},
                  "aliasArrayPresent": {"type": "boolean"},
                  "expectedAliasPresent": {"type": "boolean"},
                  "unexpectedNetworkPresent": {"type": "boolean"},
                  "containerRunning": {"type": "boolean"},
                  "databaseUrlHostBound": {"type": "boolean"},
                  "validationClassification": {"type": "string", "pattern": "^(NONE|MIGRATION_[A-Z0-9_]+)$"},
                  "rawInspectCaptured": {"const": false},
                  "databaseUrlCaptured": {"const": false},
                  "credentialsCaptured": {"const": false}
                }
              },
              "rawStderrCaptured": {"const": false},
              "rawCommandCaptured": {"const": false},
              "environmentValuesCaptured": {"const": false},
              "databaseUrlCaptured": {"const": false},
              "credentialsCaptured": {"const": false},
              "sqlCaptured": {"const": false},
              "businessDataCaptured": {"const": false}
            }
          },
          "ledgerDiagnostics": {
            "type": "object",
            "required": ["ledgerNameCount", "ledgerUniqueCount", "ledgerDuplicateCount", "ledgerEmptyNameCount", "ledgerInvalidFormatCount", "ledgerUnsafeNameCount", "ledgerNamesSha256", "ledgerAttestationSha256", "namingClassification", "invalidNamingCategories", "acceptedHistoricalNames", "repositoryToLedgerCount", "ledgerToRepositoryCount", "sqlCaptured", "queryResultsCaptured"]
          },
          "cleanup": {"type": "object", "required": ["completed", "errorClassification", "containersRemaining", "networksRemaining", "volumesRemaining", "tempFilesRemaining"]},
          "images": {"type": "object", "required": ["gateway", "scraper", "acceptedImagesRetained"]},
          "storage": {"type": "object", "required": ["freeBytesBeforePull", "freeBytesAfterPull", "freeBytesAfterCleanup", "postPullDeficitBytes", "finalDeficitBytes"]},
          "diagnostics": {"type": "object", "required": ["rawCommandCaptured", "rawSqlCaptured", "rawStderrCaptured", "credentialsCaptured"]},
          "productionImmutability": {"type": "object", "required": ["productionDatabaseConnections", "productionMigrationLedgerSource", "productionMutationAuthorized", "acceptedProductionHead", "acceptedProductionStatusV2RawSha256", "observedProductionHead", "observedProductionStatusV2RawSha256"]}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "ISOLATED_RELEASE_PROOF_EMERGENCY_FAILURE"}}},
      "then": {
        "required": ["phase", "classification", "checkId", "exitCode", "diagnostics"],
        "properties": {
          "phase": {"type": "string"},
          "classification": {"type": "string"},
          "checkId": {"type": "string"},
          "exitCode": {"type": "integer", "minimum": 1},
          "diagnostics": {"type": "object", "required": ["rawCommandCaptured", "rawSqlCaptured", "rawStderrCaptured", "credentialsCaptured"]}
        }
      }
    }
  ],
  "additionalProperties": true
}
