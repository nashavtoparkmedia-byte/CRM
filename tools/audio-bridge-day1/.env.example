# Bridge runtime configuration template. Copy to `.env` and fill in.
# The `.env` file itself is gitignored — only this template is tracked.
#
# Provider keys (OPENAI_API_KEY, YANDEX_API_KEY, YANDEX_FOLDER_ID) are
# NOT here. They live in the CRM admin DB and are fetched by the bridge
# at session-start time via /api/internal/ai-call-keys. Provisioning is
# done from the CRM UI, not from this file.

# ── Networking ───────────────────────────────────────────────────────

# Outbound proxy for OpenAI (RU geo-block workaround). Must match the
# Xray HTTP-inbound port. Without this, fetches to api.openai.com return
# 403. Leave unset on hosts where OpenAI is reachable directly.
HTTPS_PROXY=http://127.0.0.1:10809

# Shared secret with CRM internal keys endpoint. Must match
# gravity-mvp/.env BRIDGE_SHARED_TOKEN exactly. Loopback IP fallback in
# the CRM route doesn't work under Next.js 16 (NextRequest hides the
# TCP peer), so this token is the load-bearing auth between the two
# processes.
BRIDGE_SHARED_TOKEN=

# Where to find the CRM HTTP API (Next dev server).
CRM_BASE_URL=http://127.0.0.1:3002

# LAN IP that FreeSWITCH (in WSL) uses to reach the AudioBridge on
# Windows. mod_audio_fork inside WSL fails to open WS to 127.0.0.1 of
# the Windows host. Pin to your actual LAN IP. Update when your
# laptop changes networks.
BRIDGE_LAN_IP=192.168.0.102

# ── STT provider ─────────────────────────────────────────────────────

# Default empty → router auto-picks Yandex when its key is configured
# in the admin UI, falls back to Whisper otherwise. Explicit values:
#   yandex   — Yandex SpeechKit v3 streaming, native Russian (recommended)
#   whisper  — OpenAI Whisper batch, fallback. Worse on Russian: 2 mishears
#              and 2 silence-hallucinations on the live driver-qualification
#              scenario where Yandex got 6/6 turns clean. See CLAUDE.md
#              «STT / TTS provider matrix» for the comparison data.
AI_CALL_STT_PROVIDER=yandex

# Optional Yandex tuning. Defaults baked in: ru-RU language, `general`
# model, 8 kHz LINEAR16 mono input. The v3 streaming proto in the
# bundled SDK does NOT expose `speech_context` / phrase hints — there
# is no per-call vocabulary override available.
# YANDEX_STT_LANG=ru-RU
# YANDEX_STT_MODEL=general            # alt: general:rc, general:deprecated
# YANDEX_STT_ENDPOINT=stt.api.cloud.yandex.net:443

# ── TTS provider ─────────────────────────────────────────────────────

# Yandex TTS exists (yandex-tts.js) but isn't activated in prod yet —
# pending separate Russian-voice-quality work. Leaving on OpenAI.
AI_CALL_TTS_PROVIDER=openai

# OpenAI TTS model. `tts-1` cheaper/faster, `tts-1-hd` ~2x cost +1s
# latency but cleaner Russian phonemes (issue #23 history).
OPENAI_TTS_MODEL=tts-1-hd

# ── mod_audio_fork mix-type ──────────────────────────────────────────

# Default `mono` — only inbound (caller's) audio reaches STT, TTS
# physically can't leak into STT no matter the timing (closes issue
# #20). Override `mixed` falls back to the source-gate echo workaround
# in call-session.js onPcm() — kept as defense-in-depth.
# BRIDGE_FORK_MIX=mono

# ── Audio file path for FS playback ──────────────────────────────────

# tmpfs in WSL (RAM-backed) eliminates DrvFs syscall latency that
# manifested as RTP jitter / choppy bot voice (issue #23). Bridge
# writes via UNC; FS reads natively.
BRIDGE_AUDIO_DIR=\\wsl.localhost\Ubuntu-24.04\dev\shm\bridge-tts
BRIDGE_AUDIO_DIR_FS=/dev/shm/bridge-tts

# ── Diagnostics ──────────────────────────────────────────────────────

# Keep generated TTS WAVs on disk after playback (default: cleaned up
# 60 s after broadcast). Useful for issue #23 audio diagnostics —
# pair with scripts/analyze_local_wav.js or score_quality.py.
# BRIDGE_KEEP_TTS=1
