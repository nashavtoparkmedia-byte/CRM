{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@avito/db": ["_shared/db/src/index.ts"],
      "@avito/shared": ["_shared/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "_shared/**/*"]
}
