{
  "name": "avito-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Avito leads collector worker — встроен в CRM-монорепо. Подключается к CRM Postgres, читает/пишет в avito_* таблицы.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
