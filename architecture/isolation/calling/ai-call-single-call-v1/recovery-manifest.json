{
  "schema": "yoko.crm.ai-call-finalization-recovery.v1",
  "version": 1,
  "context": "calling",
  "aggregate": "Call",
  "event": "calling.AiCallFinalizationFollowUpRequested.v1",
  "event_contract": "gravity-mvp/src/contracts/calling/v1/ai-call-finalization-follow-up-requested-event.ts",
  "atomic_writer": "gravity-mvp/src/modules/calling/internal/ai-calls/ai-call-finalization-prisma-adapter.ts",
  "durable_projection": "gravity-mvp/prisma/schema.prisma:DomainOutboxEvent",
  "query_index": ["status", "availableAt", "createdAt"],
  "unique_identity": "eventId",
  "batch_limit": 25,
  "claim": "compare-and-set on id, status and attempts",
  "outer_attempts": 5,
  "stale_claim_ms": 300000,
  "poison_state": "dead_letter",
  "consumer": "gravity-mvp/src/modules/calling/public/v1/outbox-consumers.ts",
  "inner_claim": "Call row lock plus monotonic follow-up lease token",
  "inner_attempts": 3,
  "owner_command": "work-management.CreateIdempotentTaskCommand.v1",
  "terminal_failure": "Call.metadata.aiCallFinalizationV1.followUp.terminal_failure",
  "full_call_scan": false,
  "application_side_call_filter": false,
  "schema_migration_required": false,
  "reason_no_migration": "The already authorized outbox table provides the required unique identity, indexed bounded selection, compare-and-set claim, retry schedule and visible poison state."
}
