  "rejected_alternatives": [
    {
      "alternative": "One bounded context per current folder",
      "reason": "Would preserve accidental layout and leave provider mirrors, UI and raw data writes as false domains."
    },
    {
      "alternative": "One Messaging context containing every provider implementation",
      "reason": "Would hide provider lifecycle, credentials and protected runtime boundaries that need independent adapters."
    },
    {
      "alternative": "Immediate physical database split",
      "reason": "Not required for logical ownership and would create irreversible operational risk before contracts and compatibility adapters exist."
