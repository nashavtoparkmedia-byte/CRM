{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoko.local/schema/architecture/module-manifest.v1.json",
  "title": "YOKO CRM bounded-context module manifest v1",
  "type": "object",
  "required": [
    "schema", "version", "context", "responsibility", "technical_modules",
    "owned_data", "public_surface", "internal_surface", "allowed_dependencies",
    "forbidden_dependencies", "provider_relationships", "credential_relationships",
    "commands", "events", "foreign_write_migration_plans", "protected",
    "compatibility_strategy", "evidence"
  ],
  "properties": {
    "schema": {"const": "yoko.crm.module-manifest.v1"},
    "version": {"const": 1},
    "context": {"type": "object", "required": ["id", "name"]},
    "responsibility": {"type": "string", "minLength": 1},
    "technical_modules": {"type": "array", "minItems": 1, "uniqueItems": true},
    "owned_data": {"type": "array"},
    "public_surface": {"type": "array", "uniqueItems": true},
    "internal_surface": {"type": "array", "minItems": 1, "uniqueItems": true},
    "allowed_dependencies": {"type": "array", "uniqueItems": true},
    "forbidden_dependencies": {"type": "array", "minItems": 1, "uniqueItems": true},
    "provider_relationships": {"type": "array"},
    "credential_relationships": {"type": "object"},
    "commands": {"type": "array", "uniqueItems": true},
    "events": {"type": "array", "uniqueItems": true},
    "foreign_write_migration_plans": {"type": "array", "uniqueItems": true},
    "protected": {"type": "boolean"},
    "compatibility_strategy": {"type": "string", "minLength": 1},
    "evidence": {"type": "object"}
  },
  "additionalProperties": false
}
