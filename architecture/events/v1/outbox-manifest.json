{
  "schema": "yoko.crm.transactional-outbox-manifest.v2",
  "version": 2,
  "module_manifest_amendments": "architecture/events/v1/module-manifest-amendments.json",
  "infrastructure_state_owner": "platform_shell",
  "table": "domain_outbox_events",
  "flows": [
    {
      "id": "calling.recording-ready",
      "producer_context": "calling",
      "consumer_context": "calling",
      "event": "calling.RecordingReady.v1",
      "aggregate": "Call",
      "domain_state": "Call.recordingPath",
      "atomic_writer": "gravity-mvp/src/modules/calling/internal/recording-ready-prisma-adapter.ts",
      "public_facade": "gravity-mvp/src/modules/calling/public/v1/index.ts",
      "consumer": "gravity-mvp/src/modules/calling/public/v1/outbox-consumers.ts",
      "delivery_adapter": "BullMQ call-transcribe",
      "consumer_idempotency": "BullMQ jobId transcribe-${callId}",
      "correlation": {
        "correlation_id": "Call.id",
        "causation_id": "FreeSWITCH channel UUID"
      },
      "manifest_amendment": "architecture/events/v1/module-manifest-amendments.json"
    },
    {
      "id": "messaging.inbound-notification-intent",
      "producer_context": "messaging",
      "consumer_context": "messaging",
      "event": "messaging.InboundMessageNotificationRequested.v1",
      "aggregate": "Message",
      "domain_state": "Message (inbound, qualified by the Mobile Push product recency policy)",
      "atomic_writers": [
        "gravity-mvp/src/modules/messaging/public/v1/legacy-prisma-channel-message-adapter.ts",
        "gravity-mvp/src/modules/messaging/public/v1/legacy-prisma-external-message-adapter.ts",
        "gravity-mvp/src/modules/messaging/public/v1/legacy-prisma-receive-message-adapter.ts"
      ],
      "public_facade": "gravity-mvp/src/modules/messaging/public/v1/index.ts",
      "consumer": "gravity-mvp/src/modules/messaging/public/v1/mobile-push-outbox-consumers.ts",
      "delivery_adapter": "outbox fan-out to messaging.MobilePushDeliveryRequested.v1",
      "event_identity": "messaging.InboundMessageNotificationRequested.v1:${messageId}",
      "payload_fields": [
        "channel",
        "chatId",
        "messageId"
      ],
      "consumer_idempotency": "deterministic delivery eventId per messageId and registrationId, appended with createMany skipDuplicates",
      "correlation": {
        "correlation_id": "Message.id",
        "causation_id": null
      },
      "manifest_amendment": "architecture/isolation/messaging/mobile-push-v1/module-manifest-amendments.json",
      "enabled_by": "MOBILE_PUSH_ENABLED=true (off by default)",
      "production_active": false
    },
    {
      "id": "messaging.mobile-push-delivery",
      "producer_context": "messaging",
      "consumer_context": "messaging",
      "event": "messaging.MobilePushDeliveryRequested.v1",
      "aggregate": "Message",
      "domain_state": "MobileDeviceRegistration (identity_access), resolved at send time through its public capability",
      "atomic_writers": [
        "gravity-mvp/src/modules/messaging/internal/mobile-push/push-fan-out-prisma-adapter.ts"
      ],
      "public_facade": "gravity-mvp/src/modules/messaging/public/v1/index.ts",
      "consumer": "gravity-mvp/src/modules/messaging/public/v1/mobile-push-outbox-consumers.ts",
      "delivery_adapter": "FCM HTTP v1 through the Messaging-internal mobile-push transport",
      "event_identity": "messaging.MobilePushDeliveryRequested.v1:${messageId}:${registrationId}",
      "payload_fields": [
        "channel",
        "chatId",
        "messageId",
        "registrationId",
        "sessionBindingId"
      ],
      "consumer_idempotency": "send-time resolution against the snapshotted sessionBindingId; the provider token is never carried in the event",
      "correlation": {
        "correlation_id": "Message.id",
        "causation_id": "messaging.InboundMessageNotificationRequested.v1 eventId"
      },
      "manifest_amendment": "architecture/isolation/messaging/mobile-push-v1/module-manifest-amendments.json",
      "enabled_by": "MOBILE_PUSH_ENABLED=true (off by default)",
      "production_active": false
    }
  ],
  "externally_governed_flows": [
    {
      "event": "calling.AiCallFinalizationFollowUpRequested.v1",
      "authority": "architecture/isolation/calling/ai-call-single-call-v1/recovery-manifest.json",
      "note": "Governed by its own YOKO-AI-CALLS-STAGE-5 recovery authority and outbox-policy assertions; listed here for reference only, not redeclared."
    }
  ],
  "reliability": {
    "event_identity": "unique deterministic eventId",
    "transactional_append": true,
    "claim": "compare-and-set on id, status and attempts",
    "batch_limit": 25,
    "publish_timeout_ms": 5000,
    "max_attempts": 5,
    "retry_delays_ms": [
      5000,
      30000,
      120000,
      600000,
      1800000
    ],
    "stale_claim_ms": 300000,
    "poison_state": "dead_letter",
    "last_error_max_chars": 1000,
    "last_error_secret_redaction": true,
    "publisher_idempotency": "published status plus atomic claim"
  },
  "versioning": {
    "event_type_contains_major": true,
    "event_version_column": 1,
    "unsupported_payload": "fail_closed_and_retry_then_dead_letter"
  },
  "credentials_in_contract": false,
  "production_active": false
}
