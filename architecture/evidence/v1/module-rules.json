{
  "schema": "yoko.crm.module-rules.v1",
  "source_roots": [
    "gravity-mvp/src",
    "gravity-mvp/prisma",
    "tg-bot/src",
    "tg-bot/prisma",
    "tg-bot/tg-bot-frontend",
    "max-web-scraper",
    "yandex-fleet-scraper/src",
    "yandex-fleet-scraper/prisma",
    "avito-worker/src",
    "tools/audio-bridge-day1",
    "telephony",
    "deploy/nginx"
  ],
  "exclude_segments": ["node_modules", ".next", "dist", "build", "coverage", ".artifacts"],
  "modules": [
    {"id":"gravity_core","context":"core","match":"^gravity-mvp/src/app/api/(?:contacts/(?:start-conversation/route\\.ts|\\[id\\]/(?:chats|driver-person|parks)/route\\.ts)|monitoring/fleet-check/driver-person/route\\.ts)$"},
    {"id":"nginx","context":"edge","match":"^deploy/nginx/"},
    {"id":"telephony_config","context":"telephony","match":"^telephony/"},
    {"id":"audio_bridge","context":"calls","match":"^tools/audio-bridge-day1/"},
    {"id":"avito_worker","context":"avito","match":"^avito-worker/src/"},
    {"id":"yfs","context":"yandex_fleet","match":"^yandex-fleet-scraper/(src|prisma)/"},
    {"id":"max_scraper","context":"max","match":"^max-web-scraper/"},
    {"id":"telegram_frontend","context":"telegram","match":"^tg-bot/tg-bot-frontend/"},
    {"id":"telegram_bot","context":"telegram","match":"^tg-bot/(src|prisma)/"},
    {"id":"whatsapp_provider","context":"messages","match":"^gravity-mvp/src/(lib/whatsapp/|app/api/(webhook/whatsapp|whatsapp)/|app/settings/integrations/whatsapp/)"},
    {"id":"telegram_provider","context":"messages","match":"^gravity-mvp/src/(lib/telegram/|app/tg-|app/api/(webhook/telegram|tg-media)/|app/settings/integrations/telegram/)"},
    {"id":"max_provider","context":"messages","match":"^gravity-mvp/src/(lib/providers/max-personal/|app/max-actions|app/api/(webhook/max|webhooks/max|max-scraper)/|app/settings/integrations/max/)"},
    {"id":"avito","context":"avito","match":"^gravity-mvp/src/(lib/avito/|app/api/(avito|webhooks/avito)/|app/settings/(avito-access|integrations/avito)/)"},
    {"id":"yandex_fleet","context":"yandex_fleet","match":"^gravity-mvp/src/(lib/(YandexFleetService|yandexSync)|app/api/(monitoring/fleet-check|monitoring/sync|drivers-search|test-car|test-driver)/)"},
    {"id":"ai_knowledge","context":"ai","match":"^gravity-mvp/src/(lib/ai/knowledge/|app/settings/integrations/ai-knowledge-help/)"},
    {"id":"ai_calls","context":"calls","match":"^gravity-mvp/src/(lib/(ai-call|aiCallAnalysis)/|app/api/ai-calls/|app/settings/integrations/(ai-call-help|ai-call-keys|ai-call-scenarios|telephony-ai)/|app/api/(internal/ai-call-keys|settings/ai-call|settings/telephony-ai)/)"},
    {"id":"calls","context":"calls","match":"^gravity-mvp/src/(lib/(calls|freeswitch|sip|queue)/|app/(calls|api/calls)/)"},
    {"id":"contacts","context":"contacts","match":"^gravity-mvp/src/(lib/(contacts/|ContactService|ContactMergeService|ReachabilityService)|app/api/contacts/)"},
    {"id":"messages","context":"messages","match":"^gravity-mvp/src/(lib/(MessageService|ConversationWorkflowService|TransportRegistry|communications|message)|app/(messages|inbox|communications|api/(messages|chats|channels|attachments|groups))/)"},
    {"id":"tasks","context":"tasks","match":"^gravity-mvp/src/(lib/(tasks/|OperationalJobs|triggers)|app/(tasks|my-day|api/tasks)/)"},
    {"id":"drivers","context":"drivers","match":"^gravity-mvp/src/(lib/(DriverMatchService|scoring)|app/(drivers|control|api/monitoring/drivers|api/drivers-search)/)"},
    {"id":"leads","context":"leads","match":"^gravity-mvp/src/(lib/leads/|app/(leads|api/leads)/)"},
    {"id":"monitoring","context":"operations","match":"^gravity-mvp/src/(lib/(IntegrityChecker|RetentionCleanup|health|failure-detection|perf-monitor|opsLog|cron-health|stability-check|runtime-guardrails|execution-lock)|app/(monitoring|api/monitoring|api/health|api/admin|api/cron|api/debug-db|logs)/)"},
    {"id":"analytics","context":"analytics","match":"^gravity-mvp/src/app/(analytics|dashboard|team-overview|promotions)/"},
    {"id":"settings","context":"settings","match":"^gravity-mvp/src/(lib/(dictionaries|config-validator)|app/(settings|api/settings|resources)/)"},
    {"id":"users","context":"identity","match":"^gravity-mvp/src/(lib/users/|app/(users|login)/)"},
    {"id":"gravity_ui","context":"shell","match":"^gravity-mvp/src/(components|hooks|store|providers)/"},
    {"id":"gravity_core","context":"core","match":"^gravity-mvp/(src|prisma)/"}
  ],
  "legacy_path_patterns": ["/legacy", "/debug-db/", ".bak"],
  "test_path_patterns": ["/__tests__/", "/test/", "/tests/", ".test.", ".spec."],
  "provider_patterns": {
    "telegram": ["telegram", "gramjs", "TG_", "TELEGRAM_"],
    "max": ["max.ru", "MAX_", "max-personal", "max-scraper", "/max"],
    "whatsapp": ["whatsapp", "baileys", "WA_", "WHATSAPP_"],
    "yandex_fleet": ["yandex", "YF_", "YFS_", "yandex-fleet"],
    "avito": ["avito", "AVITO_"],
    "freeswitch": ["freeswitch", "ESL_", "SIP_"],
    "openai": ["openai", "OPENAI_"],
    "anthropic": ["anthropic", "ANTHROPIC_"],
    "aws_s3": ["@aws-sdk", "S3_", "AWS_"]
  }
}
