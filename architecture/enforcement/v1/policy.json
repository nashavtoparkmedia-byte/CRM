    "architecture/isolation/fleet-operations/api-log-v1/module-manifest-amendments.json",
    "architecture/isolation/ai-knowledge/knowledge-source-v1/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/driver-import-v1/module-manifest-amendments.json",
    "architecture/isolation/ai-knowledge/item-review-v1/module-manifest-amendments.json",
