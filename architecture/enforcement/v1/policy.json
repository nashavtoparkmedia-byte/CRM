{
  "schema": "yoko.crm.architecture-policy.v1",
  "version": 1,
  "source_roots": [
    "gravity-mvp/src",
    "tg-bot/src",
    "tg-bot/tg-bot-frontend",
    "max-web-scraper",
    "yandex-fleet-scraper/src",
    "avito-worker/src",
    "tools/audio-bridge-day1"
  ],
  "exclude_segments": ["node_modules", ".next", "dist", "build", "coverage", ".artifacts"],
  "test_path_patterns": ["/__tests__/", "/test/", "/tests/", ".test.", ".spec."],
  "shared_infrastructure_targets": [
    "gravity-mvp/src/infrastructure/",
    "gravity-mvp/src/lib/prisma.ts"
  ],
  "sensitive_environment_pattern": "(TOKEN|KEY|SECRET|PASSWORD|PASSWD|CREDENTIAL|SESSION|COOKIE|DATABASE_URL|DSN|AUTH|SIP_)",
  "provider_transport_packages": {
    "telegram": ["^telegram(?:/|$)"],
    "whatsapp": ["^whatsapp-web\\.js$", "^@whiskeysockets/baileys(?:/|$)"],
    "max": ["^@maxhub/", "^max-bot-api"],
    "freeswitch": ["^modesl$"],
    "openai": ["^openai$"],
    "anthropic": ["^@anthropic-ai/sdk$"],
    "aws_s3": ["^@aws-sdk/"],
    "bullmq": ["^bullmq$", "^ioredis$"]
  },
  "provider_aliases": {
    "whatsapp-web.js": "whatsapp",
    "aws_s3": "aws_s3"
  },
  "provider_allowed_context_overrides": {
    "bullmq": ["calling"]
  },
  "approved_infrastructure_writers": [
    {
      "model": "DomainOutboxEvent",
      "file": "gravity-mvp/src/modules/calling/internal/recording-ready-prisma-adapter.ts",
      "reason": "same transaction as Calling aggregate write; declared by CRM-ARCH-005 outbox manifest"
    }
  ],
  "manifest_amendments": [
    "architecture/events/v1/module-manifest-amendments.json",
    "architecture/isolation/identity-access/v1/module-manifest-amendments.json",
    "architecture/isolation/contacts/telegram-channel-name-v2/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/driver-attention-v1/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/scoring-thresholds-v1/module-manifest-amendments.json",
    "architecture/isolation/contacts/manual-link-display-name-v1/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/daily-activity-v1/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/inbox-public-v1/module-manifest-amendments.json",
    "architecture/isolation/messaging/bot-chat-state-v1/module-manifest-amendments.json",
    "architecture/isolation/messaging/max-attachments-v2/module-manifest-amendments.json",
    "architecture/isolation/fleet-operations/clear-check-status-v1/module-manifest-amendments.json",
    "architecture/isolation/ai-knowledge/usage-log-v1/module-manifest-amendments.json",
    "architecture/isolation/ai-knowledge/decision-log-v1/module-manifest-amendments.json",
    "architecture/isolation/ai-knowledge/decision-review-v1/module-manifest-amendments.json",
