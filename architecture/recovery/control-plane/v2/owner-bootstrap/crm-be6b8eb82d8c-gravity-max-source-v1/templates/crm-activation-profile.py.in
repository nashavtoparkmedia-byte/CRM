#!/usr/bin/python3 -I
"""Exact zero-argument coordinated Gravity + MAX activation profile."""
from __future__ import annotations

import fcntl
import hashlib
import hmac
import json
import os
import re
import stat
import subprocess
import time
from contextlib import contextmanager
from pathlib import Path
from types import MappingProxyType
from typing import Any, Iterator, Mapping


PROFILE_ID = "crm-be6b8eb82d8c-gravity-max-source-v1"
PROFILE_DIR = f"/usr/local/share/yoko-privileged-runtime/profiles/{PROFILE_ID}"
PROFILE_PATH = PROFILE_DIR + "/profile.v1.json"
SEALED_INPUTS_PATH = PROFILE_DIR + "/sealed-inputs.v1.json"
STATE_DIR = f"/var/lib/yoko-privileged-runtime/profiles/{PROFILE_ID}"
STATE_PATH = STATE_DIR + "/state.v1.json"
LOCK_PATH = STATE_DIR + "/operation.lock"
ACTIVATE_OVERLAY = STATE_DIR + "/activate.compose.yml"
ROLLBACK_OVERLAY = STATE_DIR + "/rollback.compose.yml"
ACTIVATE_COMPOSE_LOG = STATE_DIR + "/activate.compose.log"
ROLLBACK_COMPOSE_LOG = STATE_DIR + "/rollback.compose.log"
COMPOSE_LOG_MAXIMUM = 4 * 1024 * 1024
DOCKER = "/usr/bin/docker"
SHA256 = re.compile(r"[0-9a-f]{64}")
IMAGE_ID = re.compile(r"sha256:[0-9a-f]{64}")
DB_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_$]{0,62}")
PROFILE_SCHEMA = "yoko.crm.coordinated-pair-activation-profile.v1"
STATE_SCHEMA = "yoko.crm.coordinated-pair-state.v1"
RECEIPT_SCHEMA = "yoko.crm.coordinated-artifact-admission.v1"
TARGET_GRAVITY = "yoko/crm-gravity-mvp:be6b8eb82d8c-0f1a213b2b1f0a8e322fd597aa4575829c6e26fc-coordinated-v1"
TARGET_MAX = "yoko/crm-max-scraper:be6b8eb82d8c-0f1a213b2b1f0a8e322fd597aa4575829c6e26fc-coordinated-v1"
ROLLBACK_GRAVITY = "yoko/crm-gravity-mvp:rollback-5531c67e99b572356f897246b8c845ab4f9b232d"
ROLLBACK_MAX = "yoko/crm-max-scraper:rollback-87835969ed6335a99d50e1cc2eaf70aa33fdbaf9"

# The one environment variable name this release is allowed to add, and the only two services it
# may be added to. Everything here is a sealed constant: nothing is read from runtime input, there
# is no list to extend, and every other environment difference still fails closed.
#
# The value never enters the shared production env file. Activation attaches one fixed root-only
# source per service through the generated overlay, so no other Compose service can receive it.
# Rollback never reads these sources and never attaches them, so the predecessor images -- which
# do not reference this variable -- are recreated with exactly their original environment.
RELEASE_ENVIRONMENT_NAME = "MAX_SCRAPER_WEBHOOK_SECRET"
RELEASE_ENVIRONMENT_DIRECTORY = "/var/lib/crm/release-staging/messaging-be6b8eb8"
RELEASE_ENVIRONMENT_SOURCES: Mapping[str, str] = MappingProxyType({
    "gravity-mvp": RELEASE_ENVIRONMENT_DIRECTORY + "/gravity-mvp.env",
    "max-web-scraper": RELEASE_ENVIRONMENT_DIRECTORY + "/max-web-scraper.env",
})
RELEASE_ENVIRONMENT_VALUE = re.compile(rb"[0-9a-f]{64}")
RELEASE_ENVIRONMENT_SOURCE_MAXIMUM = 256
RELEASE_ENVIRONMENT_CONTRACT = MappingProxyType({
    "name": RELEASE_ENVIRONMENT_NAME,
    "sources": dict(RELEASE_ENVIRONMENT_SOURCES),
    "source_mode": "0600",
    "value_format": "lowercase-hex-64",
    "identical_across_services": True,
    "attached_by": "release-activate",
    "attached_on_rollback": False,
})

# Calling B2: the closed set of environment names the controlled real AI call reads, admitted for
# gravity-mvp only. Like the Messaging name above, every part of it is a sealed constant: no name,
# service or path is read from runtime input, and widening the set needs a new Owner/Calling
# decision and a new sealed profile.
#
# Every name is mandatory, because the application's controlled-call readiness fails closed on each
# of them and its runbook requires every value to be supplied explicitly. The two kill switches are
# admitted only as the exact strings `true` or `false`: the application arms on exactly `true`, and
# the repository example disarms with `false`, so no ambiguous spelling can reach a container.
#
# Activation attaches one fixed root-only source to gravity-mvp through the generated overlay; the
# shared production env file is never involved. Rollback never reads or attaches the source, and is
# refused while the live Gravity container has either kill switch armed.
CALLING_B2_SERVICE = "gravity-mvp"
CALLING_B2_ENVIRONMENT_NAMES = (
    "AI_CALL_CONTROLLED_DESTINATION_E164",
    "AI_CALL_CONTROLLED_OPERATOR_TOKEN",
    "AI_CALL_CONTROLLED_REAL_CALL_ENABLED",
    "AI_CALL_CONTROLLED_REQUEST_ID",
    "AI_CALL_DIAL_STRING_TEMPLATE",
    "AI_CALL_LIVE_MODE",
    "AI_CALL_PARK_EXT",
    "AI_CALL_STT_PROVIDER",
    "AI_CALL_TELEPHONY_PROVIDER",
    "AI_CALL_TTS_PROVIDER",
    "AUDIO_BRIDGE_HEALTH_URL",
    "MEGAFON_NUMBER",
)
CALLING_B2_KILL_SWITCHES = ("AI_CALL_CONTROLLED_REAL_CALL_ENABLED", "AI_CALL_LIVE_MODE")
CALLING_B2_KILL_SWITCH_VALUES = ("false", "true")
CALLING_B2_DISARMED_VALUE = "false"
# The release id is the sealed profile id, so the source path moves with the exact application binding.
CALLING_B2_ENVIRONMENT_DIRECTORY = "/var/lib/crm/release-staging/calling-b2/" + PROFILE_ID
CALLING_B2_ENVIRONMENT_SOURCE = CALLING_B2_ENVIRONMENT_DIRECTORY + "/gravity-mvp.env"
CALLING_B2_ENVIRONMENT_SOURCE_MAXIMUM = 4096
# Exactly one `NAME='value'` assignment per line. Compose reads a single-quoted env_file value
# literally -- no interpolation, comment or whitespace handling -- so the `${number}` in the dial
# template arrives intact. Values are 1-256 bytes of printable ASCII without whitespace, quotes,
# backslash or backtick, so nothing inside the quotes can change how Compose splits the line.
CALLING_B2_ENVIRONMENT_LINE = re.compile(rb"([A-Z][A-Z0-9_]{0,127})='([!#-&(-\[\]-_a-~]{1,256})'")
CALLING_B2_ENVIRONMENT_CONTRACT = MappingProxyType({
    "names": list(CALLING_B2_ENVIRONMENT_NAMES),
    "services": [CALLING_B2_SERVICE],
    "source": CALLING_B2_ENVIRONMENT_SOURCE,
    "source_mode": "0600",
    "source_format": "single-quoted-assignment-per-line",
    "all_names_required": True,
    "kill_switches": list(CALLING_B2_KILL_SWITCHES),
    "kill_switch_values": list(CALLING_B2_KILL_SWITCH_VALUES),
    "attached_by": "release-activate",
    "attached_on_rollback": False,
    "rollback_requires_disarmed_kill_switches": True,
})


def _canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")


def _digest(value: Any) -> str:
    return hashlib.sha256(_canonical(value)).hexdigest()


def _sha_file(path: Path, maximum: int) -> str:
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    output = hashlib.sha256()
    total = 0
    try:
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > maximum:
                raise RuntimeError("FILE_TOO_LARGE")
            output.update(chunk)
    finally:
        os.close(fd)
    return output.hexdigest()


def _write_all(fd: int, raw: bytes) -> None:
    remaining = memoryview(raw)
    while remaining:
        written = os.write(fd, remaining)
        if written <= 0:
            raise OSError("short write")
        remaining = remaining[written:]


def _exact_dict(core: Any, value: Any, keys: set[str], code: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise core.RuntimeFault(code, 78)
    return value


def _load_profile(core: Any) -> dict[str, Any]:
    descriptor = core.secure_file(PROFILE_PATH, 0o444, maximum=2 * 1024 * 1024)
    profile = core.parse_json(core.mapped(PROFILE_PATH).read_bytes(), maximum=descriptor.st_size + 1)
    required = {
        "schema", "profile_id", "host", "runtime_abi", "package_version",
        "accepted_application", "stage_a", "artifact_admission", "deployment",
        "predecessor", "target", "database", "limits", "release_environment", "calling_b2_environment",
        "enabled_zero_argument_profiles", "disabled_profiles", "negative_properties",
    }
    _exact_dict(core, profile, required, "ACTIVATION_PROFILE_INVALID")
    if (
        profile["schema"] != PROFILE_SCHEMA
        or profile["profile_id"] != PROFILE_ID
        or profile["host"] != "jvxthcorvm"
        or profile["runtime_abi"] != "2.0.0"
        or profile["package_version"] != "2.0.0-17"
        or profile["accepted_application"] != {
            "commit": "be6b8eb82d8c074e82a3be0cd53db26137e984be",
            "tree": "8fc34b11684318dc2278f210154447229305f16d",
            "gravity_subtree": "03175f4baad1563ecf57bbebb9254df12863f07b",
            "max_subtree": "4c4bc48aa465919324b8d661d1572d7d839d4da1",
        }
        or profile["enabled_zero_argument_profiles"] != [
            "database-status", "release-preflight", "release-activate", "rollback"
        ]
        or set(profile["disabled_profiles"]) != {"config-activate", "database-migrate"}
        or any(profile["negative_properties"].values())
        or profile["release_environment"] != dict(RELEASE_ENVIRONMENT_CONTRACT)
        or profile["calling_b2_environment"] != dict(CALLING_B2_ENVIRONMENT_CONTRACT)
    ):
        raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    stage_a = _exact_dict(
        core, profile["stage_a"],
        {"builder_commit", "builder_tree", "run_id", "artifact_id", "artifact_name", "artifact_digest", "artifact_bytes"},
        "ACTIVATION_PROFILE_INVALID",
    )
    if stage_a != {
        "builder_commit": "0f1a213b2b1f0a8e322fd597aa4575829c6e26fc",
        "builder_tree": "027b963c59985d3ae7a587ab4a7420bd6fb81c68",
        "run_id": 35135070179,
        "artifact_id": 10462154988,
        "artifact_name": "coordinated-gravity-max-be6b8eb82d8c-0f1a213b2b1f0a8e322fd597aa4575829c6e26fc",
        "artifact_digest": "sha256:072c55e07acf493eb82938f285157ea098728327ffe4a5911c8c095dcc3a37dd",
        "artifact_bytes": 4805820790,
    }:
        raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    deployment = _exact_dict(
        core, profile["deployment"],
        {"compose_path", "environment_path", "project", "project_directory", "gravity_service", "max_service", "gravity_resource", "max_resource", "postgres_container"},
        "ACTIVATION_PROFILE_INVALID",
    )
    if deployment != {
        "compose_path": "/opt/crm/deploy/docker-compose.production.yml",
        "environment_path": "/opt/crm/.env.production",
        "project": "crm",
        "project_directory": "/opt/crm/deploy",
        "gravity_service": "gravity-mvp",
        "max_service": "max-web-scraper",
        "gravity_resource": "crm.container.gravity_mvp",
        "max_resource": "crm.container.max_scraper",
        "postgres_container": "crm-postgres",
    }:
        raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    for section in ("predecessor", "target", "database", "limits", "artifact_admission"):
        if not isinstance(profile[section], dict):
            raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    if profile["target"].get("gravity", {}).get("reference") != TARGET_GRAVITY or profile["target"].get("max_scraper", {}).get("reference") != TARGET_MAX:
        raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    if profile["predecessor"].get("gravity", {}).get("rollback_reference") != ROLLBACK_GRAVITY or profile["predecessor"].get("max_scraper", {}).get("rollback_reference") != ROLLBACK_MAX:
        raise core.RuntimeFault("ACTIVATION_PROFILE_INVALID", 78)
    return profile


def _ensure_roots(core: Any) -> None:
    core.secure_directory("/var/lib/yoko-privileged-runtime", 0o700, create=True)
    core.secure_directory("/var/lib/yoko-privileged-runtime/profiles", 0o700, create=True)
    core.secure_directory(STATE_DIR, 0o700, create=True)


@contextmanager
def _lock(core: Any) -> Iterator[None]:
    _ensure_roots(core)
    path = core.mapped(LOCK_PATH)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _read_state(core: Any) -> dict[str, Any]:
    _ensure_roots(core)
    path = core.mapped(STATE_PATH)
    if not path.exists():
        return {"schema": STATE_SCHEMA, "profile_id": PROFILE_ID, "phase": "UNINITIALIZED"}
    descriptor = core.secure_file(STATE_PATH, 0o600, maximum=4 * 1024 * 1024)
    state = core.parse_json(path.read_bytes(), maximum=descriptor.st_size + 1)
    if not isinstance(state, dict) or state.get("schema") != STATE_SCHEMA or state.get("profile_id") != PROFILE_ID or not isinstance(state.get("phase"), str):
        raise core.RuntimeFault("ACTIVATION_STATE_INVALID", 78)
    return state


def _write_state(core: Any, value: dict[str, Any]) -> None:
    if value.get("schema") != STATE_SCHEMA or value.get("profile_id") != PROFILE_ID:
        raise core.RuntimeFault("ACTIVATION_STATE_INVALID", 78)
    raw = _canonical(value) + b"\n"
    if len(raw) > 4 * 1024 * 1024:
        raise core.RuntimeFault("ACTIVATION_STATE_INVALID", 78)
    target = core.mapped(STATE_PATH)
    temporary = core.mapped(STATE_PATH + ".new")
    temporary.unlink(missing_ok=True)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        _write_all(fd, raw)
        os.fchmod(fd, 0o600)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, target)
    directory = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def _audit(core: Any, invocation: Any, before: dict[str, Any], result: str, after: dict[str, Any]) -> None:
    core.append_audit(invocation, core.request_digest(invocation), _digest(before), result, _digest(after))


def _write_fixed_file(core: Any, path: str, raw: bytes, mode: int) -> None:
    target = core.mapped(path)
    temporary = core.mapped(path + ".new")
    temporary.unlink(missing_ok=True)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
    try:
        _write_all(fd, raw)
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, target)


def _run(
    core: Any,
    args: list[str],
    *,
    timeout: int,
    code: str,
    stdin_fd: int | None = None,
    stdout_fd: int | None = None,
    stderr_fd: int | None = None,
    pass_fds: tuple[int, ...] = (),
) -> subprocess.CompletedProcess[bytes]:
    if not args or args[0] not in {DOCKER}:
        raise core.RuntimeFault("INTERNAL_EXECUTABLE_INVALID", 78)
    executable = str(core.mapped(args[0]))
    try:
        completed = subprocess.run(
            [executable, *args[1:]],
            stdin=stdin_fd if stdin_fd is not None else subprocess.DEVNULL,
            stdout=stdout_fd if stdout_fd is not None else subprocess.PIPE,
            stderr=stderr_fd if stderr_fd is not None else subprocess.PIPE,
            env=core.command_env(),
            cwd=str(core.mapped("/")),
            timeout=timeout,
            check=False,
            pass_fds=pass_fds,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        raise core.RuntimeFault(code, 74) from exc
    if completed.returncode != 0:
        raise core.RuntimeFault(code, 74)
    return completed


def _docker_json(core: Any, args: list[str], code: str) -> Any:
    completed = _run(core, [DOCKER, *args], timeout=60, code=code)
    try:
        return json.loads(completed.stdout)
    except (UnicodeError, ValueError) as exc:
        raise core.RuntimeFault(code, 74) from exc


def _image_inspect(core: Any, reference: str, *, required: bool = True) -> dict[str, Any] | None:
    try:
        value = _docker_json(core, ["image", "inspect", reference], "IMAGE_INSPECT_FAILED")
    except Exception as exc:
        if not required and isinstance(exc, core.RuntimeFault) and exc.code == "IMAGE_INSPECT_FAILED":
            return None
        raise
    if not isinstance(value, list) or len(value) != 1 or not isinstance(value[0], dict):
        raise core.RuntimeFault("IMAGE_INSPECT_INVALID", 74)
    return value[0]


def _artifact_receipt(core: Any, profile: dict[str, Any]) -> dict[str, Any]:
    admission = profile["artifact_admission"]
    path = str(admission.get("receipt_path", ""))
    expected = str(admission.get("receipt_sha256", ""))
    if not path.startswith("/var/lib/yoko-privileged-runtime/coordinated-artifacts/") or not SHA256.fullmatch(expected):
        raise core.RuntimeFault("ARTIFACT_RECEIPT_PROFILE_INVALID", 78)
    descriptor = core.secure_file(path, 0o400, maximum=2 * 1024 * 1024)
    target = core.mapped(path)
    if _sha_file(target, 2 * 1024 * 1024) != expected:
        raise core.RuntimeFault("ARTIFACT_RECEIPT_IDENTITY_MISMATCH", 78)
    receipt = core.parse_json(target.read_bytes(), maximum=descriptor.st_size + 1)
    if (
        not isinstance(receipt, dict)
        or receipt.get("schema") != RECEIPT_SCHEMA
        or receipt.get("profile_id") != PROFILE_ID
        or receipt.get("application_commit") != profile["accepted_application"]["commit"]
        or receipt.get("stage_a_artifact_id") != profile["stage_a"]["artifact_id"]
        or receipt.get("production_mutated") is not False
        or receipt.get("files") != admission.get("files")
    ):
        raise core.RuntimeFault("ARTIFACT_RECEIPT_INVALID", 78)
    return receipt


def _artifact_path(core: Any, profile: dict[str, Any], name: str, *, hash_content: bool) -> Path:
    files = profile["artifact_admission"].get("files")
    record = files.get(name) if isinstance(files, dict) else None
    if not isinstance(record, dict) or set(record) != {"path", "sha256", "bytes"}:
        raise core.RuntimeFault("ARTIFACT_PROFILE_INVALID", 78)
    path = record["path"]
    digest = record["sha256"]
    size = record["bytes"]
    if (
        not isinstance(path, str)
        or not path.startswith("/var/lib/yoko-privileged-runtime/coordinated-artifacts/")
        or not isinstance(digest, str)
        or not SHA256.fullmatch(digest)
        or isinstance(size, bool)
        or not isinstance(size, int)
        or not 0 <= size <= 4 * 1024 * 1024 * 1024
    ):
        raise core.RuntimeFault("ARTIFACT_PROFILE_INVALID", 78)
    descriptor = core.secure_file(path, 0o400, maximum=max(1, size))
    if descriptor.st_size != size:
        raise core.RuntimeFault("ARTIFACT_SIZE_MISMATCH", 78)
    target = core.mapped(path)
    if hash_content and _sha_file(target, max(1, size)) != digest:
        raise core.RuntimeFault("ARTIFACT_IDENTITY_MISMATCH", 78)
    return target


def _validate_target_image(core: Any, record: dict[str, Any], reference: str, component: str) -> dict[str, Any]:
    image = _image_inspect(core, reference)
    config = image.get("Config") if isinstance(image, dict) else None
    labels = config.get("Labels") if isinstance(config, dict) else None
    if (
        image.get("Id") != _sealed_image_identity(core, image, record, component)
        or image.get("Os") != "linux"
        or image.get("Architecture") != "amd64"
        or not isinstance(labels, dict)
        or labels.get("org.opencontainers.image.revision") != "be6b8eb82d8c074e82a3be0cd53db26137e984be"
        or labels.get("yoko.activation.profile") != PROFILE_ID
    ):
        raise core.RuntimeFault(f"{component.upper()}_TARGET_IMAGE_IDENTITY_MISMATCH", 74)
    if component == "gravity":
        expected = {
            "User": "app", "WorkingDir": "/app", "Entrypoint": ["/usr/bin/tini", "--"],
            "Cmd": ["sh", "-c", "npx prisma migrate deploy && npm run start"],
        }
    else:
        expected = {
            "User": "pwuser", "WorkingDir": "/app", "Entrypoint": ["/usr/bin/tini", "--"],
            "Cmd": ["node", "index.js"],
        }
    if any(config.get(key) != value for key, value in expected.items()):
        raise core.RuntimeFault(f"{component.upper()}_TARGET_RUNTIME_CONTRACT_MISMATCH", 74)
    return image


def _load_target(
    core: Any,
    profile: dict[str, Any],
    component: str,
    archive_name: str,
    reference: str,
    *,
    remaining_bytes: list[int] | None = None,
) -> dict[str, Any]:
    target_record = profile["target"]["gravity" if component == "gravity" else "max_scraper"]
    existing = _image_inspect(core, reference, required=False)
    if existing is not None:
        return _validate_target_image(core, target_record, reference, component)
    # Re-measure immediately before every load so an intervening consumer of the shared
    # filesystem cannot invalidate an earlier check, and refuse before the load starts.
    _storage_guard(
        core,
        profile,
        [_archive_bytes(core, profile, archive_name), *(remaining_bytes or [])],
        f"{component}_image_load",
    )
    archive = _artifact_path(core, profile, archive_name, hash_content=True)
    fd = os.open(archive, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        _run(
            core,
            [DOCKER, "image", "load", "--input", f"/proc/self/fd/{fd}"],
            timeout=int(profile["limits"]["image_load_timeout_seconds"]),
            code=f"{component.upper()}_IMAGE_LOAD_FAILED",
            pass_fds=(fd,),
        )
    finally:
        os.close(fd)
    try:
        return _validate_target_image(core, target_record, reference, component)
    except Exception:
        current = _image_inspect(core, reference, required=False)
        if current is not None:
            try:
                _run(core, [DOCKER, "image", "rm", reference], timeout=60, code=f"{component.upper()}_IMAGE_CLEANUP_FAILED")
            except Exception as cleanup:
                raise core.RuntimeFault(f"{component.upper()}_IMAGE_CLEANUP_FAILED", 74) from cleanup
        raise


def _seal_rollback_reference(core: Any, image_id: str, reference: str, component: str) -> None:
    existing = _image_inspect(core, reference, required=False)
    if existing is not None:
        if existing.get("Id") != image_id:
            raise core.RuntimeFault(f"{component.upper()}_ROLLBACK_REFERENCE_COLLISION", 74)
        return
    _run(core, [DOCKER, "image", "tag", image_id, reference], timeout=60, code=f"{component.upper()}_ROLLBACK_TAG_FAILED")
    sealed = _image_inspect(core, reference)
    if sealed is None or sealed.get("Id") != image_id:
        raise core.RuntimeFault(f"{component.upper()}_ROLLBACK_REFERENCE_MISMATCH", 74)


def _raw_container(core: Any, name: str) -> dict[str, Any]:
    value = _docker_json(core, ["container", "inspect", name], "CONTAINER_INSPECT_FAILED")
    if not isinstance(value, list) or len(value) != 1 or not isinstance(value[0], dict) or value[0].get("Name") != "/" + name:
        raise core.RuntimeFault("CONTAINER_IDENTITY_FAILED", 74)
    return value[0]


def _container_environment(core: Any, name: str) -> dict[str, str]:
    configured = (_raw_container(core, name).get("Config") or {}).get("Env")
    if not isinstance(configured, list) or len(configured) > 512:
        raise core.RuntimeFault("CONTAINER_ENVIRONMENT_INVALID", 74)
    output: dict[str, str] = {}
    for item in configured:
        if not isinstance(item, str) or "=" not in item or "\x00" in item:
            raise core.RuntimeFault("CONTAINER_ENVIRONMENT_INVALID", 74)
        key, value = item.split("=", 1)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]{0,127}", key) or key in output:
            raise core.RuntimeFault("CONTAINER_ENVIRONMENT_INVALID", 74)
        output[key] = value
    return output


def _postgres_identity(core: Any, profile: dict[str, Any]) -> dict[str, Any]:
    name = profile["deployment"]["postgres_container"]
    raw = _raw_container(core, name)
    state = raw.get("State") or {}
    if not state.get("Running") or (state.get("Health") or {}).get("Status") != "healthy":
        raise core.RuntimeFault("POSTGRES_NOT_HEALTHY", 74)
    environment = _container_environment(core, name)
    user = environment.get("POSTGRES_USER", "")
    database = environment.get("POSTGRES_DB", "")
    if not DB_IDENTIFIER.fullmatch(user) or not DB_IDENTIFIER.fullmatch(database):
        raise core.RuntimeFault("POSTGRES_DATABASE_IDENTITY_INVALID", 74)
    sql = "SELECT current_setting('server_version_num'), system_identifier::text, current_database() FROM pg_control_system();"
    completed = _run(
        core,
        [DOCKER, "exec", name, "psql", "-X", "-v", "ON_ERROR_STOP=1", "-At", "-F", "|", "-U", user, "-d", database, "-c", sql],
        timeout=30,
        code="POSTGRES_IDENTITY_QUERY_FAILED",
    )
    try:
        version, system_identifier, observed_database = completed.stdout.decode("utf-8").strip().split("|", 2)
    except (UnicodeError, ValueError) as exc:
        raise core.RuntimeFault("POSTGRES_IDENTITY_QUERY_INVALID", 74) from exc
    if not version.isdigit() or not system_identifier.isdigit() or observed_database != database:
        raise core.RuntimeFault("POSTGRES_IDENTITY_QUERY_INVALID", 74)
    identity = hashlib.sha256(f"{raw.get('Id')}|{raw.get('Image')}|{version}|{system_identifier}|{user}|{database}".encode("utf-8")).hexdigest()
    return {
        "container": name,
        "container_id": raw.get("Id"),
        "image_id": raw.get("Image"),
        "server_version_num": version,
        "system_identifier_sha256": hashlib.sha256(system_identifier.encode("ascii")).hexdigest(),
        "database_name_sha256": hashlib.sha256(database.encode("utf-8")).hexdigest(),
        "database_user_sha256": hashlib.sha256(user.encode("utf-8")).hexdigest(),
        "database_identity_sha256": identity,
        "user": user,
        "database": database,
    }


def _migration_rows(core: Any, identity: dict[str, Any]) -> list[dict[str, Any]]:
    sql = """
SELECT COALESCE(json_agg(json_build_object(
  'id', id, 'checksum', checksum, 'migration_name', migration_name,
  'finished_at', CASE WHEN finished_at IS NULL THEN NULL ELSE to_char(finished_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') END,
  'rolled_back_at', CASE WHEN rolled_back_at IS NULL THEN NULL ELSE to_char(rolled_back_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') END,
  'started_at', to_char(started_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'),
  'applied_steps_count', applied_steps_count
) ORDER BY started_at, migration_name, id), '[]'::json)::text
FROM public."_prisma_migrations";
"""
    completed = _run(
        core,
        [DOCKER, "exec", identity["container"], "psql", "-X", "-v", "ON_ERROR_STOP=1", "-At", "-U", identity["user"], "-d", identity["database"], "-c", sql],
        timeout=60,
        code="MIGRATION_LEDGER_QUERY_FAILED",
    )
    timestamp = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{6}Z")
    try:
        decoded = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeError, ValueError) as exc:
        raise core.RuntimeFault("MIGRATION_LEDGER_INVALID", 74) from exc
    if not isinstance(decoded, list) or len(decoded) > 1000:
        raise core.RuntimeFault("MIGRATION_LEDGER_INVALID", 74)
    rows: list[dict[str, Any]] = []
    active_names: set[str] = set()
    for ordinal, row in enumerate(decoded, 1):
        if not isinstance(row, dict) or set(row) != {"id", "checksum", "migration_name", "finished_at", "rolled_back_at", "started_at", "applied_steps_count"}:
            raise core.RuntimeFault("MIGRATION_LEDGER_INVALID", 74)
        if (
            not isinstance(row["id"], str)
            or not re.fullmatch(r"[A-Za-z0-9-]{1,200}", row["id"])
            or not isinstance(row["migration_name"], str)
            or not re.fullmatch(r"[0-9][A-Za-z0-9_-]{1,199}", row["migration_name"])
            or not isinstance(row["checksum"], str)
            or not SHA256.fullmatch(row["checksum"])
            or not isinstance(row["started_at"], str)
            or not timestamp.fullmatch(row["started_at"])
            or not isinstance(row["finished_at"], str)
            or not timestamp.fullmatch(row["finished_at"])
            or row["rolled_back_at"] is not None
            or isinstance(row["applied_steps_count"], bool)
            or not isinstance(row["applied_steps_count"], int)
            or row["applied_steps_count"] < 0
            or row["migration_name"] in active_names
        ):
            raise core.RuntimeFault("MIGRATION_LEDGER_INVALID", 74)
        active_names.add(row["migration_name"])
        rows.append({"ordinal": ordinal, **row})
    return rows


def _database_status(core: Any, profile: dict[str, Any]) -> dict[str, Any]:
    identity = _postgres_identity(core, profile)
    rows = _migration_rows(core, identity)
    baseline = profile["database"]
    row_digest = _digest(rows)
    exact = (
        identity["container_id"] == baseline.get("postgres_container_id")
        and identity["image_id"] == baseline.get("postgres_image_id")
        and identity["database_identity_sha256"] == baseline.get("database_identity_sha256")
        and row_digest == baseline.get("migration_rows_sha256")
        and len(rows) == baseline.get("applied_migration_count")
    )
    return {
        "profile_id": PROFILE_ID,
        "read_only": True,
        "state": "EXACT" if exact else "DRIFTED",
        "database_identity_sha256": identity["database_identity_sha256"],
        "database_name_sha256": identity["database_name_sha256"],
        "database_user_sha256": identity["database_user_sha256"],
        "system_identifier_sha256": identity["system_identifier_sha256"],
        "server_version_num": identity["server_version_num"],
        "postgres_container_id": identity["container_id"],
        "postgres_image_id": identity["image_id"],
        "applied_migration_count": len(rows),
        "migration_rows_sha256": row_digest,
        "secret_values_emitted": False,
        "production_mutated": False,
    }


def _pair(core: Any, policy: dict[str, Any], profile: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
    deployment = profile["deployment"]
    return (
        core.container_projection(policy, deployment["gravity_resource"]),
        core.container_projection(policy, deployment["max_resource"]),
    )


# Manifest-level descriptor media types. Docker's containerd image store reports the digest of
# the manifest or index it stored as the image id and echoes that same digest back in Descriptor;
# the classic graph driver reports the config blob digest and emits no Descriptor at all. This set
# only recognises the shape of that descriptor. It never widens which identity is accepted.
MANIFEST_MEDIA_TYPES = frozenset({
    "application/vnd.oci.image.index.v1+json",
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.list.v2+json",
    "application/vnd.docker.distribution.manifest.v2+json",
})


def _sealed_image_identity(core: Any, image: dict[str, Any], record: dict[str, Any], component: str) -> str:
    """Return the single sealed identity this engine's image store is expected to report.

    One image artifact has two exact content addresses: the digest of its config blob, which the
    classic graph driver reports as the image id, and the digest of the OCI manifest or index that
    holds it, which Docker's containerd image store reports instead. The manifest commits to the
    config, which commits to the layers, so both name the same bytes and neither is a mutable tag
    or a registry lookup. This profile seals both for each component, so the engine's own
    descriptor decides which one applies rather than the caller.

    Exactly one identity is ever returned. The containerd form is chosen only when the engine
    itself corroborates it, by echoing a manifest-level descriptor whose digest is the image id it
    just reported. Anything else falls back to the config digest, which is the stricter original
    behaviour, so an absent, malformed or self-contradictory descriptor cannot widen what passes.
    A component whose profile does not seal both identities is refused outright.
    """
    classic = record.get("image_id")
    containerd = record.get("containerd_image_id")
    if (
        not isinstance(classic, str)
        or not isinstance(containerd, str)
        or IMAGE_ID.fullmatch(classic) is None
        or IMAGE_ID.fullmatch(containerd) is None
        or classic == containerd
    ):
        raise core.RuntimeFault(f"{component.upper()}_TARGET_IMAGE_IDENTITY_UNSEALED", 74)
    descriptor = image.get("Descriptor")
    observed = image.get("Id")
    if (
        isinstance(descriptor, dict)
        and descriptor.get("mediaType") in MANIFEST_MEDIA_TYPES
        and isinstance(descriptor.get("digest"), str)
        and IMAGE_ID.fullmatch(descriptor["digest"]) is not None
        and descriptor["digest"] == observed
    ):
        return containerd
    return classic


def _sealed_identities(record: dict[str, Any]) -> frozenset[str]:
    """Every exact identity this profile seals for one image, as the engine may report it.

    A running container names its image through `docker container inspect`, which offers no
    descriptor to say which address space the id came from, so classification has to accept any
    identity the profile already sealed for that component. Both forms are exact content addresses
    of the same bytes, so either one names the image unambiguously; the set is per component, so a
    Gravity identity can still never classify as MAX. A record that seals nothing usable yields an
    empty set, which classifies as unknown rather than matching a missing value.
    """
    return frozenset(
        value
        for key in ("image_id", "containerd_image_id")
        for value in (record.get(key),)
        if isinstance(value, str) and value
    )


def _classify(profile: dict[str, Any], gravity: dict[str, Any], maximum: dict[str, Any]) -> tuple[str, tuple[str, str]]:
    def component(actual: Any, predecessor: dict[str, Any], target: dict[str, Any]) -> str:
        predecessor_identities = _sealed_identities(predecessor)
        target_identities = _sealed_identities(target)
        if not isinstance(actual, str) or predecessor_identities & target_identities:
            return "unknown"
        if actual in predecessor_identities:
            return "predecessor"
        if actual in target_identities:
            return "target"
        return "unknown"
    vector = (
        component(gravity.get("image_id"), profile["predecessor"]["gravity"], profile["target"]["gravity"]),
        component(maximum.get("image_id"), profile["predecessor"]["max_scraper"], profile["target"]["max_scraper"]),
    )
    if vector == ("predecessor", "predecessor"):
        return "PREDECESSOR_PAIR", vector
    if vector == ("target", "target"):
        return "TARGET_PAIR", vector
    if "unknown" in vector:
        return "UNKNOWN", vector
    return "MIXED_KNOWN", vector


def _max_volume_exact(core: Any, profile: dict[str, Any], maximum: dict[str, Any]) -> None:
    expected = profile["predecessor"]["max_scraper"]["volume"]
    mounts = maximum.get("mounts")
    semantic_mounts = maximum.get("semantic", {}).get("mounts")
    named = [item for item in mounts if isinstance(item, dict) and item.get("target") == "/app/user_data"] if isinstance(mounts, list) else []
    projected = [item for item in semantic_mounts if isinstance(item, dict) and item.get("destination") == "/app/user_data"] if isinstance(semantic_mounts, list) else []
    if (
        named != [{"name": "crm_max_user_data", "read_write": True, "target": "/app/user_data", "type": "volume"}]
        or projected != [{"destination": "/app/user_data", "read_only": False, "source_sha256": expected.get("source_sha256"), "type": "volume"}]
    ):
        raise core.RuntimeFault("MAX_PERSISTENT_VOLUME_IDENTITY_DRIFT", 74)


def _preserved_semantic(value: dict[str, Any]) -> dict[str, Any]:
    output = dict(value)
    output.pop("image_id", None)
    output.pop("command", None)
    labels = dict(output.get("compose_labels") or {})
    labels.pop("com.docker.compose.config-hash", None)
    output["compose_labels"] = labels
    return output


def _unrelated_fingerprint(core: Any, policy: dict[str, Any]) -> str:
    provenance = core.docker_provenance(policy)
    if not provenance.get("complete") or provenance.get("failures"):
        raise core.RuntimeFault("PRODUCTION_PROVENANCE_INCOMPLETE", 74)
    records = provenance.get("semantic", {}).get("records")
    if not isinstance(records, list):
        raise core.RuntimeFault("PRODUCTION_PROVENANCE_INVALID", 74)
    excluded = {"crm-gravity-mvp", "crm-max-scraper"}
    return _digest([record for record in records if isinstance(record, dict) and record.get("name") not in excluded])


def _fixed_production_file(core: Any, path: str, mode: int, maximum: int) -> os.stat_result:
    """Bind a fixed root-owned leaf below a non-caller-writable production tree."""
    target = core.mapped(path)
    core.assert_noncaller_writable_chain(target)
    try:
        value = target.lstat()
    except OSError as exc:
        raise core.RuntimeFault("PRODUCTION_CONFIGURATION_FILE_UNSAFE", 74) from exc
    owner = core.expected_owner()
    if (
        target.is_symlink()
        or not stat.S_ISREG(value.st_mode)
        or (value.st_uid, value.st_gid) != owner
        or stat.S_IMODE(value.st_mode) != mode
        or value.st_nlink != 1
        or not 0 <= value.st_size <= maximum
    ):
        raise core.RuntimeFault("PRODUCTION_CONFIGURATION_FILE_UNSAFE", 74)
    return value


def _secure_compose_inputs(core: Any, profile: dict[str, Any]) -> tuple[Path, Path]:
    deployment = profile["deployment"]
    compose = core.mapped(deployment["compose_path"])
    environment = core.mapped(deployment["environment_path"])
    _fixed_production_file(core, deployment["compose_path"], 0o644, 4 * 1024 * 1024)
    _fixed_production_file(core, deployment["environment_path"], 0o600, 4 * 1024 * 1024)
    if _sha_file(compose, 4 * 1024 * 1024) != profile["predecessor"]["compose_sha256"]:
        raise core.RuntimeFault("PRODUCTION_COMPOSE_IDENTITY_DRIFT", 74)
    return compose, environment


def _validate_compose_inputs(core: Any, profile: dict[str, Any], state: dict[str, Any]) -> None:
    _, environment = _secure_compose_inputs(core, profile)
    if not SHA256.fullmatch(str(state.get("environment_sha256", ""))) or _sha_file(environment, 4 * 1024 * 1024) != state["environment_sha256"]:
        raise core.RuntimeFault("PRODUCTION_ENVIRONMENT_IDENTITY_DRIFT", 74)


def _release_environment(core: Any) -> dict[str, Any]:
    """Read and bind the sealed release environment sources for activation only.

    Each source must be a fixed root-owned 0600 regular file below a non-caller-writable chain,
    containing exactly one line that assigns the one admitted name a lowercase 64-hex value, and
    both services must receive identical material. The value is returned only for the in-memory
    projection comparison; no fault raised here carries it, and callers persist only the digest.
    """
    values: dict[str, bytes] = {}
    digests: dict[str, str] = {}
    try:
        # Root-owned 0700 directory whose every ancestor is root-owned and not group/other
        # writable: no non-root principal can replace a source between validation and Compose.
        core.secure_directory(RELEASE_ENVIRONMENT_DIRECTORY, 0o700)
    except (core.RuntimeFault, OSError) as exc:
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_UNSAFE", 74, {"service": "directory"}) from exc
    for service, path in sorted(RELEASE_ENVIRONMENT_SOURCES.items()):
        if os.path.dirname(path) != RELEASE_ENVIRONMENT_DIRECTORY:
            raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_UNSAFE", 74, {"service": service})
        try:
            expected = _fixed_production_file(core, path, 0o600, RELEASE_ENVIRONMENT_SOURCE_MAXIMUM)
        except (core.RuntimeFault, OSError) as exc:
            raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_UNSAFE", 74, {"service": service}) from exc
        try:
            fd = os.open(core.mapped(path), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        except OSError as exc:
            raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_UNSAFE", 74, {"service": service}) from exc
        try:
            opened = os.fstat(fd)
            if (opened.st_dev, opened.st_ino) != (expected.st_dev, expected.st_ino):
                raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_UNSAFE", 74, {"service": service})
            raw = os.read(fd, RELEASE_ENVIRONMENT_SOURCE_MAXIMUM + 1)
        finally:
            os.close(fd)
        prefix = RELEASE_ENVIRONMENT_NAME.encode("ascii") + b"="
        value = raw[len(prefix):-1] if raw.startswith(prefix) and raw.endswith(b"\n") else b""
        if (
            len(raw) > RELEASE_ENVIRONMENT_SOURCE_MAXIMUM
            or raw.count(b"\n") != 1
            or RELEASE_ENVIRONMENT_VALUE.fullmatch(value) is None
        ):
            raise core.RuntimeFault("RELEASE_ENVIRONMENT_SOURCE_INVALID", 74, {"service": service})
        values[service] = value
        digests[service] = hashlib.sha256(raw).hexdigest()
    first, second = (values[service] for service in sorted(values))
    if not hmac.compare_digest(first, second):
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_MATERIAL_MISMATCH", 74)
    return {"sha256": _digest(digests), "value": first.decode("ascii")}


def _validate_release_environment(core: Any, state: dict[str, Any]) -> dict[str, Any]:
    release = _release_environment(core)
    if not SHA256.fullmatch(str(state.get("release_environment_sha256", ""))) or not hmac.compare_digest(
        release["sha256"], state["release_environment_sha256"]
    ):
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_IDENTITY_DRIFT", 74)
    return release


def _calling_b2_environment(core: Any) -> dict[str, Any]:
    """Read and bind the sealed Calling B2 source for activation only.

    The source must be a fixed root-owned 0600 single-link regular file in a root-owned 0700
    directory whose ancestors are root-owned and not group/other writable, and it must assign every
    admitted name exactly once. Unknown, duplicate and missing names are refused, and so is any kill
    switch value other than `true` or `false`. The values are returned only for the in-memory
    projection comparison. Faults carry a reason and admitted names, never a value or an unadmitted
    name, and callers persist only the digest.
    """
    try:
        core.secure_directory(CALLING_B2_ENVIRONMENT_DIRECTORY, 0o700)
    except (core.RuntimeFault, OSError) as exc:
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_SOURCE_UNSAFE", 74, {"source": "directory"}) from exc
    try:
        expected = _fixed_production_file(core, CALLING_B2_ENVIRONMENT_SOURCE, 0o600, CALLING_B2_ENVIRONMENT_SOURCE_MAXIMUM)
        fd = os.open(core.mapped(CALLING_B2_ENVIRONMENT_SOURCE), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except (core.RuntimeFault, OSError) as exc:
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_SOURCE_UNSAFE", 74, {"source": "file"}) from exc
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino) != (expected.st_dev, expected.st_ino):
            raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_SOURCE_UNSAFE", 74, {"source": "file"})
        raw = b""
        while len(raw) <= CALLING_B2_ENVIRONMENT_SOURCE_MAXIMUM:
            chunk = os.read(fd, CALLING_B2_ENVIRONMENT_SOURCE_MAXIMUM + 1 - len(raw))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(fd)

    def invalid(reason: str, **admitted: Any) -> Exception:
        return core.RuntimeFault("CALLING_B2_ENVIRONMENT_SOURCE_INVALID", 74, {"reason": reason, **admitted})

    if len(raw) > CALLING_B2_ENVIRONMENT_SOURCE_MAXIMUM:
        raise invalid("SIZE")
    if not raw.endswith(b"\n"):
        raise invalid("SYNTAX")
    values: dict[str, str] = {}
    for line in raw[:-1].split(b"\n"):
        match = CALLING_B2_ENVIRONMENT_LINE.fullmatch(line)
        if match is None:
            raise invalid("SYNTAX")
        name = match.group(1).decode("ascii")
        if name not in CALLING_B2_ENVIRONMENT_NAMES:
            raise invalid("UNKNOWN_NAME")
        if name in values:
            raise invalid("DUPLICATE_NAME", name=name)
        values[name] = match.group(2).decode("ascii")
    missing = [name for name in CALLING_B2_ENVIRONMENT_NAMES if name not in values]
    if missing:
        raise invalid("MISSING_NAME", names=missing)
    for name in CALLING_B2_KILL_SWITCHES:
        if values[name] not in CALLING_B2_KILL_SWITCH_VALUES:
            raise invalid("KILL_SWITCH_VALUE", name=name)
    return {"sha256": hashlib.sha256(raw).hexdigest(), "values": values}


def _validate_calling_b2_environment(core: Any, state: dict[str, Any]) -> dict[str, Any]:
    calling = _calling_b2_environment(core)
    if not SHA256.fullmatch(str(state.get("calling_b2_environment_sha256", ""))) or not hmac.compare_digest(
        calling["sha256"], state["calling_b2_environment_sha256"]
    ):
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_IDENTITY_DRIFT", 74)
    return calling


def _assert_calling_b2_disarmed(core: Any, gravity: Any) -> None:
    """Refuse a rollback while the live Gravity container has either Calling kill switch armed.

    This reads the environment the classified Gravity container was actually created with, bound to
    its container id, and never the staging source, which a rollback must not depend on. The
    application arms a switch only on the exact string `true`; this guard is stricter. A switch
    counts as disarmed only when it is absent or exactly `false`. Any other value, a repeated or
    near-miss name, or an environment that cannot be read is treated as armed or unproven. Faults
    carry switch names, never values.
    """
    name = gravity.get("name") if isinstance(gravity, dict) else None
    container_id = gravity.get("container_id") if isinstance(gravity, dict) else None
    if not isinstance(name, str) or not name or not isinstance(container_id, str) or not container_id:
        raise core.RuntimeFault("CALLING_B2_KILL_SWITCH_STATE_UNPROVEN", 74)
    try:
        raw = _raw_container(core, name)
    except Exception as exc:
        raise core.RuntimeFault("CALLING_B2_KILL_SWITCH_STATE_UNPROVEN", 74) from exc
    config = raw.get("Config")
    environment = config.get("Env") if isinstance(config, dict) else None
    if raw.get("Id") != container_id or not isinstance(environment, list):
        raise core.RuntimeFault("CALLING_B2_KILL_SWITCH_STATE_UNPROVEN", 74)
    observed: dict[str, list[str | None]] = {switch: [] for switch in CALLING_B2_KILL_SWITCHES}
    for item in environment:
        if not isinstance(item, str) or "=" not in item or "\x00" in item:
            raise core.RuntimeFault("CALLING_B2_KILL_SWITCH_STATE_UNPROVEN", 74)
        key, value = item.split("=", 1)
        normalized = key.strip().upper()
        if normalized in observed:
            observed[normalized].append(value if key == normalized else None)
    armed = [switch for switch, values in observed.items() if values not in ([], [CALLING_B2_DISARMED_VALUE])]
    if armed:
        raise core.RuntimeFault("CALLING_B2_KILL_SWITCH_ARMED", 77, {"armed_kill_switches": armed})


def _calling_b2_rollback_refusal(core: Any, gravity: Any) -> dict[str, Any] | None:
    """Decide, before any rollback intent is written, whether the Calling guard forbids a rollback.

    Returns the refusal's bounded fault identity (codes and switch names only), or None when the
    Gravity container is proven disarmed. An automatic rollback that would be refused is then
    reported as refused, rather than recorded as a rollback that was attempted and failed.
    """
    try:
        _assert_calling_b2_disarmed(core, gravity)
    except Exception as refusal:
        return _activation_failure(core, refusal)
    return None


def _environment_names(core: Any, semantic: Any, code: str) -> list[str]:
    names = semantic.get("environment_names") if isinstance(semantic, dict) else None
    if (
        not isinstance(names, list)
        or any(not isinstance(name, str) or not name for name in names)
        or names != sorted(set(names))
    ):
        raise core.RuntimeFault(code, 74)
    return names


def _admitted_release_names(core: Any, service: str) -> tuple[str, ...]:
    """Every environment name activation may add to one pair service: sealed, never widened."""
    if service not in RELEASE_ENVIRONMENT_SOURCES:
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_SERVICE_NOT_ADMITTED", 74, {"service": service})
    if service == CALLING_B2_SERVICE:
        return (RELEASE_ENVIRONMENT_NAME, *CALLING_B2_ENVIRONMENT_NAMES)
    return (RELEASE_ENVIRONMENT_NAME,)


def _expected_pair_semantic(core: Any, service: str, predecessor: dict[str, Any], *, target: bool) -> dict[str, Any]:
    """The exact runtime semantic a pair container must show after a release transition.

    Rollback expects the predecessor semantic unchanged. Activation expects the predecessor
    semantic plus exactly the sealed names admitted for that service: the Messaging name for
    both pair services, and the Calling B2 names for gravity-mvp only. None may already be
    present. Any other added, removed or renamed environment variable therefore still differs
    from the expectation and fails closed.
    """
    if not target:
        return predecessor
    admitted = _admitted_release_names(core, service)
    names = _environment_names(core, predecessor, "RELEASE_ENVIRONMENT_PREDECESSOR_INVALID")
    if RELEASE_ENVIRONMENT_NAME in names:
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_ALREADY_PRESENT", 74, {"service": service})
    if any(name in names for name in admitted):
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_ALREADY_PRESENT", 74, {"service": service})
    return {**predecessor, "environment_names": sorted([*names, *admitted])}


def _admit_release_environment_projection(
    core: Any,
    service: str,
    original: dict[str, Any],
    actual: dict[str, Any],
    value: str,
    calling_values: Mapping[str, str] | None = None,
) -> None:
    """Remove exactly the admitted release variables from one candidate service projection.

    The caller then requires the remainder to equal the base projection byte for byte, so this
    admits only the sealed names for that service, each with its one bound value, and nothing else.
    """
    admitted = _admitted_release_names(core, service)
    base = original.get("environment", {})
    candidate = actual.get("environment", {})
    if not isinstance(base, dict) or not isinstance(candidate, dict):
        raise core.RuntimeFault("PAIR_COMPOSE_PROJECTION_DRIFT", 74)
    if RELEASE_ENVIRONMENT_NAME in base:
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_ALREADY_PRESENT", 74, {"service": service})
    if any(name in base for name in admitted):
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_ALREADY_PRESENT", 74, {"service": service})
    for name in admitted:
        messaging = name == RELEASE_ENVIRONMENT_NAME
        bound = value if messaging else (calling_values.get(name) if isinstance(calling_values, Mapping) else None)
        if not isinstance(bound, str):
            raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_BINDING_INVALID", 78, {"service": service})
        # Compose writes a literal `$` in a resolved value as `$$` in its config output, and reads it
        # back the same way, so the render of a bound value is exactly that escape of it.
        rendered = bound.replace("$", "$$")
        supplied = candidate.get(name)
        if not isinstance(supplied, str) or not hmac.compare_digest(supplied.encode("utf-8"), rendered.encode("ascii")):
            code = "RELEASE_ENVIRONMENT_PROJECTION_DRIFT" if messaging else "CALLING_B2_ENVIRONMENT_PROJECTION_DRIFT"
            raise core.RuntimeFault(code, 74, {"service": service})
    remainder = {key: item for key, item in candidate.items() if key not in admitted}
    if "environment" in original:
        actual["environment"] = remainder
    elif remainder:
        raise core.RuntimeFault("PAIR_COMPOSE_PROJECTION_DRIFT", 74)
    else:
        actual.pop("environment", None)


def _compose_overlay(gravity: str, maximum: str, *, activate: bool) -> bytes:
    if (gravity, maximum) != ((TARGET_GRAVITY, TARGET_MAX) if activate else (ROLLBACK_GRAVITY, ROLLBACK_MAX)):
        raise RuntimeError("IMAGE_REFERENCE_INVALID")
    command = "    command: [\"npm\", \"run\", \"start\"]\n" if activate else ""

    def environment(service: str) -> str:
        if not activate:
            return ""
        sources = [RELEASE_ENVIRONMENT_SOURCES[service]]
        if service == CALLING_B2_SERVICE:
            sources.append(CALLING_B2_ENVIRONMENT_SOURCE)
        return "    env_file:\n" + "".join(f"      - {source}\n" for source in sources)

    return (
        "services:\n"
        "  gravity-mvp:\n"
        f"    image: {gravity}\n"
        f"{command}"
        f"{environment('gravity-mvp')}"
        "  max-web-scraper:\n"
        f"    image: {maximum}\n"
        f"{environment('max-web-scraper')}"
    ).encode("ascii")


def _compose_args(profile: dict[str, Any], overlay: str | None = None) -> list[str]:
    deployment = profile["deployment"]
    output = [
        DOCKER, "compose", "--project-directory", deployment["project_directory"],
        "--env-file", deployment["environment_path"], "-f", deployment["compose_path"],
    ]
    if overlay is not None:
        output.extend(["-f", overlay])
    return output


def _compose_config(core: Any, args: list[str]) -> dict[str, Any]:
    completed = _run(core, [*args, "config", "--format", "json"], timeout=60, code="ACTIVATION_COMPOSE_CONFIG_INVALID")
    try:
        value = json.loads(completed.stdout)
    except (UnicodeError, ValueError) as exc:
        raise core.RuntimeFault("ACTIVATION_COMPOSE_CONFIG_INVALID", 74) from exc
    if not isinstance(value, dict) or not isinstance(value.get("services"), dict):
        raise core.RuntimeFault("ACTIVATION_COMPOSE_CONFIG_INVALID", 74)
    return value


def _validate_projection(
    core: Any,
    profile: dict[str, Any],
    overlay: str,
    *,
    activate: bool,
    release_value: str | None = None,
    calling_values: Mapping[str, str] | None = None,
) -> None:
    base = _compose_config(core, _compose_args(profile))
    candidate = _compose_config(core, _compose_args(profile, overlay))
    if set(base) != set(candidate) or set(base["services"]) != set(candidate["services"]):
        raise core.RuntimeFault("PAIR_COMPOSE_PROJECTION_DRIFT", 74)
    base_top = {key: value for key, value in base.items() if key != "services"}
    candidate_top = {key: value for key, value in candidate.items() if key != "services"}
    if _canonical(base_top) != _canonical(candidate_top):
        raise core.RuntimeFault("UNRELATED_COMPOSE_TOP_LEVEL_DRIFT", 74)
    changed = {"gravity-mvp", "max-web-scraper"}
    if _canonical({key: value for key, value in base["services"].items() if key not in changed}) != _canonical({key: value for key, value in candidate["services"].items() if key not in changed}):
        raise core.RuntimeFault("UNRELATED_COMPOSE_SERVICE_DRIFT", 74)
    # Activation compares the render against the values already bound to the preflight digests;
    # rollback takes no release value at all.
    if activate != isinstance(release_value, str) or (activate and RELEASE_ENVIRONMENT_VALUE.fullmatch(release_value.encode("ascii", "replace")) is None):
        raise core.RuntimeFault("RELEASE_ENVIRONMENT_BINDING_INVALID", 78)
    if activate != isinstance(calling_values, Mapping) or (activate and sorted(calling_values) != list(CALLING_B2_ENVIRONMENT_NAMES)):
        raise core.RuntimeFault("CALLING_B2_ENVIRONMENT_BINDING_INVALID", 78)
    expected = {
        "gravity-mvp": TARGET_GRAVITY if activate else ROLLBACK_GRAVITY,
        "max-web-scraper": TARGET_MAX if activate else ROLLBACK_MAX,
    }
    for name in sorted(changed):
        original = dict(base["services"][name])
        actual = dict(candidate["services"][name])
        if actual.get("image") != expected[name]:
            raise core.RuntimeFault("PAIR_COMPOSE_IMAGE_DRIFT", 74)
        actual["image"] = original.get("image")
        if release_value is not None:
            _admit_release_environment_projection(core, name, original, actual, release_value, calling_values)
        if activate and name == "gravity-mvp":
            if actual.get("command") != ["npm", "run", "start"]:
                raise core.RuntimeFault("GRAVITY_SAFE_COMMAND_DRIFT", 74)
            if "command" in original:
                actual["command"] = original["command"]
            else:
                actual.pop("command", None)
        if _canonical(actual) != _canonical(original):
            raise core.RuntimeFault("PAIR_COMPOSE_PROJECTION_DRIFT", 74)


def _compose_hash(core: Any, profile: dict[str, Any], overlay: str, service: str) -> str:
    resolved = _compose_config(core, _compose_args(profile, overlay))
    raw = _canonical(resolved)
    if len(raw) > 4 * 1024 * 1024:
        raise core.RuntimeFault("COMPOSE_HASH_INPUT_TOO_LARGE", 74)
    fd = os.memfd_create("yoko-resolved-compose", os.MFD_CLOEXEC)
    stream = os.fdopen(fd, "w+b", closefd=True)
    try:
        stream.write(raw)
        stream.flush()
        stream.seek(0)
        completed = _run(core, [DOCKER, "compose", "-f", "-", "config", "--hash", service], timeout=60, code="COMPOSE_HASH_DERIVATION_FAILED", stdin_fd=stream.fileno())
    finally:
        stream.close()
    try:
        parts = completed.stdout.decode("ascii").strip().split()
    except UnicodeError as exc:
        raise core.RuntimeFault("COMPOSE_HASH_DERIVATION_INVALID", 74) from exc
    if len(parts) != 2 or parts[0] != service or not SHA256.fullmatch(parts[1]):
        raise core.RuntimeFault("COMPOSE_HASH_DERIVATION_INVALID", 74)
    return parts[1]


def _derive_compose_domains(
    core: Any, profile: dict[str, Any], release_value: str, calling_values: Mapping[str, str]
) -> dict[str, str]:
    _write_fixed_file(core, ACTIVATE_OVERLAY, _compose_overlay(TARGET_GRAVITY, TARGET_MAX, activate=True), 0o400)
    _write_fixed_file(core, ROLLBACK_OVERLAY, _compose_overlay(ROLLBACK_GRAVITY, ROLLBACK_MAX, activate=False), 0o400)
    _validate_projection(
        core, profile, ACTIVATE_OVERLAY, activate=True, release_value=release_value, calling_values=calling_values
    )
    _validate_projection(core, profile, ROLLBACK_OVERLAY, activate=False)
    return {
        "target_gravity_compose_hash": _compose_hash(core, profile, ACTIVATE_OVERLAY, "gravity-mvp"),
        "target_max_compose_hash": _compose_hash(core, profile, ACTIVATE_OVERLAY, "max-web-scraper"),
        "rollback_gravity_compose_hash": _compose_hash(core, profile, ROLLBACK_OVERLAY, "gravity-mvp"),
        "rollback_max_compose_hash": _compose_hash(core, profile, ROLLBACK_OVERLAY, "max-web-scraper"),
    }


def _archive_bytes(core: Any, profile: dict[str, Any], name: str) -> int:
    files = profile["artifact_admission"].get("files")
    record = files.get(name) if isinstance(files, dict) else None
    size = record.get("bytes") if isinstance(record, dict) else None
    if isinstance(size, bool) or not isinstance(size, int) or size <= 0:
        raise core.RuntimeFault("ARTIFACT_PROFILE_INVALID", 78)
    return size


def _storage_projection(core: Any, profile: dict[str, Any], pending: list[int]) -> dict[str, int]:
    limits = profile["limits"]
    permille = limits.get("image_load_expansion_permille")
    reserve = limits.get("minimum_free_bytes")
    if isinstance(permille, bool) or not isinstance(permille, int) or permille < 1000:
        raise core.RuntimeFault("STORAGE_LIMITS_INVALID", 78)
    if isinstance(reserve, bool) or not isinstance(reserve, int) or reserve < 0:
        raise core.RuntimeFault("STORAGE_LIMITS_INVALID", 78)
    archive_bytes = sum(pending)
    # A `docker image load` on a containerd snapshotter writes every new layer twice:
    # once as a content-store blob and once as an unpacked snapshot. The permille factor
    # converts admitted archive bytes into that on-disk cost plus filesystem overhead.
    projected = (archive_bytes * permille + 999) // 1000
    filesystem = os.statvfs(core.mapped("/var/lib/yoko-privileged-runtime"))
    available = filesystem.f_bavail * filesystem.f_frsize
    required = projected + reserve
    return {
        "available_bytes": available,
        "pending_archive_bytes": archive_bytes,
        "image_load_expansion_permille": permille,
        "projected_load_bytes": projected,
        "storage_reserve_bytes": reserve,
        "required_bytes": required,
        "projected_free_bytes": available - projected,
        "shortfall_bytes": max(0, required - available),
    }


def _storage_guard(core: Any, profile: dict[str, Any], pending: list[int], stage: str) -> dict[str, int]:
    projection = {**_storage_projection(core, profile, pending), "stage": stage}
    if projection["shortfall_bytes"] > 0:
        raise core.RuntimeFault("INSUFFICIENT_RELEASE_STORAGE", 75, projection)
    return projection


def _container_instance(current: dict[str, Any]) -> dict[str, Any]:
    return {
        "container_id": current.get("container_id"),
        "compose_config_hash": current.get("compose_labels", {}).get("com.docker.compose.config-hash"),
    }


def _accepted_instances(profile: dict[str, Any], state: dict[str, Any], key: str) -> list[dict[str, Any]]:
    """Ephemeral container identities this runtime is allowed to observe for the predecessor pair.

    The sealed snapshot is always accepted. So is the single instance this runtime durably
    recorded for itself, which it only ever writes after validating the pair: at preflight, or
    after a rollback it performed. It is honoured in whatever phase the state is in, because the
    containers it names are the ones that are live -- gating it on one phase is what previously
    made a rolled-back or postcheck-failed release permanently one-shot.

    This widens nothing else. The immutable predecessor identity -- image, volume, semantics,
    database, unrelated services, running, healthy, never restarted -- is still checked strictly
    against the sealed profile by the caller, and a malformed or absent record is ignored.
    """
    sealed = profile["predecessor"][key]
    accepted = [
        {
            "container_id": sealed.get("container_id"),
            "compose_config_hash": sealed.get("compose_config_hash"),
        }
    ]
    recorded = state.get("predecessor_instance")
    entry = recorded.get(key) if isinstance(recorded, dict) else None
    if (
        isinstance(entry, dict)
        and isinstance(entry.get("container_id"), str)
        and entry["container_id"]
        and isinstance(entry.get("compose_config_hash"), str)
        and entry["compose_config_hash"]
    ):
        accepted.append(
            {
                "container_id": entry["container_id"],
                "compose_config_hash": entry["compose_config_hash"],
            }
        )
    return accepted


def _observed_instance(core: Any, policy: dict[str, Any], profile: dict[str, Any]) -> dict[str, Any] | None:
    """Best-effort record of the live pair, used on the rollback failure path.

    A rollback whose Compose transaction succeeded but whose postcheck then failed has already
    recreated the containers, so the sealed instance no longer describes anything. Recording what
    is actually live keeps a later preflight able to re-establish. Returns None unless the live
    pair is still the authorised predecessor pair by image id, and never raises: this runs inside
    a durable fencing write.
    """
    try:
        gravity, maximum = _pair(core, policy, profile)
        kind, _ = _classify(profile, gravity, maximum)
        if kind != "PREDECESSOR_PAIR":
            return None
        return {"gravity": _container_instance(gravity), "max_scraper": _container_instance(maximum)}
    except Exception:
        return None


def _predecessor_identity(
    core: Any, policy: dict[str, Any], profile: dict[str, Any], state: dict[str, Any]
) -> dict[str, Any]:
    gravity, maximum = _pair(core, policy, profile)
    kind, vector = _classify(profile, gravity, maximum)
    predecessor = profile["predecessor"]
    if kind != "PREDECESSOR_PAIR":
        raise core.RuntimeFault("PREDECESSOR_PAIR_REQUIRED", 74, {"pair_state": kind, "vector": list(vector)})
    for current, expected, name, key in (
        (gravity, predecessor["gravity"], "GRAVITY", "gravity"),
        (maximum, predecessor["max_scraper"], "MAX", "max_scraper"),
    ):
        if (
            current.get("image_id") != expected.get("image_id")
            or current.get("running") is not True
            or current.get("health") != "healthy"
            or current.get("restart_count") != 0
            or _container_instance(current) not in _accepted_instances(profile, state, key)
        ):
            raise core.RuntimeFault(f"{name}_PREDECESSOR_IDENTITY_DRIFT", 74)
    _max_volume_exact(core, profile, maximum)
    # Refuse before anything is loaded if the predecessors already carry the release name or their
    # environment projection is unusable: the activation expectation could not then be exact.
    _expected_pair_semantic(core, "gravity-mvp", gravity["semantic"], target=True)
    _expected_pair_semantic(core, "max-web-scraper", maximum["semantic"], target=True)
    database = _database_status(core, profile)
    if database["state"] != "EXACT":
        raise core.RuntimeFault("DATABASE_PREDECESSOR_IDENTITY_DRIFT", 74)
    unrelated = _unrelated_fingerprint(core, policy)
    if unrelated != predecessor.get("unrelated_semantic_fingerprint_sha256"):
        raise core.RuntimeFault("UNRELATED_SERVICE_IDENTITY_DRIFT", 74)
    _, environment = _secure_compose_inputs(core, profile)
    return {
        "gravity_semantic": gravity["semantic"],
        "max_semantic": maximum["semantic"],
        # The ephemeral instance this preflight just validated against the full immutable identity.
        # Carrying it in state keeps a rolled-back release retryable without depending on which
        # earlier phase happened to record it.
        "predecessor_instance": {
            "gravity": _container_instance(gravity),
            "max_scraper": _container_instance(maximum),
        },
        "environment_sha256": _sha_file(environment, 4 * 1024 * 1024),
        "unrelated_semantic_fingerprint_sha256": unrelated,
        "database": database,
    }


def _compose_log_path(activate: bool) -> str:
    return ACTIVATE_COMPOSE_LOG if activate else ROLLBACK_COMPOSE_LOG


def _log_evidence(core: Any, path: str, captured_at: str) -> dict[str, Any]:
    """Bounded, secret-free descriptor of one Compose transaction log.

    Only the path, byte length and digest are recorded in state; the Compose output itself
    stays in its own fixed 0600 file. Activation and rollback use separate files, so an
    automatic rollback can no longer overwrite the evidence of the activation that failed.
    """
    evidence: dict[str, Any] = {"path": path, "captured_at": captured_at}
    try:
        target = core.mapped(path)
        evidence["bytes"] = os.stat(target).st_size
        evidence["sha256"] = _sha_file(target, COMPOSE_LOG_MAXIMUM)
    except Exception:
        # Diagnostics are best-effort by construction: capturing evidence must never be able
        # to abort a durable fencing write or mask the fault that is being recorded.
        evidence["bytes"] = None
        evidence["sha256"] = None
    return evidence


def _compose_up(core: Any, profile: dict[str, Any], state: dict[str, Any], overlay: str, *, activate: bool) -> None:
    _validate_compose_inputs(core, profile, state)
    release_value = None
    calling_values = None
    if activate:
        # Only activation attaches the release environment, so only activation depends on it.
        # A rollback must stay possible even if these sources were removed after a failure.
        release_value = _validate_release_environment(core, state)["value"]
        calling_values = _validate_calling_b2_environment(core, state)["values"]
    _validate_projection(
        core, profile, overlay, activate=activate, release_value=release_value, calling_values=calling_values
    )
    log = core.mapped(_compose_log_path(activate))
    fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        # The open mode applies only on creation; reassert it so a reused transcript file cannot
        # keep a wider mode, matching _lock and _write_state.
        os.fchmod(fd, 0o600)
        deployment = profile["deployment"]
        _run(
            core,
            [
                *_compose_args(profile, overlay), "up", "-d", "--no-deps", "--no-build", "--pull", "never",
                "--force-recreate", "--wait", "--wait-timeout", str(profile["limits"]["health_timeout_seconds"]),
                deployment["gravity_service"], deployment["max_service"],
            ],
            timeout=int(profile["limits"]["activation_timeout_seconds"]),
            code="PAIR_COMPOSE_ACTIVATION_FAILED",
            stdout_fd=fd,
            stderr_fd=fd,
        )
        os.fsync(fd)
    finally:
        os.close(fd)


def _wait_pair(core: Any, policy: dict[str, Any], profile: dict[str, Any], expected: str) -> tuple[dict[str, Any], dict[str, Any]]:
    deadline = time.monotonic() + int(profile["limits"]["health_timeout_seconds"])
    last: tuple[dict[str, Any], dict[str, Any]] | None = None
    while time.monotonic() <= deadline:
        last = _pair(core, policy, profile)
        kind, _ = _classify(profile, *last)
        if kind == expected and all(item.get("running") is True and item.get("health") == "healthy" for item in last):
            return last
        time.sleep(2)
    raise core.RuntimeFault("PAIR_HEALTH_TIMEOUT", 74, {"expected_pair": expected})


def _postcheck(core: Any, policy: dict[str, Any], profile: dict[str, Any], state: dict[str, Any], expected: str) -> dict[str, Any]:
    _validate_compose_inputs(core, profile, state)
    gravity, maximum = _wait_pair(core, policy, profile, expected)
    kind, vector = _classify(profile, gravity, maximum)
    if kind != expected:
        raise core.RuntimeFault("PAIR_POSTCHECK_IDENTITY_DRIFT", 74)
    _max_volume_exact(core, profile, maximum)
    target = expected == "TARGET_PAIR"
    if not target and any(
        name in _environment_names(core, gravity.get("semantic"), "GRAVITY_RUNTIME_SEMANTIC_DRIFT")
        for name in CALLING_B2_ENVIRONMENT_NAMES
    ):
        # Rollback Gravity must run with the exact predecessor environment and no Calling B2 name.
        raise core.RuntimeFault("ROLLBACK_CALLING_B2_ENVIRONMENT_PRESENT", 74)
    expected_gravity = _expected_pair_semantic(core, "gravity-mvp", state["gravity_semantic"], target=target)
    expected_max = _expected_pair_semantic(core, "max-web-scraper", state["max_semantic"], target=target)
    if _preserved_semantic(gravity["semantic"]) != _preserved_semantic(expected_gravity):
        raise core.RuntimeFault("GRAVITY_RUNTIME_SEMANTIC_DRIFT", 74)
    if _preserved_semantic(maximum["semantic"]) != _preserved_semantic(expected_max):
        raise core.RuntimeFault("MAX_RUNTIME_SEMANTIC_DRIFT", 74)
    if expected == "TARGET_PAIR":
        if gravity["semantic"].get("command") != ["npm", "run", "start"] or maximum["semantic"].get("command") != state["max_semantic"].get("command"):
            raise core.RuntimeFault("TARGET_RUNTIME_COMMAND_DRIFT", 74)
        expected_hashes = (state["target_gravity_compose_hash"], state["target_max_compose_hash"])
    else:
        if gravity["semantic"].get("command") != state["gravity_semantic"].get("command") or maximum["semantic"].get("command") != state["max_semantic"].get("command"):
            raise core.RuntimeFault("ROLLBACK_RUNTIME_COMMAND_DRIFT", 74)
        expected_hashes = (state["rollback_gravity_compose_hash"], state["rollback_max_compose_hash"])
    actual_hashes = (
        gravity.get("compose_labels", {}).get("com.docker.compose.config-hash"),
        maximum.get("compose_labels", {}).get("com.docker.compose.config-hash"),
    )
    if actual_hashes != expected_hashes:
        raise core.RuntimeFault("PAIR_COMPOSE_CONFIG_HASH_DRIFT", 74)
    database = _database_status(core, profile)
    if database["state"] != "EXACT":
        raise core.RuntimeFault("DATABASE_CHANGED_DURING_RELEASE", 74)
    unrelated = _unrelated_fingerprint(core, policy)
    if unrelated != state["unrelated_semantic_fingerprint_sha256"]:
        raise core.RuntimeFault("UNRELATED_SERVICE_CHANGED_DURING_RELEASE", 74)
    return {
        "pair_state": kind,
        "vector": list(vector),
        "gravity_container_id": gravity["container_id"],
        "gravity_image_id": gravity["image_id"],
        "gravity_compose_config_hash": actual_hashes[0],
        "max_container_id": maximum["container_id"],
        "max_image_id": maximum["image_id"],
        "max_compose_config_hash": actual_hashes[1],
        "max_volume_preserved": True,
        "database": database,
        "unrelated_services_unchanged": True,
        "healthy": True,
    }


def _validate_rollback_reference(core: Any, profile: dict[str, Any], component: str, reference: str) -> dict[str, Any]:
    """Resolve the operational rollback tag and bind it to the authorised predecessor image id.

    The tag is mutable and prunable, so it is never trusted on its own: it is resolved and
    compared to the sealed predecessor image id immediately before the rollback transaction.
    A missing, pruned or drifted reference fails closed before any Compose mutation, and no
    registry fallback is introduced -- `--pull never` semantics are unchanged.
    """
    record = profile["predecessor"]["gravity" if component == "gravity" else "max_scraper"]
    expected = record.get("image_id")
    if not isinstance(expected, str) or not expected:
        raise core.RuntimeFault("ROLLBACK_PREDECESSOR_PROFILE_INVALID", 78)
    image = _image_inspect(core, reference, required=False)
    if image is None:
        raise core.RuntimeFault(
            f"{component.upper()}_ROLLBACK_IMAGE_MISSING", 74, {"reference": reference, "expected_image_id": expected}
        )
    if image.get("Id") != expected:
        raise core.RuntimeFault(
            f"{component.upper()}_ROLLBACK_REFERENCE_DRIFT", 74, {"reference": reference, "expected_image_id": expected}
        )
    return image


def _assert_rollback_material(core: Any, profile: dict[str, Any]) -> dict[str, str]:
    gravity = _validate_rollback_reference(core, profile, "gravity", ROLLBACK_GRAVITY)
    maximum = _validate_rollback_reference(core, profile, "max", ROLLBACK_MAX)
    return {"gravity_image_id": gravity["Id"], "max_image_id": maximum["Id"]}


def _rollback_pair(core: Any, policy: dict[str, Any], profile: dict[str, Any], state: dict[str, Any]) -> tuple[dict[str, Any], bool]:
    gravity, maximum = _pair(core, policy, profile)
    kind, vector = _classify(profile, gravity, maximum)
    if kind == "UNKNOWN":
        raise core.RuntimeFault("UNKNOWN_PAIR_FAIL_CLOSED", 74, {"vector": list(vector)})
    # Every rollback transaction, automatic or requested, first proves Calling is disarmed on the
    # Gravity container it is about to replace.
    _assert_calling_b2_disarmed(core, gravity)
    mutated = kind != "PREDECESSOR_PAIR"
    if mutated:
        _assert_rollback_material(core, profile)
        _compose_up(core, profile, state, ROLLBACK_OVERLAY, activate=False)
    return _postcheck(core, policy, profile, state, "PREDECESSOR_PAIR"), mutated


def _release_preflight(core: Any, policy: dict[str, Any], profile: dict[str, Any], invocation: Any) -> dict[str, Any]:
    with _lock(core):
        if core.audit_status()["state"] not in {"EMPTY", "VALID"}:
            raise core.RuntimeFault("AUDIT_MUTATION_DISABLED", 78)
        state = _read_state(core)
        gravity, maximum = _pair(core, policy, profile)
        pair_state, vector = _classify(profile, gravity, maximum)
        if pair_state == "UNKNOWN":
            raise core.RuntimeFault("UNKNOWN_PAIR_FAIL_CLOSED", 74, {"vector": list(vector)})
        if pair_state == "TARGET_PAIR" and state.get("phase") == "ACTIVATED":
            post = _postcheck(core, policy, profile, state, "TARGET_PAIR")
            return {"profile_id": PROFILE_ID, "status": "ALREADY_ACTIVATED", "postcheck": post, "production_mutated": False}
        if pair_state == "MIXED_KNOWN":
            if state.get("phase") == "UNINITIALIZED":
                raise core.RuntimeFault("MIXED_PAIR_WITHOUT_PREFLIGHT_AUTHORITY", 74)
            # Refused before any intent is written, so an armed state is left exactly as found.
            _assert_calling_b2_disarmed(core, gravity)
            rollback, mutated, rollback_state = _rollback_with_fencing(
                core,
                policy,
                profile,
                invocation,
                state,
                intent_result="mixed_rollback_intent",
                failure_result="mixed_rollback_failed",
            )
            next_state = {**rollback_state, "phase": "ROLLED_BACK", "mixed_recovery_at": core.now()}
            _write_state(core, next_state)
            _audit(core, invocation, rollback_state, "mixed_rolled_back", next_state)
            return {"profile_id": PROFILE_ID, "status": "MIXED_STATE_ROLLED_BACK", "rollback": rollback, "production_mutated": mutated}
        if pair_state != "PREDECESSOR_PAIR":
            raise core.RuntimeFault("PREDECESSOR_PAIR_REQUIRED", 74)
        identity = _predecessor_identity(core, policy, profile, state)
        release_environment = _release_environment(core)
        calling_environment = _calling_b2_environment(core)
        receipt = _artifact_receipt(core, profile)
        for name in sorted(receipt["files"]):
            _artifact_path(core, profile, name, hash_content=True)
        gravity_archive = "gravity-image.docker.tar"
        max_archive = "max-scraper-image.docker.tar"
        max_pending = (
            [_archive_bytes(core, profile, max_archive)]
            if _image_inspect(core, TARGET_MAX, required=False) is None
            else []
        )
        gravity_pending = (
            [_archive_bytes(core, profile, gravity_archive)]
            if _image_inspect(core, TARGET_GRAVITY, required=False) is None
            else []
        )
        # The reserve is a floor on the release as a whole, not only on the loads: activation still
        # creates containers, writes layers and logs, and may have to run a rollback transaction.
        # Guard unconditionally here so a preflight that loads nothing is still refused on a full
        # filesystem, then again per load, then once more against the observed post-load state.
        _storage_guard(core, profile, [*gravity_pending, *max_pending], "preflight")
        target_gravity = _load_target(
            core, profile, "gravity", gravity_archive, TARGET_GRAVITY, remaining_bytes=max_pending
        )
        target_max = _load_target(core, profile, "max", max_archive, TARGET_MAX)
        storage = _storage_guard(core, profile, [], "post_load")
        _seal_rollback_reference(core, profile["predecessor"]["gravity"]["image_id"], ROLLBACK_GRAVITY, "gravity")
        _seal_rollback_reference(core, profile["predecessor"]["max_scraper"]["image_id"], ROLLBACK_MAX, "max")
        domains = _derive_compose_domains(core, profile, release_environment["value"], calling_environment["values"])
        next_state = {
            "schema": STATE_SCHEMA,
            "profile_id": PROFILE_ID,
            "phase": "PREFLIGHTED",
            "preflight_at": core.now(),
            "environment_sha256": identity["environment_sha256"],
            "release_environment_sha256": release_environment["sha256"],
            "calling_b2_environment_sha256": calling_environment["sha256"],
            "gravity_semantic": identity["gravity_semantic"],
            "max_semantic": identity["max_semantic"],
            "unrelated_semantic_fingerprint_sha256": identity["unrelated_semantic_fingerprint_sha256"],
            "database_identity_sha256": identity["database"]["database_identity_sha256"],
            "migration_rows_sha256": identity["database"]["migration_rows_sha256"],
            "target_gravity_image_id": target_gravity["Id"],
            "target_max_image_id": target_max["Id"],
            "predecessor_instance": identity["predecessor_instance"],
            "predecessor_instance_at": core.now(),
            **domains,
        }
        _write_state(core, next_state)
        _audit(core, invocation, state, "ok", next_state)
        return {
            "profile_id": PROFILE_ID,
            "status": "PREFLIGHTED",
            "pair_state": "PREDECESSOR_PAIR",
            "target_gravity_image_id": target_gravity["Id"],
            "target_max_image_id": target_max["Id"],
            "artifact_receipt_sha256": profile["artifact_admission"]["receipt_sha256"],
            "max_volume_preserved": True,
            "database": identity["database"],
            "storage": storage,
            "production_mutated": False,
        }


def _activation_failure(core: Any, failure: BaseException) -> dict[str, Any]:
    if isinstance(failure, core.RuntimeFault):
        return {"code": failure.code, "details": failure.details if isinstance(failure.details, dict) else {}}
    return {"code": "INTERNAL_ACTIVATION_FAILURE", "details": {}}


def _rollback_with_fencing(
    core: Any,
    policy: dict[str, Any],
    profile: dict[str, Any],
    invocation: Any,
    state: dict[str, Any],
    *,
    intent_result: str,
    failure_result: str,
) -> tuple[dict[str, Any], bool, dict[str, Any]]:
    intent_state = {
        **state,
        "phase": "ROLLBACK_INTENT",
        "rollback_intent_at": core.now(),
    }
    _write_state(core, intent_state)
    _audit(core, invocation, state, intent_result, intent_state)
    try:
        rollback, mutated = _rollback_pair(core, policy, profile, intent_state)
    except Exception as failure:
        failed_state = {
            **intent_state,
            "phase": "ROLLBACK_FAILED",
            "rollback_failure": _activation_failure(core, failure),
            "rollback_failed_at": core.now(),
            "rollback_diagnostics": _log_evidence(core, ROLLBACK_COMPOSE_LOG, core.now()),
        }
        # The Compose transaction may already have recreated the pair before the postcheck failed,
        # in which case the sealed instance no longer describes anything that is running.
        observed = _observed_instance(core, policy, profile)
        if observed is not None:
            failed_state["predecessor_instance"] = observed
            failed_state["predecessor_instance_at"] = core.now()
        _write_state(core, failed_state)
        _audit(core, invocation, intent_state, failure_result, failed_state)
        raise
    # Record on both paths, not only when this call recreated the containers. A rollback whose
    # Compose transaction completed but whose process died before the terminal state write leaves
    # recreated containers with nothing recorded; the operator's next rollback then finds the pair
    # already correct, mutates nothing, and must still be able to register what is live or the
    # release stays one-shot. This is safe because _rollback_pair only returns after _postcheck
    # validated the pair against the sealed profile, so the value recorded is an observation the
    # runtime just proved, not one it merely found.
    recorded_state = {**intent_state}
    observed = {
        "gravity": {
            "container_id": rollback.get("gravity_container_id"),
            "compose_config_hash": rollback.get("gravity_compose_config_hash"),
        },
        "max_scraper": {
            "container_id": rollback.get("max_container_id"),
            "compose_config_hash": rollback.get("max_compose_config_hash"),
        },
    }
    # An incomplete observation must never displace a record that is already usable.
    if all(isinstance(value, str) and value for side in observed.values() for value in side.values()):
        recorded_state["predecessor_instance"] = observed
        recorded_state["predecessor_instance_at"] = core.now()
    if mutated:
        recorded_state["rollback_diagnostics"] = _log_evidence(core, ROLLBACK_COMPOSE_LOG, core.now())
    return rollback, mutated, recorded_state


def _release_activate(core: Any, policy: dict[str, Any], profile: dict[str, Any], invocation: Any) -> dict[str, Any]:
    with _lock(core):
        if core.audit_status()["state"] not in {"EMPTY", "VALID"}:
            raise core.RuntimeFault("AUDIT_MUTATION_DISABLED", 78)
        state = _read_state(core)
        if state.get("phase") not in {"PREFLIGHTED", "ACTIVATION_INTENT", "ACTIVATED", "ROLLED_BACK"}:
            raise core.RuntimeFault("RELEASE_PREFLIGHT_REQUIRED", 77)
        gravity, maximum = _pair(core, policy, profile)
        pair_state, vector = _classify(profile, gravity, maximum)
        if pair_state == "UNKNOWN":
            raise core.RuntimeFault("UNKNOWN_PAIR_FAIL_CLOSED", 74, {"vector": list(vector)})
        if pair_state == "TARGET_PAIR":
            try:
                post = _postcheck(core, policy, profile, state, "TARGET_PAIR")
            except Exception as failure:
                activation = _activation_failure(core, failure)
                refusal = _calling_b2_rollback_refusal(core, gravity)
                if refusal is not None and state.get("phase") == "ACTIVATED":
                    # A re-check of an already activated release cannot roll back while Calling is armed,
                    # so it only reports: the confirmed release state is left exactly as found.
                    raise core.RuntimeFault(
                        "ACTIVATED_POSTCHECK_FAILED_ROLLBACK_REFUSED",
                        74,
                        {"activation_failure": activation, "rollback_refusal": refusal},
                    )
                failed_state = {
                    **state,
                    "phase": "ACTIVATION_FAILED",
                    "activation_failure": activation,
                    "activation_failed_at": core.now(),
                }
                if refusal is not None:
                    failed_state["automatic_rollback_refusal"] = refusal
                _write_state(core, failed_state)
                _audit(
                    core, invocation, state,
                    "target_postcheck_failed" if refusal is None else "target_postcheck_failed_rollback_refused_calling_b2",
                    failed_state,
                )
                if refusal is not None:
                    raise core.RuntimeFault(
                        "ACTIVATION_FAILED_AUTOMATIC_ROLLBACK_REFUSED",
                        74,
                        {"activation_failure": activation, "rollback_refusal": refusal},
                    )
                try:
                    rollback, mutated, rollback_state = _rollback_with_fencing(
                        core,
                        policy,
                        profile,
                        invocation,
                        failed_state,
                        intent_result="target_rollback_intent",
                        failure_result="target_postcheck_and_rollback_failed",
                    )
                except Exception as rollback_failure:
                    rollback_identity = _activation_failure(core, rollback_failure)
                    raise core.RuntimeFault(
                        "ACTIVATION_AND_AUTOMATIC_ROLLBACK_FAILED",
                        74,
                        {"activation_failure": activation, "rollback_failure": rollback_identity},
                    )
                next_state = {**rollback_state, "phase": "ROLLED_BACK", "rollback_at": core.now()}
                _write_state(core, next_state)
                _audit(core, invocation, rollback_state, "target_postcheck_failed_rolled_back", next_state)
                raise core.RuntimeFault("ACTIVATION_FAILED_AUTOMATIC_ROLLBACK_OK", 74, {"activation_failure": activation, "rollback": rollback, "production_mutated": mutated})
            next_state = {**state, "phase": "ACTIVATED", "activation_completed_at": core.now()}
            _write_state(core, next_state)
            _audit(core, invocation, state, "recovered_ok", next_state)
            return {"profile_id": PROFILE_ID, "status": "ACTIVATED_RECOVERED" if state.get("phase") == "ACTIVATION_INTENT" else "ALREADY_ACTIVATED", "postcheck": post, "production_mutated": False}
        if pair_state == "MIXED_KNOWN":
            _assert_calling_b2_disarmed(core, gravity)
            rollback, mutated, rollback_state = _rollback_with_fencing(
                core,
                policy,
                profile,
                invocation,
                state,
                intent_result="mixed_rollback_intent",
                failure_result="mixed_rollback_failed",
            )
            next_state = {**rollback_state, "phase": "ROLLED_BACK", "mixed_recovery_at": core.now()}
            _write_state(core, next_state)
            _audit(core, invocation, rollback_state, "mixed_rolled_back", next_state)
            return {"profile_id": PROFILE_ID, "status": "MIXED_STATE_ROLLED_BACK_RECOVERED", "rollback": rollback, "production_mutated": mutated}
        if state.get("phase") in {"ACTIVATED", "ROLLED_BACK"}:
            raise core.RuntimeFault("FRESH_PREFLIGHT_REQUIRED", 77)
        _validate_compose_inputs(core, profile, state)
        _validate_target_image(core, profile["target"]["gravity"], TARGET_GRAVITY, "gravity")
        _validate_target_image(core, profile["target"]["max_scraper"], TARGET_MAX, "max")
        # A removed or changed release source is refused here, before the intent write, so it costs
        # no Compose transaction and no automatic rollback. _compose_up re-checks it at the boundary.
        _validate_release_environment(core, state)
        _validate_calling_b2_environment(core, state)
        before = state
        if state.get("phase") == "PREFLIGHTED":
            state = {**state, "phase": "ACTIVATION_INTENT", "activation_intent_at": core.now()}
            _write_state(core, state)
            _audit(core, invocation, before, "intent", state)
        try:
            _compose_up(core, profile, state, ACTIVATE_OVERLAY, activate=True)
            post = _postcheck(core, policy, profile, state, "TARGET_PAIR")
            next_state = {**state, "phase": "ACTIVATED", "activation_completed_at": core.now()}
            _write_state(core, next_state)
            _audit(core, invocation, state, "ok", next_state)
            return {"profile_id": PROFILE_ID, "status": "ACTIVATED", "postcheck": post, "production_mutated": True, "automatic_rollback": False}
        except Exception as failure:
            activation = _activation_failure(core, failure)
            # Captured before any rollback runs: the rollback writes its own separate log, so
            # the activation transcript that explains this failure survives the recovery.
            activation_diagnostics = _log_evidence(core, ACTIVATE_COMPOSE_LOG, core.now())
            current_gravity, current_max = _pair(core, policy, profile)
            current_kind, current_vector = _classify(profile, current_gravity, current_max)
            # Decided before any rollback intent: an armed or unproven Calling kill switch forbids it.
            refusal = None if current_kind == "UNKNOWN" else _calling_b2_rollback_refusal(core, current_gravity)
            failed_state = {
                **state,
                "phase": "ACTIVATION_FAILED",
                "activation_failure": activation,
                "activation_failed_at": core.now(),
                "activation_diagnostics": activation_diagnostics,
            }
            if refusal is not None:
                failed_state["automatic_rollback_refusal"] = refusal
            _write_state(core, failed_state)
            if current_kind == "UNKNOWN":
                _audit(core, invocation, state, "failed_unknown_fail_closed", failed_state)
                raise core.RuntimeFault("ACTIVATION_FAILED_UNKNOWN_STATE_NOT_OVERWRITTEN", 74, {"activation_failure": activation, "vector": list(current_vector)})
            if refusal is not None:
                _audit(core, invocation, state, "failed_rollback_refused_calling_b2", failed_state)
                raise core.RuntimeFault(
                    "ACTIVATION_FAILED_AUTOMATIC_ROLLBACK_REFUSED",
                    74,
                    {"activation_failure": activation, "rollback_refusal": refusal},
                )
            try:
                rollback, mutated, rollback_state = _rollback_with_fencing(
                    core,
                    policy,
                    profile,
                    invocation,
                    failed_state,
                    intent_result="activation_rollback_intent",
                    failure_result="activation_and_rollback_failed",
                )
            except Exception as rollback_failure:
                rollback_identity = _activation_failure(core, rollback_failure)
                raise core.RuntimeFault("ACTIVATION_AND_AUTOMATIC_ROLLBACK_FAILED", 74, {"activation_failure": activation, "rollback_failure": rollback_identity})
            terminal = {**rollback_state, "phase": "ROLLED_BACK", "rollback_at": core.now()}
            _write_state(core, terminal)
            _audit(core, invocation, rollback_state, "failed_rolled_back", terminal)
            raise core.RuntimeFault("ACTIVATION_FAILED_AUTOMATIC_ROLLBACK_OK", 74, {"activation_failure": activation, "rollback": rollback, "production_mutated": mutated})


def _rollback(core: Any, policy: dict[str, Any], profile: dict[str, Any], invocation: Any) -> dict[str, Any]:
    with _lock(core):
        if core.audit_status()["state"] not in {"EMPTY", "VALID"}:
            raise core.RuntimeFault("AUDIT_MUTATION_DISABLED", 78)
        state = _read_state(core)
        if state.get("phase") == "UNINITIALIZED":
            raise core.RuntimeFault("ROLLBACK_NOT_AVAILABLE_BEFORE_PREFLIGHT", 77)
        gravity, maximum = _pair(core, policy, profile)
        pair_state, vector = _classify(profile, gravity, maximum)
        if pair_state == "UNKNOWN":
            raise core.RuntimeFault("UNKNOWN_PAIR_FAIL_CLOSED", 74, {"vector": list(vector)})
        # An armed Calling kill switch refuses the rollback before its intent is written, so the
        # release state is left exactly as found until a separate disarm is authorized.
        _assert_calling_b2_disarmed(core, gravity)
        post, mutated, rollback_state = _rollback_with_fencing(
            core,
            policy,
            profile,
            invocation,
            state,
            intent_result="rollback_intent",
            failure_result="rollback_failed",
        )
        next_state = {**rollback_state, "phase": "ROLLED_BACK", "rollback_at": core.now()}
        _write_state(core, next_state)
        _audit(core, invocation, rollback_state, "ok", next_state)
        return {"profile_id": PROFILE_ID, "status": "ROLLED_BACK" if mutated else "ALREADY_ROLLED_BACK", "postcheck": post, "production_mutated": mutated}


def dispatch(core: Any, policy: dict[str, Any], invocation: Any) -> dict[str, Any]:
    profile = _load_profile(core)
    if invocation.resource is not None or invocation.relative_path is not None:
        raise core.RuntimeFault("PROFILE_ARGUMENTS_FORBIDDEN", 64)
    if invocation.primitive == "database-status":
        with _lock(core):
            return _database_status(core, profile)
    if invocation.primitive == "release-preflight":
        return _release_preflight(core, policy, profile, invocation)
    if invocation.primitive == "release-activate":
        return _release_activate(core, policy, profile, invocation)
    if invocation.primitive == "rollback":
        return _rollback(core, policy, profile, invocation)
    raise core.RuntimeFault("PROFILE_DISABLED", 77, {"profile": invocation.primitive.replace("-", "_")})
