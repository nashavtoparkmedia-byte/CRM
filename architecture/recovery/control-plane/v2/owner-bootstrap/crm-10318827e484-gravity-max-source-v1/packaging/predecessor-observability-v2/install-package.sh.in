#!/bin/sh
# Install predecessor observation v2 as a same-version 2.0.0-21 interim
# package.  Zero arguments, root only, idempotent; any failure reinstalls the
# exact original 2.0.0-21 package.  No container, database or Compose action.
set -eu
umask 077

PACKAGE_PATH='@PACKAGE_PATH@'
PACKAGE_SHA256='@PACKAGE_SHA256@'
SOURCE_COMMIT='@SOURCE_COMMIT@'
VERSION='2.0.0-21'
PROFILE_ID='crm-ba90ed4b6717-gravity-max-source-v1'
RUNTIME='/usr/local/sbin/yoko-privileged-runtime'
CORE='/usr/local/libexec/yoko-privileged-runtime/core-2.0.0.py'
OBSERVER='/usr/local/libexec/yoko-privileged-runtime/predecessor-observability-v1.py'
POLICY='/usr/local/share/yoko-privileged-runtime/policy.v2.json'
SUDOERS='/etc/sudoers.d/92-yoko-privileged-runtime'
INSTALL_MANIFEST='/usr/local/share/yoko-privileged-runtime/install-manifest.v1.json'
PROFILE_RUNTIME="/usr/local/libexec/yoko-privileged-runtime/$PROFILE_ID.py"
PROFILE_ROOT="/usr/local/share/yoko-privileged-runtime/profiles/$PROFILE_ID"
STORE='/var/lib/yoko-privileged-runtime/activation-bootstraps'
ROLLBACK_DEB_SHA256='17b97c4048fb8cce2ab5d43aff23e7542397678c8abd7c8b8790cca26db2f35a'
ROLLBACK_DEB="$STORE/$ROLLBACK_DEB_SHA256/yoko-privileged-runtime_2.0.0-21_all.deb"
INTERIM_STORE="$STORE/$PACKAGE_SHA256"
INTERIM_DEB="$INTERIM_STORE/yoko-privileged-runtime_2.0.0-21_all.deb"
BOOTSTRAP_GUARD='/var/lib/yoko-privileged-runtime/activation-bootstrap-installing.v1'
BOOTSTRAP_LOCK_DIR='/run/lock/yoko-privileged-runtime'
BOOTSTRAP_LOCK="$BOOTSTRAP_LOCK_DIR/coordinated-bootstrap.lock"

OLD_RUNTIME_SHA256='e4c327c3b397ffeac8c47f5b7ddb6b2a7b4e0cbcdd5e737560a615724468b1f0'
OLD_OBSERVER_SHA256='b5ea36c50e12b0fe6c171896258ddfc00a9d2666778735cae6a9b2a8df6d4084'
OLD_INSTALL_MANIFEST_SHA256='a96ca3929174692056a5550acc970f1f5bd987f4d429e91078994d2f58a10bd3'
NEW_RUNTIME_SHA256='@NEW_RUNTIME_SHA256@'
NEW_OBSERVER_SHA256='@NEW_OBSERVER_SHA256@'
NEW_INSTALL_MANIFEST_SHA256='@NEW_INSTALL_MANIFEST_SHA256@'
CORE_SHA256='0f97bafbfe5b430fa7994119b1fc76fead4bdbee26766c730d9e399551ebdffa'
POLICY_SHA256='8727373b0c6ec79c9abf82f1aaaa58abc2bae67e96aa96a602ac419f308db0e0'
SUDOERS_SHA256='3022dcfc323706da81e760255dd1ab43f9b8662ee699aa8b58fbe6e714cc69d7'
PROFILE_RUNTIME_SHA256='334603195d4cdfc70513637e29d6b73c57c7050a6bd331402cc0696cee27fa10'
PROFILE_MANIFEST_SHA256='743e22164a8101a2a1d049b1581cf39da0b36c200b9303dab0af29b0480cec2a'
PROFILE_JSON_SHA256='97dd62ea7fba53a3d7c382b723bf131b63a3dc091688de1bf4882471d4c65274'
SEALED_INPUTS_SHA256='fd87a49e428f0099372edd3e37cef3bd8a7cb7731c615e83ed22e033b702745a'

if [ "$#" -ne 0 ] || [ "$(/usr/bin/id -u)" != 0 ] || [ "$(/usr/bin/id -ru)" != 0 ]; then
    echo 'OWNER_ROOT_ZERO_ARGUMENT_REQUIRED' >&2
    exit 77
fi

hash_is() {
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(/usr/bin/stat -c '%h' "$1")" = 1 ] \
        && [ "$(/usr/bin/sha256sum "$1" | /usr/bin/cut -d ' ' -f 1)" = "$2" ]
}

package_identity_ok() {
    hash_is "$1" "$PACKAGE_SHA256" \
        && [ "$(/usr/bin/dpkg-deb -f "$1" Package) $(/usr/bin/dpkg-deb -f "$1" Version) $(/usr/bin/dpkg-deb -f "$1" Architecture)" = "yoko-privileged-runtime $VERSION all" ]
}

# PACKAGE_PATH lives in the unprivileged builder's tree. Copy it once into a
# root-private directory and verify and use only that copy, so the bytes that
# are checked are the bytes that are stored and installed.
private_copy() {
    /usr/bin/python3 -I - "$1" "$2" <<'PY'
import os,stat,sys
source,destination=sys.argv[1:]
src=os.open(source,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW|os.O_NONBLOCK)
try:
    if not stat.S_ISREG(os.fstat(src).st_mode): raise SystemExit('package source is not a regular file')
    dst=os.open(destination,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_CLOEXEC|os.O_NOFOLLOW,0o400)
    try:
        while chunk:=os.read(src,1024*1024):
            os.write(dst,chunk)
        os.fchown(dst,0,0); os.fchmod(dst,0o400); os.fsync(dst)
    finally:
        os.close(dst)
finally:
    os.close(src)
PY
}

stored_exact() {
    [ -d "$1" ] && [ ! -L "$1" ] \
        && [ "$(/usr/bin/stat -c '%u:%g:%a' "$1")" = '0:0:700' ] \
        && [ "$(/usr/bin/find "$1" -mindepth 1 -maxdepth 1 -printf '%f\n')" = "$(/usr/bin/basename "$2")" ] \
        && [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$2")" = '0:0:400:1' ] \
        && hash_is "$2" "$3"
}

preserved_ok() {
    [ "$(/usr/bin/dpkg-query -W -f='${Status} ${Version}\n' yoko-privileged-runtime 2>/dev/null)" = "install ok installed $VERSION" ] \
        && hash_is "$CORE" "$CORE_SHA256" \
        && hash_is "$POLICY" "$POLICY_SHA256" \
        && hash_is "$SUDOERS" "$SUDOERS_SHA256" \
        && hash_is "$PROFILE_RUNTIME" "$PROFILE_RUNTIME_SHA256" \
        && hash_is "$PROFILE_ROOT/manifest.v1.json" "$PROFILE_MANIFEST_SHA256" \
        && hash_is "$PROFILE_ROOT/profile.v1.json" "$PROFILE_JSON_SHA256" \
        && hash_is "$PROFILE_ROOT/sealed-inputs.v1.json" "$SEALED_INPUTS_SHA256"
}

old_state_ok() {
    preserved_ok \
        && hash_is "$RUNTIME" "$OLD_RUNTIME_SHA256" \
        && hash_is "$OBSERVER" "$OLD_OBSERVER_SHA256" \
        && hash_is "$INSTALL_MANIFEST" "$OLD_INSTALL_MANIFEST_SHA256"
}

new_state_ok() {
    preserved_ok \
        && hash_is "$RUNTIME" "$NEW_RUNTIME_SHA256" \
        && hash_is "$OBSERVER" "$NEW_OBSERVER_SHA256" \
        && hash_is "$INSTALL_MANIFEST" "$NEW_INSTALL_MANIFEST_SHA256"
}

runtime_json() {
    /usr/sbin/runuser -u codexbot -- /usr/bin/sudo -n "$RUNTIME" "$@"
}

self_check_is() {
    runtime_json self-check | /usr/bin/python3 -I -c 'import json,sys; v=json.load(sys.stdin); e=v["evidence"]; raise SystemExit(0 if v["ok"] is True and e["package_version"] == "2.0.0-21" and e["activation_profile_id"] == "crm-ba90ed4b6717-gravity-max-source-v1" and e["predecessor_observability_sha256"] == sys.argv[1] and e["coordinated_pair"] == ["gravity-mvp","max-web-scraper"] else 1)' "$1" \
        && runtime_json capabilities | /usr/bin/python3 -I -c 'import json,sys; v=json.load(sys.stdin); e=v["evidence"]; raise SystemExit(0 if v["ok"] is True and e["activation_profile_id"] == "crm-ba90ed4b6717-gravity-max-source-v1" and e["enabled_read_only_profiles"] == ["predecessor-observe"] and e["enabled_activation_profiles"] == ["database-status","release-preflight","release-activate","rollback"] else 1)'
}

capture_identity() {
    destination=$1
    : > "$destination"
    for resource in crm.container.gravity_mvp crm.container.telegram_bot crm.container.max_scraper crm.container.postgres; do
        runtime_json docker-inspect "$resource" | /usr/bin/python3 -I -c '
import json,sys
v=json.load(sys.stdin); e=v["evidence"]
assert v["ok"] is True and v["primitive"]=="docker-inspect" and v["resource"]==sys.argv[1]
print(json.dumps({k:e[k] for k in ("logical_resource","container_id","image_id","created","started_at","restart_count","mounts","entrypoint","cmd")} | {"config_hash":e["compose_labels"]["com.docker.compose.config-hash"]},sort_keys=True,separators=(",",":")))' "$resource" >> "$destination" || return 1
    done
    runtime_json audit-status | /usr/bin/python3 -I -c '
import json,sys
v=json.load(sys.stdin); e=v["evidence"]
assert v["ok"] is True and e["state"]=="VALID"
print(json.dumps({"audit_records":e["record_count"],"audit_last":e["last_digest"]},sort_keys=True))' >> "$destination" || return 1
}

store_interim() {
    if [ -e "$INTERIM_STORE" ] || [ -L "$INTERIM_STORE" ]; then
        stored_exact "$INTERIM_STORE" "$INTERIM_DEB" "$PACKAGE_SHA256" || return 1
        return 0
    fi
    # Publish atomically: build and verify in a root-only staging directory in
    # the same store, then rename. A partial copy never occupies the
    # content-addressed name.
    staging=$(/usr/bin/mktemp -d "$STORE/.interim-staging.XXXXXX") || return 1
    if ! /usr/bin/python3 -I - "$PRIVATE_PACKAGE" "$staging/yoko-privileged-runtime_2.0.0-21_all.deb" <<'PY'
import os,sys
source,destination=sys.argv[1:]
src=os.open(source,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW)
dst=os.open(destination,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_CLOEXEC|os.O_NOFOLLOW,0o400)
try:
    while chunk:=os.read(src,1024*1024):
        os.write(dst,chunk)
    os.fchown(dst,0,0); os.fchmod(dst,0o400); os.fsync(dst)
finally:
    os.close(src); os.close(dst)
PY
    then
        /usr/bin/rm -rf -- "$staging"
        return 1
    fi
    if ! stored_exact "$staging" "$staging/yoko-privileged-runtime_2.0.0-21_all.deb" "$PACKAGE_SHA256" \
        || ! /usr/bin/mv -T -- "$staging" "$INTERIM_STORE"; then
        /usr/bin/rm -rf -- "$staging"
        return 1
    fi
    stored_this_run=1
    stored_exact "$INTERIM_STORE" "$INTERIM_DEB" "$PACKAGE_SHA256" || return 1
}

forget_store() {
    # Only an entry this run created, and only after the original is back:
    # store presence then always means the interim package was installed.
    if [ "$stored_this_run" = 1 ] && stored_exact "$INTERIM_STORE" "$INTERIM_DEB" "$PACKAGE_SHA256"; then
        /usr/bin/unlink "$INTERIM_DEB" && /usr/bin/rmdir "$INTERIM_STORE" && stored_this_run=0
    fi
}

rollback_exact() {
    stored_exact "$STORE/$ROLLBACK_DEB_SHA256" "$ROLLBACK_DEB" "$ROLLBACK_DEB_SHA256" \
        && DEBIAN_FRONTEND=noninteractive /usr/bin/dpkg --install "$ROLLBACK_DEB" >/dev/null \
        && old_state_ok && self_check_is "$OLD_OBSERVER_SHA256"
}

attempted=0
handled=0
stored_this_run=0
WORK=''
cleanup() {
    case "$WORK" in
        /var/tmp/yoko-predecessor-observability-v2-install.*)
            /usr/bin/find "$WORK" -type f -exec /usr/bin/unlink {} \;
            /usr/bin/rmdir "$WORK"
            ;;
    esac
}
on_exit() {
    rc=$?
    trap - EXIT
    if [ "$rc" -ne 0 ] && [ "$attempted" = 1 ] && [ "$handled" = 0 ]; then
        handled=1
        if rollback_exact; then
            forget_store || true
            echo 'INTERRUPTED_ROLLED_BACK' >&2
        else
            echo 'INTERRUPTED_ROLLBACK_FAILED' >&2
        fi
    fi
    cleanup
    exit "$rc"
}
trap on_exit EXIT
trap 'exit 129' HUP INT TERM

WORK=$(/usr/bin/mktemp -d /var/tmp/yoko-predecessor-observability-v2-install.XXXXXX)
if [ "$(/usr/bin/stat -c '%u:%g:%a' "$WORK")" != '0:0:700' ]; then
    echo 'PRIVATE_WORK_DIRECTORY_UNSAFE' >&2
    exit 78
fi
PRIVATE_PACKAGE="$WORK/package.deb"
private_copy "$PACKAGE_PATH" "$PRIVATE_PACKAGE" || { echo 'OBSERVABILITY_PACKAGE_COPY_FAILED' >&2; exit 78; }
if ! package_identity_ok "$PRIVATE_PACKAGE"; then
    echo 'OBSERVABILITY_PACKAGE_IDENTITY_INVALID' >&2
    exit 78
fi
if ! stored_exact "$STORE/$ROLLBACK_DEB_SHA256" "$ROLLBACK_DEB" "$ROLLBACK_DEB_SHA256"; then
    echo 'ROLLBACK_PACKAGE_NOT_EXACT' >&2
    exit 78
fi

# BEGIN BOOTSTRAP LOCK
# Serialise with every coordinated bootstrap installer. /run/lock is
# world-writable, so the directory must be proven root-owned 0700 and not a
# link before anything is opened inside it; each gate is its own aborting test.
if [ ! -e "$BOOTSTRAP_LOCK_DIR" ] && [ ! -L "$BOOTSTRAP_LOCK_DIR" ]; then
    /usr/bin/mkdir -m 0700 "$BOOTSTRAP_LOCK_DIR" || { echo 'BOOTSTRAP_LOCK_DIRECTORY_UNSAFE' >&2; exit 78; }
fi
if [ -L "$BOOTSTRAP_LOCK_DIR" ] || [ ! -d "$BOOTSTRAP_LOCK_DIR" ]; then
    echo 'BOOTSTRAP_LOCK_DIRECTORY_UNSAFE' >&2
    exit 78
fi
if [ "$(/usr/bin/stat -c '%u:%g:%a' "$BOOTSTRAP_LOCK_DIR")" != '0:0:700' ]; then
    echo 'BOOTSTRAP_LOCK_DIRECTORY_UNSAFE' >&2
    exit 78
fi
exec 9>"$BOOTSTRAP_LOCK"
if [ -L "$BOOTSTRAP_LOCK" ] || [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$BOOTSTRAP_LOCK")" != '0:0:600:1' ]; then
    echo 'BOOTSTRAP_LOCK_FILE_UNSAFE' >&2
    exit 78
fi
/usr/bin/flock -x -w 30 9 || { echo 'BOOTSTRAP_LOCK_BUSY' >&2; exit 75; }
# END BOOTSTRAP LOCK
if [ -e "$BOOTSTRAP_GUARD" ] || [ -L "$BOOTSTRAP_GUARD" ]; then
    echo 'ACTIVATION_BOOTSTRAP_IN_PROGRESS' >&2
    exit 75
fi

if new_state_ok; then
    self_check_is "$NEW_OBSERVER_SHA256" || { echo 'INSTALLED_INTERIM_SELF_CHECK_FAILED' >&2; exit 78; }
    store_interim || { echo 'INTERIM_PACKAGE_STORE_FAILED' >&2; exit 74; }
    echo "PREDECESSOR_OBSERVABILITY_V2_ALREADY_INSTALLED source=$SOURCE_COMMIT package=$PACKAGE_SHA256"
    exit 0
fi
if ! old_state_ok || ! self_check_is "$OLD_OBSERVER_SHA256"; then
    echo 'INSTALLED_RUNTIME_PRESTATE_MISMATCH' >&2
    exit 78
fi

fail() {
    reason=$1
    handled=1
    if rollback_exact && capture_identity "$WORK/rolled-back" && /usr/bin/cmp -s "$WORK/before" "$WORK/rolled-back"; then
        forget_store || true
        echo "${reason}_ROLLED_BACK" >&2
    else
        echo "${reason}_ROLLBACK_FAILED" >&2
    fi
    exit 74
}

capture_identity "$WORK/before" || { echo 'PRODUCTION_IDENTITY_CAPTURE_FAILED' >&2; exit 74; }
store_interim || { echo 'INTERIM_PACKAGE_STORE_FAILED' >&2; exit 74; }
attempted=1
package_identity_ok "$PRIVATE_PACKAGE" || fail OBSERVABILITY_PACKAGE_IDENTITY_CHANGED
DEBIAN_FRONTEND=noninteractive /usr/bin/dpkg --install "$PRIVATE_PACKAGE" >/dev/null || fail OBSERVABILITY_INSTALL_FAILED
{ new_state_ok && self_check_is "$NEW_OBSERVER_SHA256"; } || fail OBSERVABILITY_INSTALL_VERIFICATION_FAILED
capture_identity "$WORK/after" || fail PRODUCTION_IDENTITY_CAPTURE_FAILED
/usr/bin/cmp -s "$WORK/before" "$WORK/after" || fail PRODUCTION_OR_AUDIT_IDENTITY_CHANGED
attempted=0

echo "PREDECESSOR_OBSERVABILITY_V2_INSTALLED source=$SOURCE_COMMIT package=$PACKAGE_SHA256 stored=$INTERIM_DEB production_mutated=false"
