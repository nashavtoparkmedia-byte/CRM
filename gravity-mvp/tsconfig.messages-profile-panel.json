{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "paths": {
      "@/app/messages/components/DriverTasksWidget": ["./typecheck/messages-profile-panel/DriverTasksWidget.tsx"],
      "@/app/tasks/components/TaskCreateModal": ["./typecheck/messages-profile-panel/TaskCreateModal.tsx"],
      "@/*": ["./src/*"]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/lib/contact-profile-contract.ts",
    "src/lib/contact-profile-fields.ts",
    "src/lib/telegram-bot-profile-state.ts",
    "src/app/api/contacts/[id]/route.ts",
    "src/app/api/bot-link/route.ts",
    "src/app/messages/hooks/useContact.ts",
    "src/app/messages/components/ContactChannelRow.tsx",
    "src/app/messages/components/ContactProfileDrawer.tsx",
    "src/lib/__tests__/contact-profile-fields.test.ts",
    "src/lib/__tests__/telegram-bot-profile-state.test.ts",
    "src/lib/__tests__/bot-link-route.test.ts",
    "src/lib/__tests__/messages-inline-help-contract.test.ts",
    "src/app/messages/components/ContactChannelRow.test.tsx",
    "typecheck/messages-profile-panel/DriverTasksWidget.tsx",
    "typecheck/messages-profile-panel/TaskCreateModal.tsx"
  ],
  "exclude": []
}
