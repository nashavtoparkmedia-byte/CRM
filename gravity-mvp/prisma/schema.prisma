  needs_review  // зарезервировано
}

enum AiKnowledgeSafety {
  normal           // обычный факт
  sensitive        // тарифы, деньги, юр. условия — более жёсткий порог
  requires_human   // никогда не отвечаем сами, всегда escalate
}

enum AiKnowledgeSourceOrigin {
  chat_message      // MVP использует только это
