generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiConnection {
  id        String   @id @default(cuid())
  clid      String
  apiKey    String
  parkId    String
  createdAt DateTime @default(now())
  logs      ApiLog[]
}

model ApiLog {
  id           String        @id @default(cuid())
  connectionId String
  method       String
  requestUrl   String
  requestBody  String?
  responseBody String?
  statusCode   Int
  error        String?
  durationMs   Int
  createdAt    DateTime      @default(now())
  connection   ApiConnection @relation(fields: [connectionId], references: [id])
}

/// Tracks the latest sync status for each external service (Yandex Fleet, etc).
/// One row per service. Updated each time a sync runs (auto cron or manual).
model SyncStatus {
  service        String   @id            // e.g. "yandex_fleet"
  lastRunAt      DateTime                // when the sync most recently finished (success or error)
  status         String                  // "success" | "error" | "running"
  errorMessage   String?                 // populated when status = "error"
  driversUpdated Int?                    // optional metric — drivers upserted
  ordersProcessed Int?                   // optional metric — trip orders processed
  updatedAt      DateTime @updatedAt
}

model TelegramConnection {
  id            String   @id @default(cuid())
  apiId         Int
  apiHash       String
  sessionString String?
  isActive      Boolean  @default(false)
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDefault     Boolean  @default(false)
  name          String?
}

model MaxConnection {
  id        String   @id
  name      String?
  botToken  String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverMax {
  id                String   @id @default(cuid())
  driverId          String   @unique
  maxExternalUserId String?
  maxExternalChatId String?
  phone             String?
  name              String?
  createdAt         DateTime @default(now())
  driver            Driver   @relation(fields: [driverId], references: [id])

  @@index([maxExternalUserId])
  @@index([maxExternalChatId])
}

model MaxPersonalSession {
  id                      String               @id @default(cuid())
  historyImportMode       MaxHistoryImportMode @default(from_connection_time)
  connectedAt             DateTime?
  historySyncModeResolved MaxHistorySyncMode?
  historySyncStatus       MaxHistorySyncStatus @default(not_started)
  initialSyncCompletedAt  DateTime?
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model WhatsAppConnection {
  id          String                   @id @default(cuid())
  name        String?
  status      WhatsAppConnectionStatus @default(idle)
  phoneNumber String?
  sessionData String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  chats       WhatsAppChat[]
}

model WhatsAppChat {
  id            String             @id
  connectionId  String
  name          String?
  lastMessageAt DateTime?
  connection    WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages      WhatsAppMessage[]

  @@unique([id, connectionId])
}

model WhatsAppMessage {
  id            String              @id
  chatId        String
  body          String
  fromMe        Boolean
  timestamp     DateTime
  type          WhatsAppMessageType @default(chat)
  mediaPath     String?
  isMediaLoaded Boolean             @default(false)
  mediaSize     Int?
  chat          WhatsAppChat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([id, chatId])
}

// Persistent chat directory — survives WhatsAppChat/Message deletion.
// Used as anchor for Baileys fetchMessageHistory (backfill without QR re-scan).
// Populated on every incoming message + messaging-history.set events.
model WhatsAppChatRoster {
  id              String   @id @default(cuid())
  connectionId    String
  jid             String   // 79221853150@s.whatsapp.net (Baileys format)
  name            String?
  // Anchor for paginating BACKWARDS in time (available_history mode)
  oldestMsgKey    Json?    // serialized proto.IMessageKey
  oldestMsgTs     DateTime?
  // Anchor for last_n_days mode — start from newest and go backwards until cutoff
  newestMsgKey    Json?
  newestMsgTs     DateTime?
  lastSeen        DateTime @default(now())

  @@unique([connectionId, jid])
  @@index([connectionId])
  @@index([connectionId, newestMsgTs])
}

model DriverTelegram {
  id            String   @id @default(cuid())
  driverId      String   @unique
  telegramId    BigInt   @unique
  username      String?
  phoneVerified Boolean  @default(false)
  botState      String   @default("IDLE")
  carId         String?
  carLabel      String?
  createdAt     DateTime @default(now())
}

model BotChatMessage {
  id         String   @id @default(cuid())
  telegramId BigInt
  driverId   String?
  direction  String
  text       String
  createdAt  DateTime @default(now())
}

model Bot {
  id              String           @id @default(uuid())
  token           String           @unique
  name            String
  username        String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  analyticsEvents AnalyticsEvent[]
  broadcasts      Broadcast[]
  surveys         Survey[]
  users           User[]

  @@map("bots")
}

model Survey {
  id            String     @id @default(uuid())
  botId         String     @map("bot_id")
  title         String     @default("Новый опрос")
  triggerButton String     @default("📊 Опрос качества") @map("trigger_button")
  isActive      Boolean    @default(true) @map("is_active")
  isLinear      Boolean    @default(true) @map("is_linear")
  googleSheetId String?    @map("google_sheet_id")
  syncMode      String     @default("ON_COMPLETE") @map("sync_mode")
  createdAt     DateTime   @default(now()) @map("created_at")
  archivedAt    DateTime?  @map("archived_at")
  questions     Question[]
  bot           Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("surveys")
}

model Question {
  id           String   @id @default(uuid())
  surveyId     String   @map("survey_id")
  order        Int      @default(0)
  type         String
  text         String
  options      Json?
  isRequired   Boolean  @default(true) @map("is_required")
  isConversion Boolean  @default(false) @map("is_conversion")
  routingRules Json?    @map("routing_rules")
  answers      Answer[]
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model User {
  id                String           @id @default(uuid())
  botId             String           @map("bot_id")
  telegramId        BigInt           @map("telegram_id")
  username          String?
  firstName         String?          @map("first_name")
  currentQuestionId String?          @map("current_question_id")
  status            String           @default("ACTIVE")
  createdAt         DateTime         @default(now()) @map("created_at")
  analyticsEvents   AnalyticsEvent[]
  answers           Answer[]
  bot               Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, telegramId])
  @@map("users")
}

model Answer {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  value      String
  createdAt  DateTime @default(now()) @map("created_at")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model AnalyticsEvent {
  id        String             @id @default(uuid())
  botId     String             @map("bot_id")
  userId    String?            @map("user_id")
  eventType AnalyticsEventType @map("event_type")
  sourceId  String?            @map("source_id")
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  bot       Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id])

  @@index([botId, createdAt])
  @@index([botId, eventType, createdAt])
  @@map("analytics_events")
}

model Broadcast {
  id            String         @id @default(uuid())
  botId         String         @map("bot_id")
  text          String
  status        String         @default("PENDING")
  totalTargeted Int            @default(0) @map("total_targeted")
  createdAt     DateTime       @default(now()) @map("created_at")
  completedAt   DateTime?      @map("completed_at")
  stats         BroadcastStat?
  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("broadcasts")
}

model BroadcastStat {
  id           String    @id @default(uuid())
  broadcastId  String    @unique @map("broadcast_id")
  successCount Int       @default(0) @map("success_count")
  failedCount  Int       @default(0) @map("failed_count")
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@map("broadcast_stats")
}

model Driver {
  id                   String               @id @default(cuid())
  yandexDriverId       String               @unique
  fullName             String
  phone                String?
  licenseNumber        String?
  lastExternalPark     String?
  lastFleetCheckAt     DateTime?
  lastFleetCheckStatus String?
  lastFleetCheckId     String?
  segment              String               @default("unknown")
  segmentOverride      String?
  statusOverride       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  score                Float?
  dismissedAt          DateTime?
  hiredAt              DateTime?
  lastOrderAt          DateTime?
  customFields         Json?                @default("{}")
  primaryYandexId      String?              @unique
  calls                Call[]
  chats                Chat[]
  communicationEvents  CommunicationEvent[]
  contactProfile       Contact?
  attentions           DriverAttention[]
  daySummaries         DriverDaySummary[]
  events               DriverEvent[]
  maxProfile           DriverMax?
  managerTasks         ManagerTask[]
  tasks                Task[]
  actions              DriverAction[]

  @@index([fullName])
  @@index([segment])
  @@index([primaryYandexId])
}

/// Driver-initiated actions on their active Yandex order, executed via the
/// fleet.yandex.ru scraper. Created when the driver taps a button in the
/// Telegram bot ("Цена / Завершить / Отменить"). Used both as a queue handle
/// (scraperTaskId correlates with BullMQ) and as audit log.
model DriverAction {
  id            String              @id @default(cuid())
  driverId      String
  kind          DriverActionKind
  /// Yandex long order id (32-hex). Optional for GET_PRICE — at request time we
  /// may not know it yet; the scraper discovers it from the orders tab.
  orderId       String?
  /// Short human-readable order id (e.g. "3538965") for audit/UX. Populated
  /// when scraper successfully resolves the active order.
  shortOrderId  String?
  status        DriverActionStatus  @default(PENDING)
  /// Telegram numeric id of the driver who initiated this action.
  requestedBy   String
  /// BullMQ job id correlation with yandex-fleet-scraper.
  scraperTaskId String?
  /// Structured result from scraper. For GET_PRICE: { priceRub, fixedPriceRub,
  /// paymentMethod, fromAddress, toAddress, durationMin }. For COMPLETE/CANCEL:
  /// { ok, newStatus }.
  result        Json?
  errorMessage  String?
  requestedAt   DateTime            @default(now())
  completedAt   DateTime?

  driver        Driver              @relation(fields: [driverId], references: [id])

  @@index([driverId, kind, status])
  @@index([requestedAt(sort: Desc)])
  @@index([scraperTaskId])
}

enum DriverActionKind {
  GET_PRICE
  COMPLETE_ORDER
  CANCEL_ORDER
}

enum DriverActionStatus {
  PENDING
  DONE
  FAILED
  TIMEOUT
  /// Cancel flow stopped before confirming, because we haven't reverse-engineered
  /// the cancel-reason modal yet. Treated by the bot as "передал менеджеру".
  NEEDS_REASON_PROBE
  /// Action was deliberately not attempted (feature flag off, no active order,
  /// driver not linked to Yandex, etc.). Bot tells driver "передал менеджеру"
  /// and we surface this as a pending notification for the manager.
  ESCALATED_TO_MANAGER
}

model Chat {
  id                String            @id @default(cuid())
  driverId          String?
  channel           ChatChannel
  externalChatId    String            @unique
  name              String?
  lastMessageAt     DateTime?
  unreadCount       Int               @default(0)
  metadata          Json?             @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requiresResponse  Boolean           @default(false)
  status            String            @default("new")
  contactId         String?
  contactIdentityId String?
  assignedToUserId  String?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  chatType          String            @default("private")
  contact           Contact?          @relation(fields: [contactId], references: [id])
  contactIdentity   ContactIdentity?  @relation(fields: [contactIdentityId], references: [id])
  driver            Driver?           @relation(fields: [driverId], references: [id])
  GroupVisibility   GroupVisibility[]
  messages          Message[]

  @@index([driverId])
  @@index([contactId])
  @@index([contactIdentityId])
  @@index([lastMessageAt(sort: Desc)])
  @@index([status])
  @@index([assignedToUserId])
  @@index([status, assignedToUserId])
  @@index([chatType])
}

model Message {
  id              String              @id @default(cuid())
  chatId          String
  direction       MessageDirection
  type            MessageType         @default(text)
  content         String
  status          MessageStatus       @default(sent)
  externalId      String?             @unique
  metadata        Json?               @default("{}")
  sentAt          DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  channel         ChatChannel?        @default(whatsapp)
  aiStatus        AiStatus?
  clientMessageId String?             @unique
  chat            Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments     MessageAttachment[]
  eventLogs       MessageEventLog[]

  @@index([chatId, sentAt(sort: Desc)])
  @@index([externalId])
  @@index([aiStatus])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  type      String
  url       String
  fileName  String?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageEventLog {
  id        String   @id @default(cuid())
  messageId String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  status    String   @default("pending")
  updatedAt DateTime @updatedAt
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([status])
  @@index([status, eventType])
}

model DriverEvent {
  id        String   @id @default(cuid())
  driverId  String
  eventType String
  payload   Json?
  createdBy String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, createdAt])
  @@index([eventType])
}

model DriverAttention {
  id         String    @id @default(cuid())
  driverId   String
  reason     String
  riskLevel  String    @default("medium")
  status     String    @default("open")
  meta       Json?
  createdBy  String?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  driver     Driver    @relation(fields: [driverId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([driverId])
}

model DriverDaySummary {
  id                String   @id @default(cuid())
  driverId          String
  date              DateTime @db.Date
  tripCount         Int      @default(0)
  hadManagerMessage Boolean  @default(false)
  hadManagerCall    Boolean  @default(false)
  hadAutoMessage    Boolean  @default(false)
  hadPromotion      Boolean  @default(false)
  hadAiAction       Boolean  @default(false)
  hadGoalAchieved   Boolean  @default(false)
  driver            Driver   @relation(fields: [driverId], references: [id])

  @@unique([driverId, date])
  @@index([date])
  @@index([driverId, date])
}

model ScoringThreshold {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int
  updatedAt DateTime @updatedAt
}

model CommunicationEvent {
  id        String   @id @default(cuid())
  driverId  String
  channel   String
  direction String
  eventType String
  content   String?
  metadata  Json?
  createdBy String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, createdAt(sort: Desc)])
  @@index([eventType])
}

model CommunicationTrigger {
  id              String   @id @default(cuid())
  name            String
  condition       String
  threshold       Int
  action          String
  messageTemplate String?
  channel         String   @default("telegram")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model ManagerTask {
  id         String    @id @default(cuid())
  driverId   String
  type       String
  title      String
  priority   String    @default("medium")
  status     String    @default("open")
  triggerId  String?
  metadata   Json?
  createdBy  String?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  driver     Driver    @relation(fields: [driverId], references: [id])

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([driverId])
}

model DailyParkStats {
  id                 String   @id @default(cuid())
  date               DateTime @unique @db.Date
  activeDrivers      Int      @default(0)
  totalTrips         Int      @default(0)
  driversAtRisk      Int      @default(0)
  sleepingDrivers    Int      @default(0)
  promotionsActive   Int      @default(0)
  profitableCount    Int      @default(0)
  mediumCount        Int      @default(0)
  smallCount         Int      @default(0)
  reactivatedDrivers Int      @default(0)
  createdAt          DateTime @default(now())
}

/// Центральная сущность. Один Contact = один физический человек.
/// Связь с Driver (Яндекс) опциональна через yandexDriverId.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Contact {
  id                String            @id @default(cuid())
  displayName       String
  displayNameSource ContactNameSource @default(channel)
  masterSource      ContactSource     @default(chat)
  yandexDriverId    String?           @unique
  primaryPhoneId    String?
  notes             String?
  customFields      Json?             @default("{}")
  tags              String[]          @default([])
  isArchived        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  calls             Call[]
  chats             Chat[]
  driver            Driver?           @relation(fields: [yandexDriverId], references: [yandexDriverId])
  identities        ContactIdentity[]
  mergesAsMerged    ContactMerge[]    @relation("MergeMerged")
  mergesAsSurvivor  ContactMerge[]    @relation("MergeSurvivor")
  phones            ContactPhone[]
  tasks             Task[]

  @@index([displayName])
  @@index([isArchived])
}

/// Телефонный номер контакта. Хранится в E.164 (+79221234567).
///
/// isTemporary + expiresAt — для Авито-номеров. С 28.05.2026 Авито показывает
/// в чате временный номер вместо настоящего ("вскоре он изменится"). Парсер
/// avito-worker создаёт такой номер с isTemporary:true, expiresAt:+14дней;
/// когда worker раскроет настоящий — LeadIntake добавит новый номер и
/// деактивирует все временные у этого Contact. Если настоящий так и не
/// пришёл за 14 дней — background-job выставит isActive:false.
model ContactPhone {
  id          String             @id @default(cuid())
  contactId   String
  phone       String
  label       String?
  isPrimary   Boolean            @default(false)
  source      ContactPhoneSource @default(manual)
  isActive    Boolean            @default(true)
  verifiedAt  DateTime?
  isTemporary Boolean            @default(false)
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  identities  ContactIdentity[]
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, phone])
  @@index([phone])
  @@index([isTemporary, expiresAt])
}

/// Идентификатор контакта в канале (telegramId, WA JID, maxUserId и т.д.)
model ContactIdentity {
  id                    String                @id @default(cuid())
  contactId             String
  channel               ChatChannel
  externalId            String
  phoneId               String?
  displayName           String?
  source                ContactIdentitySource @default(auto)
  confidence            Float                 @default(1.0)
  isActive              Boolean               @default(true)
  metadata              Json?                 @default("{}")
  createdAt             DateTime              @default(now())
  reachabilityCheckedAt DateTime?
  reachabilityStatus    ReachabilityStatus    @default(unknown)
  chats                 Chat[]
  contact               Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phone                 ContactPhone?         @relation(fields: [phoneId], references: [id])

  @@unique([channel, externalId])
  @@index([contactId])
  @@index([phoneId])
}

/// Аудит-лог операций склейки/расклейки контактов.
model ContactMerge {
  id             String      @id @default(cuid())
  survivorId     String
  mergedId       String
  action         MergeAction @default(merge)
  mergedBy       String      @default("system")
  reason         MergeReason
  confidence     Float?
  snapshotBefore Json
  createdAt      DateTime    @default(now())
  driverYandexId String?
  merged         Contact     @relation("MergeMerged", fields: [mergedId], references: [id])
  survivor       Contact     @relation("MergeSurvivor", fields: [survivorId], references: [id])

  @@index([survivorId])
  @@index([mergedId])
}

model Task {
  id                    String       @id @default(cuid())
  driverId              String?
  source                TaskSource   @default(manual)
  type                  String
  title                 String
  description           String?
  status                TaskStatus   @default(todo)
  priority              TaskPriority @default(medium)
  isActive              Boolean      @default(true)
  triggerType           String?
  triggerKey            String?
  dedupeKey             String?
  dueAt                 DateTime?
  assigneeId            String?
  createdBy             String?
  resolvedBy            String?
  chatId                String?
  originMessageId       String?
  originExcerpt         String?
  originCreatedAt       DateTime?
  hasNewReply           Boolean      @default(false)
  lastInboundMessageAt  DateTime?
  lastOutboundMessageAt DateTime?
  metadata              Json?        @default("{}")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  resolvedAt            DateTime?
  contactId             String?
  scenario              String?
  stage                 String?
  stageEnteredAt        DateTime?
  nextActionAt          DateTime?
  slaDeadline           DateTime?
  closedReason          String?
  closedComment         String?
  scenarioData          Json?        @default("{}")
  events                TaskEvent[]
  contact               Contact?     @relation(fields: [contactId], references: [id])
  driver                Driver?      @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([contactId])
  @@index([status, priority, dueAt])
  @@index([isActive, source])
  @@index([chatId])
  @@index([assigneeId])
  @@index([scenario, stage, isActive])
  @@index([driverId, scenario, isActive])
  @@index([slaDeadline])
  @@index([nextActionAt])
  @@map("tasks")
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  eventType String
  payload   Json?    @default("{}")
  actorType String?  @default("system")
  actorId   String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("task_events")
}

model CrmUser {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("manager")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("crm_users")
}

/// SIP call session. Created by FreeSWITCH events via ESL.
/// managerId is the CRM user id (string "u1"/"u2"/... from src/data/users.json),
/// not a Prisma FK — CRM users live in JSON, not in the DB.
model Call {
  id            String        @id @default(cuid())
  direction     CallDirection
  status        CallStatus    @default(ringing)
  fromNumber    String        // E.164
  toNumber      String        // E.164

  driverId      String?
  contactId     String?
  managerId     String?       // CRM user id (u1, u2, ...) — not a FK

  // FreeSWITCH channel UUID — dedupes events for the same call
  fsUuid        String?       @unique
  sipCallId     String?       // SIP Call-ID header

  startedAt     DateTime      @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  durationSec   Int?
  hangupCause   String?       // FreeSWITCH cause: NORMAL_CLEARING, USER_BUSY, NO_ANSWER, ...

  // Filled in by later stages
  recordingUrl  String?       // public URL (MinIO/S3)
  recordingPath String?       // path inside FreeSWITCH recordings volume
  transcript    String?       // Whisper output
  aiScore       Int?          // 1-10 (weighted average of TelephonyAiConfig.criteria)
  aiSummary     String?
  aiAnalysis    Json?

  // Categorical outcome fields filled by AI analysis using
  // TelephonyAiConfig.outcomeOptions / sentimentOptions / nextActionOptions.
  // Values are the `key` of the chosen option (e.g. "scheduled_visit") so
  // option labels can be re-translated without rewriting historical rows.
  outcome         String?     // result of the call: "closed_won" / "scheduled_visit" / "no_interest" / ...
  clientSentiment String?     // "positive" / "neutral" / "negative" / ...
  nextActionType  String?     // type of follow-up: "call_back" / "office_visit" / "send_docs" / ...
  nextActionDue   DateTime?   // when follow-up is due; null if no follow-up agreed

  // AI-initiated outbound calls (voice agent talks to a lead via mod_audio_fork).
  // For ordinary click-to-call rows these are null/false.
  isAi             Boolean              @default(false)
  aiScenarioId     String?
  aiSessionStatus  AiCallSessionStatus?
  aiTransferReason String?
  aiScenario       AiCallScenario?      @relation(fields: [aiScenarioId], references: [id])
  aiMessages       AiCallMessage[]

  // Structured Outcome Layer (PR #57). Lifts qualification result out of
  // the opaque `aiAnalysis Json?` blob into typed, queryable columns.
  // Raw aiAnalysis is preserved untouched for forensics; business queries
  // (funnel reports, manager-queue sorting, A/B variants) hit these.
  //
  // aiOutcome           — deterministic enum from outcome-mapper.js. Six
  //                       values, covers every finalize path including
  //                       drops + bridge errors.
  // aiOutcomeReason     — machine-friendly snake_case slug, NOT a summary
  //                       (`aiSummary` is the human-readable one). Useful
  //                       for `WHERE aiOutcomeReason = 'llm_transferred_to_manager'`.
  //                       Appended with `;validation_issues=N` when LLM
  //                       lead_data didn't match the scenario's
  //                       outcomeSchema — operator runbook signal.
  // qualificationScore  — 0–100 lead-quality score returned by the LLM in
  //                       the end_call tool. Nullable: not all scenarios
  //                       wire a score (older scenarios, scenarios where
  //                       scoring doesn't make sense).
  // leadDataStructured  — canonical-keyed validated lead data per the
  //                       scenario's outcomeSchema. Extra keys dropped,
  //                       types coerced, issues logged in opsLog.
  aiOutcome           AiOutcome?
  aiOutcomeReason     String?
  qualificationScore  Int?
  leadDataStructured  Json?

  // Conversation Intelligence Layer (PR #59). Timeline of signal-bearing
  // events emitted by the bridge and the CRM finalize route. Cleared with
  // the Call (ON DELETE CASCADE). See docs/design/conversation-intelligence-layer.md.
  aiEvents      AiCallEvent[]

  metadata      Json?         @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  driver        Driver?       @relation(fields: [driverId], references: [id])
  contact       Contact?      @relation(fields: [contactId], references: [id])

  @@index([direction, startedAt(sort: Desc)])
  @@index([driverId])
  @@index([contactId])
  @@index([managerId, startedAt(sort: Desc)])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([isAi, startedAt(sort: Desc)])
  // Funnel analytics: «qualified leads last 7 days», «outcome distribution
  // per scenario». Bounded scan even at high call volume.
  @@index([aiOutcome, startedAt(sort: Desc)])
}

/// Per-utterance transcript of an AI-driven call: each row is one finalized
/// chunk of speech (user — STT output; assistant — LLM reply; tool — function call).
/// Used for live UI transcript and post-hoc review.
model AiCallMessage {
  id          String            @id @default(cuid())
  callId      String
  role        AiCallMessageRole
  content     String
  /// 0–1 from STT (user role only)
  confidence  Float?
  /// Function-call name when role=tool (e.g. transfer_to_manager)
  toolName    String?
  toolPayload Json?
  /// Object key in MinIO for the per-utterance audio clip, if stored.
  audioPath   String?
  startedAt   DateTime          @default(now())
  durationMs  Int?
  call        Call              @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, startedAt])
  @@index([role])
}

/// One configurable AI-call provider setting (API key, folder ID, mock-mode
/// toggle, …). Stored in DB so admins can configure keys via the settings
/// UI without redeploying. Secrets are AES-256-GCM encrypted at rest;
/// `mask` keeps the last 4 chars for UX. Non-secret values (mockMode,
/// yandexFolderId) go in plain `valuePlain` and `encryptedValue` is null.
///
/// (provider, key) is the natural primary key — there's at most one OpenAI
/// API key, one Yandex Folder ID, etc. Soft semantics via `isConfigured`:
/// rows are deleted when admin clicks "Удалить ключ"; `isConfigured`
/// caches the row's status for fast filtering.
model AiProviderSetting {
  id              String   @id @default(cuid())
  provider        String   /// 'openai' | 'yandex' | 'system'
  key             String   /// 'apiKey' | 'folderId' | 'mockMode'
  /// AES-256-GCM ciphertext for secret values (apiKey). null for plain values.
  encryptedValue  String?
  /// Plain-text storage for non-secrets (folderId — public; mockMode — boolean).
  valuePlain      String?
  /// Last 4 chars for "•••• ABCD" mask in the UI. Always safe to expose.
  mask            String?
  isConfigured    Boolean  @default(true)
  /// Last time someone clicked "Проверить подключение" for this key.
  lastCheckedAt   DateTime?
  /// 'ok' | 'invalid_key' | 'no_folder' | 'network' | 'http_error' | …
  lastCheckStatus String?
  /// Free-text diagnostic from the last check (shown next to the badge).
  lastCheckMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, key])
  @@index([provider])
}

/// Top-level grouping for AI-call scenarios. Lets the UI organise scripts
/// by business purpose (lead qualification, churn winback, NPS survey, …).
/// Seeded with 3 defaults — see prisma/seed/ai-call-projects.ts.
model AiCallProject {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  /// Soft-delete via isActive. Existing scenarios keep their projectId
  /// even if the project is deactivated — they just don't show in the picker.
  isActive    Boolean          @default(true)
  /// Display order in the settings UI grouping.
  sortOrder   Int              @default(100)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  scenarios   AiCallScenario[]
}

/// Reusable AI-call scenario: system prompt + ordered questions. Manager picks
/// one when initiating an AI call. Soft-deleted via isActive. Belongs to one
/// AiCallProject (nullable for backfill — pre-project scenarios will be
/// auto-assigned to the "Квалификация лида" default project on first read).
model AiCallScenario {
  id                String         @id @default(cuid())
  projectId         String?
  name              String
  description       String?
  systemPrompt      String
  /// Array of { text, intentKeywords?, branches? } — see AiCallScenarioQuestion type
  questions         Json           @default("[]")
  /// Soft target call length in seconds — informs LLM about pacing.
  targetDurationSec Int?
  /// Canonical-key schema for the lead_data the LLM collects via
  /// save_lead_data. Shape: { fields: [{ key, type, required, ...constraints }] }.
  /// Type is one of 'integer' | 'boolean' | 'string' | 'enum'. NULL means
  /// no schema — finalize mapper passes lead_data through verbatim
  /// (back-compat with pre-PR scenarios). See src/lib/ai-call/scenario-schema.js
  /// and src/lib/ai-call/types.ts for the validated shape.
  outcomeSchema     Json?
  /// Greeting A/B variants (PR #62). Array of { id, text, label? } — the
  /// bridge deterministically picks one via hash(callUuid) % N and speaks
  /// it directly via TTS (no LLM round-trip on greeting). Variant ID is
  /// persisted to the `greeting_started` event payload for funnel
  /// attribution. NULL / empty array → legacy LLM-generated greeting.
  greetingVariants  Json?
  /// Prompt fragments (PR #63). Record mapping slot → { id, version, text,
  /// hypothesis? } for composable system-prompt assembly. Required slots:
  /// greeting / qualification_intro / recovery / transfer_framing.
  /// Optional: objection_soft / closing. NULL or missing required slots →
  /// legacy monolithic prompt path. See tools/audio-bridge-day1/
  /// prompt-fragments.js for the composer + src/lib/ai-call/types.ts for
  /// the typed shape.
  fragments         Json?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           AiCallProject? @relation(fields: [projectId], references: [id])
  calls             Call[]

  @@index([projectId, isActive])
}

/// Единственная запись — настройки AI агента (upsert by id="singleton")
/// Стили общения AI-агента (Роль / Тон / Разрешено / Запрещено).
/// Один профиль активен в AiAgentConfig через activeProfileId.
/// Системный seed-профиль защищён от удаления через isDefault=true.
model AiAgentProfile {
  id              String   @id @default(cuid())
  name            String
  description     String?
  promptRole      String?
  promptTone      String?
  promptAllowed   String?
  promptForbidden String?
  /// Системный профиль, защищён от удаления (default seed).
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // обратная связь: один профиль может быть активен в config'е.
  configsAsActive AiAgentConfig[]
}

model AiAgentConfig {
  id                    String         @id @default("singleton")
  enabled               Boolean        @default(false)
  mode                  AiAgentMode    @default(off)
  provider              AiProviderType @default(anthropic)
  apiKeyEncrypted       String?
  classificationModel   String         @default("claude-haiku-4-5")
  responseModel         String         @default("claude-sonnet-4-5")
  language              String         @default("ru")
  confidenceThreshold   Float          @default(0.75)
  maxAutoRepliesPerChat Int            @default(5)
  activeChannels        String[]
  /// { alwaysEscalate: string[], neverAutoReply: string[] }
  escalationPolicy      Json?
  /// { enabled: bool, from: "09:00", to: "21:00", timezone: "Europe/Moscow" }
  workingHours          Json?
  /// [{ condition, model }]
  routingRules          Json?
  /// Промпт-поля legacy fallback. С момента введения профилей (см.
  /// AiAgentProfile) реальный промпт берётся из активного профиля
  /// через activeProfileId. Эти поля сохраняются для backward-compat:
  /// если activeProfileId = null, runtime используется их.
  promptRole            String?
  promptTone            String?
  promptAllowed         String?
  promptForbidden       String?
  /// Активный стиль AI-агента. FK на AiAgentProfile.id. При null —
  /// runtime fallback на promptRole/Tone/Allowed/Forbidden выше.
  activeProfileId       String?
  activeProfile         AiAgentProfile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  /// "ok" | "error" | "unchecked"
  connectionStatus      String?
  lastConnectionCheckAt DateTime?
  /// AI Knowledge Core (PR2): пресет модели для extraction-pipeline.
  /// 'economy' | 'balanced' | 'quality'. Маппится в Extractor на
  /// конкретную модель: economy → Haiku/4o-mini, balanced →
  /// classificationModel, quality → responseModel. Default 'balanced'
  /// — provider-agnostic, дёшево, JSON-mode достаточно.
  /// Extraction-model ≠ response-model: это разные контуры.
  extractionQualityTier String?         @default("balanced")
  /// Версия системного промпта экстрактора. Bump при содержательных
  /// изменениях — даёт regression analysis: сравнить ядро, собранное
  /// разными версиями prompt'а.
  extractionPromptVersion String?
  /// PR9.44 «AI стажёр»: фича генерации proposed reply в чатах.
  /// При true: когда менеджер фокусится в input bar открытого чата,
  /// AI генерирует черновик ответа на последний inbound message и
  /// показывает в timeline как ghost-bubble. Менеджер берёт в работу
  /// (редактирует/одобряет) или скрывает. По умолчанию on — фича
  /// под наблюдением, легко выключить из админки.
  internEnabled         Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

/// Настройки AI-анализа звонков (Stage 4). Singleton, id = "singleton".
/// Админ меняет модель и промт через /settings/integrations/telephony-ai.
/// Промт остаётся стабильным между звонками — OpenAI автоматически
/// кэширует префикс ≥1024 токенов на ~5 минут, экономия ~50% на input.
model TelephonyAiConfig {
  id           String   @id @default("singleton")
  enabled      Boolean  @default(true)
  model        String   @default("gpt-4o")
  systemPrompt String
  /// Rubric criteria — admin-editable list:
  /// [{ key, label, description, scaleMax, weight, isActive, order }]
  /// Empty/null means "use legacy hard-coded systemPrompt".
  criteria          Json @default("[]")
  /// Outcome options for AI to choose from:
  /// [{ key, label, isActive, order }]
  outcomeOptions    Json @default("[]")
  /// Sentiment options:
  /// [{ key, label, isActive, order }]
  sentimentOptions  Json @default("[]")
  /// Next-action types:
  /// [{ key, label, isActive, order }]
  nextActionOptions Json @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// FAQ / База знаний агента
/// FAQ / База знаний агента (legacy, плоская).
/// С PR1 AI Knowledge Core этот layer переводится в постепенный
/// deprecation: новый слой company memory живёт в AiKnowledge*.
/// Полная миграция legacy → core делается в PR5. Здесь оставлено для
/// backward-compat и нулевого риска прод regressions.
model KnowledgeBaseEntry {
  id              String    @id @default(cuid())
  title           String
  category        String    @default("general")
  sampleQuestions Json      @default("[]")
  answer          String
  tags            String[]
  channels        String[]
  active          Boolean   @default(true)
  priority        Int       @default(0)
  lastReviewedAt  DateTime?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, priority(sort: Desc)])
  @@index([category])
}

// =====================================================================
// AI Knowledge Core — extracted business memory + explainable retrieval.
//
// Channel-agnostic: AiKnowledgeSource.originType / AiKnowledgeUsageLog
// .runtimeContext позволяют тот же слой памяти переиспользовать в voice
// runtime (AI-обзвон) без миграции. В MVP используется только chat-сторона.
//
// В PR1 (foundation) — только schema + seed секций + read-only UI.
// Никаких write/edit/extraction — это PR2. Pipeline ответа не трогается.
//
// Red lines: memory/project_ai_knowledge_core.md.
// =====================================================================

/// Раздел "книги знаний". Slug стабильный (используется в URL и seed'е),
/// title редактируется админом. isActive скрывает целиком раздел в UI.
model AiKnowledgeSection {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  /// Lucide icon key (BookOpen, Wallet, FileText, ...). Опционально —
  /// если null, UI рендерит дефолтный.
  iconKey     String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       AiKnowledgeItem[]

  @@index([isActive, sortOrder])
}

/// Каноничный факт компании. Хранит ЧТО известно, а не КАК отвечать —
/// формулировка ответа определяется стилем (AiAgentProfile) на этапе
/// генерации. canonicalStatement намеренно отделено от title:
/// title — заголовок для UI, canonicalStatement — машинно-нейтральная
/// формулировка для подмешивания в prompt retriever'а.
model AiKnowledgeItem {
  id                   String                @id @default(cuid())
  sectionId            String
  title                String
  /// Каноничная формулировка факта компании. PII удалена, стиль нейтральный.
  /// НЕ answer-шаблон. Стиль ответа берётся из активного AiAgentProfile.
  canonicalStatement   String
  tags                 String[]
  /// Уверенность в знании. Рассчитывается экстрактором как weighted-
  /// aggregate по source.confidence. 0..1.
  confidence           Float                 @default(0.5)
  /// Raw count извлечений. Может расти от одного менеджера — тогда
  /// uniqueManagerCount остаётся = 1, что снижает доверие.
  sourceCount          Int                   @default(0)
  /// Сколько РАЗНЫХ менеджеров формулировали этот факт. Anti-bias:
  /// один менеджер копи-пастит шаблон 50 раз != стабильное знание компании.
  uniqueManagerCount   Int                   @default(0)
  status               AiKnowledgeStatus     @default(active)
  /// Быстрый toggle. Архивные items тоже isActive=false.
  isActive             Boolean               @default(true)
  /// Категория safety для retrieval policy. Sensitive (тарифы, деньги) —
  /// требует более высокого confidence. requires_human — никогда не
  /// отвечаем сами, всегда escalate.
  safetyLevel          AiKnowledgeSafety     @default(normal)
  /// Если новое правило заменило это. Отличаем от conflictGroupId:
  /// supersession = смена правила во времени; conflict = два item
  /// существуют одновременно с разными утверждениями.
  supersededByItemId   String?               @unique
  supersededByItem     AiKnowledgeItem?      @relation("supersession", fields: [supersededByItemId], references: [id])
  supersedes           AiKnowledgeItem?      @relation("supersession")
  /// Группировка конфликтующих items. retriever по policy не отвечает
  /// при наличии conflict — эскалирует менеджеру.
  conflictGroupId      String?
  /// Verified-флаг (governance PR2.5). Поднимается админом вручную.
  /// Manual items автоверифицированы при создании. Retrieval даёт
  /// verified items более высокий priority.
  isVerified           Boolean               @default(false)
  verifiedBy           String?
  verifiedAt           DateTime?
  /// Кто создал: 'extractor' | userId.
  createdBy            String?
  /// Timestamp последнего использования в retrieval — для UI sorting.
  lastUsedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  section              AiKnowledgeSection    @relation(fields: [sectionId], references: [id])
  sources              AiKnowledgeSource[]
  usages               AiKnowledgeUsageLog[]

  @@index([sectionId, status, isActive])
  @@index([conflictGroupId])
  @@index([status, updatedAt(sort: Desc)])
  @@index([isVerified])
}

/// Доказательство откуда извлечено знание. Excerpt всегда PII-masked
/// (имена/телефоны/ВУ заменены на токены) ДО сохранения.
///
/// originType polymorphic: chat_message / voice_transcript / manual_entry /
/// doc_section. В PR1+PR2 используется только chat_message; остальные
/// под будущее без миграции.
///
/// messageId/chatId — soft references (без FK), чтобы удаление сырого
/// сообщения не каскадировало в knowledge layer.
model AiKnowledgeSource {
  id            String                  @id @default(cuid())
  itemId        String
  originType    AiKnowledgeSourceOrigin @default(chat_message)
  messageId     String?
  chatId        String?
  channel       ChatChannel?
  managerUserId String?
  /// PR7: polymorphic FK на conversation-провайдер (WhatsAppConnection /
  /// TelegramConnection / MaxConnection). Discriminator — `channel`.
  /// Без relation чтобы сохранять explainability-history даже после
  /// удаления connection'а. NULL для legacy sources (до PR7) и для
  /// manual-entry (manual_entry origin).
  connectionId  String?
  /// PII-masked фрагмент исходного сообщения. НЕ полное сообщение —
  /// короткая выдержка.
  excerpt       String
  /// sha256(itemId + messageId + excerpt). Гарантирует идемпотентность
  /// при повторных запусках экстрактора.
  excerptHash   String
  confidence    Float
  /// Когда было отправлено исходное сообщение (Message.sentAt). Для
  /// recency-веса в retrieval ranking.
  occurredAt    DateTime?
  /// PR7: soft-disable флаг. При disableKnowledgeSource(connectionId)
  /// все matching sources переводятся в isActive=false. Не physical
  /// delete — explainability/audit-history сохраняется. Item с 0
  /// active sources auto-archived (кроме verified/manual).
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  item          AiKnowledgeItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, excerptHash])
  @@index([itemId])
  @@index([messageId])
  @@index([managerUserId])
  @@index([connectionId, isActive])
}

/// Лог использования знания в ответе AI. Source-of-truth для
/// explainability ("Почему AI так ответил?"). Channel-agnostic.
/// decisionLogId — soft reference на AiDecisionLog.
model AiKnowledgeUsageLog {
  id             String              @id @default(cuid())
  itemId         String
  runtimeContext AiKnowledgeRuntime  @default(chat_reply)
  decisionLogId  String?
  messageId      String?
  retrievalScore Float?
  rerankScore    Float?
  /// true если item реально попал в финальный prompt генератора.
  usedInReply    Boolean             @default(false)
  /// PR3: исход policy для этого item'а:
  /// 'used' | 'filtered_archived' | 'filtered_superseded' |
  /// 'filtered_draft' | 'filtered_low_confidence' | 'filtered_conflict' |
  /// 'filtered_requires_human' | 'filtered_safety' | 'filtered_escalation' |
  /// 'filtered_no_knowledge'. Null для legacy записей.
  policyDecision String?
  /// PR3: запись в shadow mode (НЕ дошло до клиента).
  shadowMode     Boolean             @default(false)
  /// PR3: причина эскалации (если policy скипнул item / весь retrieval).
  escalationReason String?
  usedAt         DateTime            @default(now())
  item           AiKnowledgeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, usedAt(sort: Desc)])
  @@index([decisionLogId])
  @@index([usedAt(sort: Desc)])
  @@index([shadowMode, usedAt(sort: Desc)])
}

/// PR3 retrieval policy — singleton настройки безопасности и порогов
/// для answer-time pipeline. Mirror env flags (AI_KNOWLEDGE_SHADOW_MODE /
/// AI_KNOWLEDGE_RUNTIME_ENABLED) сохраняется здесь для UI visibility,
/// но source-of-truth остаётся env — контролируется деплоем, не UI
/// (защита от случайного flip).
model AiRetrievalPolicy {
  id                        String   @id @default("singleton")
  /// Минимальная уверенность item'а для авто-ответа.
  minConfidenceForReply     Float    @default(0.7)
  /// Sensitive items (тарифы/проценты/деньги) — жёстче порог.
  sensitiveConfidenceMargin Float    @default(0.85)
  /// Минимальное число sources для авто-ответа. Verified items
  /// проходят даже с 1 (manual create или strong-signal extraction).
  minSourceCountForReply    Int      @default(1)
  /// Бонус к score за isVerified=true.
  verifiedScoreBoost        Float    @default(0.2)
  /// Scope filters.
  excludeArchived           Boolean  @default(true)
  excludeSuperseded         Boolean  @default(true)
  excludeDraft              Boolean  @default(true)
  /// Эскалировать при unresolved conflict.
  conflictEscalates         Boolean  @default(true)
  /// Под будущее.
  maxStaleDays              Int?
  /// LLM rerank можно отключить (deterministic-only) для smoke.
  rerankEnabled             Boolean  @default(true)
  rerankTopN                Int      @default(5)
  prefilterTopN             Int      @default(20)
  /// Mirror env flags для UI visibility. Runtime берёт из env.
  shadowMode                Boolean  @default(true)
  runtimeEnabled            Boolean  @default(false)
  /// Версия policy + retrieval-pipeline. Bump при содержательных
  /// изменениях retrieval-prompt'а или decision tree.
  policyVersion             String   @default("v1")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?
}

/// PR2.5 governance: lightweight audit trail для изменений Knowledge
/// Core админом. JSON-snapshots перед/после действия — не diff.
/// itemId — soft-link (nullable, без FK), чтобы будущий physical
/// delete item'а в перспективе не каскадировал в audit history.
/// В PR2.5 hard delete не разрешён, но архитектурно готовимся.
model AiKnowledgeAuditLog {
  id          String                 @id @default(cuid())
  itemId      String?
  /// userId совершившего действие. null если system.
  actor       String?
  action      AiKnowledgeAuditAction
  /// JSON-snapshot до действия. Для 'created'/'manual_created' — null.
  beforeJson  Json?
  /// JSON-snapshot после.
  afterJson   Json?
  /// Свободное место для контекста: { reason, supersededBy,
  /// fromConflictGroupId, ... } — UI рендерит по action типу.
  metadata    Json?
  createdAt   DateTime               @default(now())

  @@index([itemId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

/// Задание на извлечение знаний из истории. Создаётся кнопкой
/// "Собрать ядро знаний". scope JSON: { mode, dateFrom?, dateTo?,
/// channels?, sampleSize? }. progress JSON: { messagesScanned,
/// pairsBuilt, candidatesFound, itemsCreated, itemsMerged,
/// sourcesAdded, conflictsDetected, ... }.
model AiExtractionJob {
  id           String                  @id @default(cuid())
  status       AiExtractionStatus      @default(queued)
  sourceType   AiKnowledgeSourceOrigin @default(chat_message)
  scope        Json                    @default("{}")
  progress     Json?
  /// Snapshot модели и pipeline на момент запуска job — для
  /// explainability и regression analysis ("это ядро собрано моделью X
  /// промптом vN"). Пишется при старте Extractor.run, не редактируется.
  extractionProvider      String?
  extractionModel         String?
  extractionPromptVersion String?
  /// Какой пресет был выбран в UI: 'economy'/'balanced'/'quality'.
  /// Нужен отдельно от model — между запусками config мог сменить
  /// classificationModel, и tier позволяет "тот же тип запуска,
  /// но с новой моделью".
  extractionQualityTier   String?
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdBy    String?
  createdAt    DateTime                @default(now())

  @@index([status, createdAt(sort: Desc)])
}

/// Журнал решений AI агента
model AiDecisionLog {
  id                   String   @id @default(cuid())
  messageId            String?
  chatId               String?
  channel              String?
  detectedIntent       String?
  confidence           Float?
  /// "auto_reply" | "escalate" | "skip"
  decision             String?
  selectedModel        String?
  usedKnowledgeEntries Json?
  generatedReply       String?
  replySent            Boolean  @default(false)
  escalated            Boolean  @default(false)
  error                String?
  reviewedByOperator   Boolean  @default(false)
  /// "good" | "bad" | "fixed"
  operatorVerdict      String?
  /// PR3 retrieval metadata. Все nullable для backward-compat.
  /// 'legacy' | 'shadow' | 'runtime' — какой layer формировал ответ.
  retrievalMode        String?
  /// 'answer' | 'escalate' | 'no_knowledge' | 'fallback_kb'
  retrievalDecision    String?
  /// 'conflict' | 'requires_human' | 'low_confidence' | 'no_relevant' |
  /// 'only_drafts' | 'ambiguous' | 'safety_block'
  escalationReason     String?
  /// Snapshot версий promptVersion + policyVersion + retrieval-model.
  knowledgeRuntimeVersion String?
  /// Shadow trace summary: что бы retriever сделал. Для UI compare.
  shadowRetrievalSummary  Json?
  createdAt            DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([channel])
  @@index([detectedIntent])
  @@index([decision])
  @@index([retrievalMode, createdAt(sort: Desc)])
}

/// PR9.44 «AI стажёр»: черновик ответа, сгенерированный AI on-demand
/// при фокусе менеджера в input bar открытого чата. Не отправляется
/// автоматически — только для просмотра, редактирования и approve.
///
/// Один proposal на messageId (последний inbound). Если пришло новое
/// inbound — старый proposal становится stale (expiresAt либо
/// фильтр по messageId). TTL 15 минут.
///
/// Lifecycle:
///   1. ready    — текст сгенерирован, показан в timeline
///   2. takenAt  — менеджер нажал «Взять в работу» (копируется в input)
///   3. sentMessageId — реально отправленное сообщение (для track approved vs edited)
///   4. dismissedAt — менеджер скрыл предложение
model AiProposedReply {
  id            String   @id @default(cuid())
  /// Inbound message, на который генерируется ответ. UNIQUE — один
  /// proposal per message; повторный fetch вернёт cached.
  messageId     String   @unique
  chatId        String
  /// Текст черновика, который AI бы написал.
  text          String
  confidence    Float
  /// 'auto_reply' (есть ответ) | 'escalate' (передать менеджеру) | 'no_match' (не нашёл данных)
  decisionMode  String
  /// Короткое объяснение «почему AI так решил» (для UI tooltip).
  reasoning     String?
  /// [{itemId, title, excerpt}] — какие знания использовал retriever.
  sources       Json?
  generatedAt   DateTime @default(now())
  /// TTL — после этого момента proposal считается устаревшим.
  expiresAt     DateTime
  /// Когда менеджер нажал «Взять в работу» (текст скопирован в input).
  takenAt       DateTime?
  /// FK на Message который менеджер реально отправил (после edit).
  /// Если совпадает с originalText — approved as-is, если отличается — edited.
  sentMessageId String?
  /// Когда менеджер нажал «Скрыть».
  dismissedAt   DateTime?
  /// PR9.54: когда менеджер нажал «👍 Правильно». Триггерит
  /// auto-verify всех used knowledge items + audit log entries
  /// с metadata.source='chat_usage'. Items получают isVerified=true,
  /// статус active (если был draft). Это превращает каждый чат в
  /// естественный verification-механизм — Ядро подтверждается работой.
  confirmedCorrectAt DateTime?

  @@index([chatId, generatedAt(sort: Desc)])
  @@index([expiresAt])
}

