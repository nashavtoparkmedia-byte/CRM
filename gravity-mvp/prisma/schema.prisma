  transferring   // SIP REFER in flight — connecting to manager
  ended          // hangup, normal completion
  failed         // STT/LLM/TTS error or bridge dropped
}

/// Conversation Intelligence Layer (PR #59). One row per signal-bearing
/// moment in an AI-call: greeting started, first real user speech, silence
/// strike, call completed. Append-only. Best-effort emission — losing a
/// row never breaks the call (write helper swallows insert errors). Read
/// access is via raw SQL / Prisma; no UI yet (next PR).
///
/// Volume budget: ~3-6 rows per AI-call in v1. Future PRs add events
/// (save_lead_data_emitted, manager_requested, stt_suspicious_pattern,
/// etc.) via ALTER TYPE on the enum below.
///
/// See docs/design/conversation-intelligence-layer.md for the full
/// taxonomy + per-event payload schemas.
model AiCallEvent {
  id          String          @id @default(cuid())
  callId      String

  /// Discriminated event type. v1 ships 4 values; future PRs extend.
  type        AiCallEventType

  /// Wall-clock timestamp of emission. Used for cross-event delta queries
  /// (time-to-first-speech, silence interval, etc.).
  occurredAt  DateTime        @default(now())

  /// Monotonic per-call ordinal. Resolves same-millisecond ties (the bridge
  /// can fire two events within one event-loop tick when tool dispatch
  /// chains). Assigned by the bridge at emission time.
  seq         Int

  /// Type-specific payload. Schemas documented per type in the design doc;
  /// validated by `src/lib/ai-call/event-emitter.js` at write time.
  payload     Json?

  call        Call            @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// Primary access pattern: timeline reconstruction for one call.
  @@index([callId, seq])
  /// Secondary access pattern: aggregations across calls by event type.
  @@index([type, occurredAt(sort: Desc)])
}

/// Conversation Intelligence Layer events. Adding more is one
/// ALTER TYPE per addition (Postgres doesn't allow batch enum additions
/// in a single transaction with other DDL — separate migration files
/// going forward).
///
/// Shipped:
///   v1 (PR #59):  greeting_started / first_real_user_speech /
///                 silence_strike / call_completed
///   v2 (PR #60):  + stt_suspicious_pattern — emitted when an STT final
///                 matches a known garbage pattern; payload carries
///                 pattern_name + matched_text + action.
enum AiCallEventType {
  greeting_started
  first_real_user_speech
  silence_strike
  call_completed
  stt_suspicious_pattern
  recovery_attempted
}

/// Structured business-outcome of an AI-call (PR #57). Set by the
/// outcome-mapper deterministic decision tree at finalize time. Used
/// for queryable analytics that don't require JSON parsing.
///
/// qualified          — LLM end_call(qualification_status=qualified)
/// not_qualified      — LLM end_call(qualification_status=not_qualified)
/// unclear_engaged    — lead engaged, qualification unclear (or LLM
///                      requested human transfer; manager task created
///                      separately in finalize route)
/// dropped_mid_call   — lead spoke at least once then hung up before
///                      LLM could end the call (no qualification verdict)
/// dropped_no_input   — lead never gave real speech; either pre-greeting
///                      hangup or the silence-timeout path fired
/// error              — bridge / STT / LLM technical failure
enum AiOutcome {
  qualified
  not_qualified
  unclear_engaged
  dropped_mid_call
  dropped_no_input
  error
}

