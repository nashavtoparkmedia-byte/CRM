enum CallDirection {
  inbound
  outbound
}

enum CallStatus {
  ringing       // call placed, not answered yet
  active        // bridged, conversation in progress
  completed     // ended normally after a conversation
  missed        // inbound, never answered
  no_answer     // outbound, callee didn't pick up
  busy
  failed        // technical failure (no route, codec mismatch, etc.)
