{
  "schema": "yoko.live-acceptance.recipient-guard-vectors.v1",
  "note": "Shared conformance vectors for every reader of yoko.live-acceptance.recipient-allowlist.v1 (gravity-mvp, tg-bot, max-web-scraper). 'allowlist' is the file content (an object is JSON-encoded; a string is written as is; null means the file does not exist). 'counters' are slot files already present in the counter directory. '__SHA256(x)__' stands for the hex sha256 of x. A send/lookup/assert step expects 'allow' or the refusal code; a peer step expects 'allow' or 'refuse'. 'startup_log', when given, is the exact list of lines logged at construction.",
  "cases": [
    {
      "name": "off: marker unset allows every send and peer, logs nothing",
      "env": {},
      "allowlist": null,
      "steps": [
        {
          "op": "send",
          "lane": "whatsapp",
          "id": "anyone@c.us",
          "at": "2026-11-12T09:00:00.000Z",
          "expect": "allow"
        },
        {
          "op": "peer",
          "lane": "max",
          "id": "1",
          "at": "2026-11-12T09:00:00.000Z",
          "expect": "allow"
        },
        {
          "op": "status",
          "at": "2026-11-12T09:00:00.000Z",
          "expect": {
            "mode": "off"
          }
        }
      ],
      "startup_log": []
    },
    {
      "name": "off: empty marker is off",
      "env": {
        "YOKO_LIVE_ACCEPTANCE": ""
      },
      "allowlist": null,
      "steps": [
        {
          "op": "send",
          "lane": "telegram_bot",
          "id": "1",
          "at": "2026-11-12T09:00:00.000Z",
          "expect": "allow"
        }
      ],
      "startup_log": []
    },
